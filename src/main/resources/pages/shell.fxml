<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitMenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.EditorHost?>
<?import org.fxt.freexmltoolkit.controls.unified.UnifiedSearchBar?>

<!--
  Unified Shell chrome (Scene-Builder-editable). Loaded by UnifiedShellView via the fx:root
  pattern (loader.setRoot(this)/setController(this)). Custom controls that need constructor
  arguments (ActivityBar, InspectorPanel, ProblemsPanel, QueryConsole, the activity panels)
  are NOT created here — UnifiedShellView.initialize() builds them and injects them into the
  fx:id placeholders (activityBarHost, sidePanelHost, inspectorWrapper, editorCenter,
  viewSwitchHost). EditorHost and UnifiedSearchBar have no-arg constructors, so they are real
  FXML tags below. Note: Scene Builder (JDK ~21) cannot render the custom controls of this
  Java-25/preview project — they appear as non-rendering placeholders, which is expected.
-->
<fx:root type="javafx.scene.layout.BorderPane" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1" styleClass="fxt-shell"
         stylesheets="@../css/design-tokens.css, @../css/app-theme.css, @../css/fxt-theme.css, @../css/unified-shell.css">

    <!-- Menu bar across the window (controller injects the code-built ShellMenuBar; on macOS it
         moves into the system menu bar and this host stays empty). -->
    <top>
        <StackPane fx:id="menuBarHost"/>
    </top>

    <!-- Full-height activity rail (controller injects the code-built ActivityBar). -->
    <left>
        <!-- Scrolls (mouse wheel, no bar: the rail stays narrow) only in a window shorter than
             the rail; its height would otherwise push the work area out of the window -->
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                    styleClass="fxt-side-panel-scroll" minHeight="0">
            <content>
                <StackPane fx:id="activityBarHost"/>
            </content>
        </ScrollPane>
    </left>

    <center>
        <BorderPane fx:id="mainArea">
            <top>
                <VBox styleClass="fxt-top-region">
                    <children>

                        <!-- Header: breadcrumb · centered search pill · notifications/help/theme -->
                        <HBox styleClass="fxt-header-bar">
                            <children>
                                <Label fx:id="breadcrumb" text="%shell.breadcrumb.text" styleClass="fxt-header-breadcrumb"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox fx:id="searchPill" alignment="CENTER_LEFT" spacing="8" maxWidth="460"
                                      prefWidth="460" styleClass="fxt-header-search" onMouseClicked="#onSearchPillClicked">
                                    <children>
                                        <IconifyIcon iconLiteral="bi-search" iconSize="13"/>
                                        <Label text="%shell.run-xpath-xquery.text" styleClass="fxt-header-search-hint"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="%shell.ctrl-k.text" styleClass="fxt-header-kbd"/>
                                    </children>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <!-- Favorites quick access (every activity, also on Settings / tool pages);
                                     the items are rebuilt in code each time it opens (FavoritesMenu) -->
                                <MenuButton fx:id="favoritesButton" id="header-favorites"
                                            styleClass="fxt-header-icon, fxt-fav-quick-access" focusTraversable="false">
                                    <graphic><IconifyIcon iconLiteral="bi-star" iconSize="16"/></graphic>
                                    <tooltip><Tooltip text="%shell.favorites.text"/></tooltip>
                                </MenuButton>
                                <Button fx:id="helpButton" id="header-help" styleClass="fxt-header-icon" focusTraversable="false" onAction="#onHelp">
                                    <graphic><IconifyIcon iconLiteral="bi-question-circle" iconSize="16"/></graphic>
                                    <tooltip><Tooltip text="%shell.help-f1.text"/></tooltip>
                                </Button>
                                <Button fx:id="themeToggleButton" styleClass="fxt-header-icon"
                                        focusTraversable="false" onAction="#onToggleTheme">
                                    <graphic><IconifyIcon fx:id="themeToggleIcon" iconLiteral="bi-moon" iconSize="16"/></graphic>
                                    <tooltip><Tooltip text="%shell.toggle-light-dark-theme.text"/></tooltip>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Editor toolbar: left panel toggle | action flow | view switch | inspector toggle -->
                        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="fxt-editor-toolbar">
                            <children>
                                <ToggleButton fx:id="leftPanelToggle" id="toggle-left-panel" focusTraversable="false"
                                              styleClass="fxt-tool-button, fxt-tool-neutral, fxt-panel-toggle"
                                              onAction="#onToggleLeftPanel">
                                    <graphic><IconifyIcon iconLiteral="bi-layout-sidebar"/></graphic>
                                    <tooltip><Tooltip text="%shell.show-hide-the-side-panel.text"/></tooltip>
                                </ToggleButton>

                                <FlowPane fx:id="toolbarActions" hgap="2" vgap="2" rowValignment="CENTER"
                                          minWidth="0" styleClass="fxt-editor-actionbar" HBox.hgrow="ALWAYS">
                                    <children>
                                        <!-- Variant E (Figma page 04): one slim row. Frequent actions are labeled
                                             buttons; related actions fold into SplitMenuButtons (primary click +
                                             visible ▾ menu); secondary tools are icon-only with tooltips. Buttons
                                             with text="" stay icon-only regardless of the show-labels setting.
                                             Insert Template, Compare and Spreadsheet Converter live in the menu bar
                                             (Edit / Tools) only (UX plan 5.4). Without a document only New and Open
                                             are shown; UnifiedShellView hides the rest (UX plan 5.3).
                                             Icon tints follow the owning workflow (spec 2026-09-26 §2): file group =
                                             workspace blue, New = CREATE, editing tools neutral, Transform/Run =
                                             transform, Schema = schema, Validate filled in validation green. -->
                                        <Button id="action-new" text="%shell.action-new.text"
                                                styleClass="fxt-tool-button, fxt-tool-create" onAction="#onNew">
                                            <graphic><IconifyIcon iconLiteral="bi-file-earmark-plus" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.new-ctrl-n.text"/></tooltip>
                                        </Button>
                                        <Button id="action-open" text="%shell.action-open.text"
                                                styleClass="fxt-tool-button, fxt-tool-primary" onAction="#onOpen">
                                            <graphic><IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.open-ctrl-o.text"/></tooltip>
                                        </Button>
                                        <SplitMenuButton id="action-save" text="%shell.action-save.text"
                                                         styleClass="fxt-tool-button, fxt-tool-primary, fxt-tool-split"
                                                         onAction="#onSave">
                                            <graphic><IconifyIcon iconLiteral="bi-save" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.save-ctrl-s-arrow-save.text"/></tooltip>
                                            <items>
                                                <MenuItem id="action-save-as" text="%shell.action-save-as.text" onAction="#onSaveAs">
                                                    <graphic><IconifyIcon iconLiteral="bi-save2" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem id="action-save-all" text="%shell.action-save-all.text" onAction="#onSaveAll">
                                                    <graphic><IconifyIcon iconLiteral="bi-files" iconSize="16"/></graphic>
                                                </MenuItem>
                                            </items>
                                        </SplitMenuButton>
                                        <Separator orientation="VERTICAL"/>
                                        <Button id="action-undo" text=""
                                                styleClass="fxt-tool-button, fxt-tool-neutral" onAction="#onUndo">
                                            <graphic><IconifyIcon iconLiteral="bi-arrow-counterclockwise" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.undo-ctrl-z.text"/></tooltip>
                                        </Button>
                                        <Button id="action-redo" text=""
                                                styleClass="fxt-tool-button, fxt-tool-neutral" onAction="#onRedo">
                                            <graphic><IconifyIcon iconLiteral="bi-arrow-clockwise" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.redo-ctrl-y.text"/></tooltip>
                                        </Button>
                                        <Separator orientation="VERTICAL"/>
                                        <SplitMenuButton id="action-format" text="%shell.action-format.text"
                                                         styleClass="fxt-tool-button, fxt-tool-neutral, fxt-tool-split"
                                                         onAction="#onFormat">
                                            <graphic><IconifyIcon iconLiteral="bi-text-indent-left" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.format-shift-alt-f-arrow.text"/></tooltip>
                                            <items>
                                                <MenuItem id="action-minify" text="%shell.action-minify.text" onAction="#onMinify">
                                                    <graphic><IconifyIcon iconLiteral="bi-arrows-collapse" iconSize="16"/></graphic>
                                                </MenuItem>
                                            </items>
                                        </SplitMenuButton>
                                        <Button id="action-query-console" text=""
                                                styleClass="fxt-tool-button, fxt-tool-neutral" onAction="#onQueryConsole">
                                            <graphic><IconifyIcon iconLiteral="bi-terminal" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.query-console-xpath-xquery-ctrl.text"/></tooltip>
                                        </Button>
                                        <Separator orientation="VERTICAL"/>
                                        <SplitMenuButton fx:id="actionTransform" id="doc-action-transform" text="%shell.actionTransform.text"
                                                         styleClass="fxt-tool-button, fxt-tool-transform, fxt-tool-split"
                                                         onAction="#onTransform">
                                            <graphic><IconifyIcon iconLiteral="bi-arrow-left-right" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.transform-with-xslt-choose-a.text"/></tooltip>
                                            <items>
                                                <MenuItem id="doc-action-transform-item" text="%shell.doc-action-transform-item.text" onAction="#onTransform">
                                                    <graphic><IconifyIcon iconLiteral="bi-arrow-left-right" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem id="doc-action-debug-xslt" text="%shell.doc-action-debug-xslt.text" onAction="#onDebugXslt">
                                                    <graphic><IconifyIcon iconLiteral="bi-bug" iconSize="16"/></graphic>
                                                </MenuItem>
                                            </items>
                                        </SplitMenuButton>
                                        <MenuButton fx:id="queryTargetButton" id="doc-query-target" text="%shell.queryTargetButton.text"
                                                    styleClass="fxt-tool-button, fxt-tool-neutral">
                                            <graphic><IconifyIcon iconLiteral="bi-bullseye" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.choose-the-xml-document-the.text"/></tooltip>
                                        </MenuButton>
                                        <SplitMenuButton fx:id="actionRun" id="doc-action-run" text="%shell.actionRun.text"
                                                         styleClass="fxt-tool-button, fxt-tool-transform, fxt-tool-split"
                                                         onAction="#onRunPrimary">
                                            <graphic><IconifyIcon iconLiteral="bi-play-fill" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.run-the-active-document-against.text"/></tooltip>
                                            <items>
                                                <MenuItem fx:id="actionRunQuery" id="doc-action-run-query"
                                                          text="%shell.actionRunQuery.text" onAction="#onRunQuery">
                                                    <graphic><IconifyIcon iconLiteral="bi-play-fill" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionRunTransform" id="doc-action-run-transform"
                                                          text="%shell.actionRunTransform.text" onAction="#onRunTransform">
                                                    <graphic><IconifyIcon iconLiteral="bi-play-circle" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionDebugTransform" id="doc-action-debug-transform"
                                                          text="%shell.actionDebugTransform.text" onAction="#onDebugTransform">
                                                    <graphic><IconifyIcon iconLiteral="bi-bug" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionDebugQuery" id="doc-action-debug-query"
                                                          text="%shell.actionDebugQuery.text" onAction="#onDebugQuery">
                                                    <graphic><IconifyIcon iconLiteral="bi-bug" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionProfileQuery" id="doc-action-profile-query"
                                                          text="%shell.actionProfileQuery.text" onAction="#onProfileQuery">
                                                    <graphic><IconifyIcon iconLiteral="bi-speedometer2" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionDebugSchematron" id="doc-action-debug-schematron"
                                                          text="%shell.actionDebugSchematron.text" onAction="#onDebugSchematron">
                                                    <graphic><IconifyIcon iconLiteral="bi-bug" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionCheckCompatibility" id="doc-action-check-compatibility"
                                                          text="%shell.actionCheckCompatibility.text" onAction="#onCheckCompatibility">
                                                    <graphic><IconifyIcon iconLiteral="bi-patch-check" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionRunPipeline" id="doc-action-run-pipeline"
                                                          text="%shell.actionRunPipeline.text" onAction="#onRunPipeline">
                                                    <graphic><IconifyIcon iconLiteral="bi-play-btn" iconSize="16"/></graphic>
                                                </MenuItem>
                                            </items>
                                        </SplitMenuButton>
                                        <SplitMenuButton id="action-set-schema" text="%shell.action-set-schema.text"
                                                         styleClass="fxt-tool-button, fxt-tool-schema, fxt-tool-split"
                                                         onAction="#onSetSchema">
                                            <graphic><IconifyIcon iconLiteral="bi-diagram-3" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.set-xsd-schema-intellisense-validation.text"/></tooltip>
                                            <items>
                                                <MenuItem id="action-set-schema-item" text="%shell.action-set-schema-item.text" onAction="#onSetSchema">
                                                    <graphic><IconifyIcon iconLiteral="bi-diagram-3" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionGenerateDocs" id="doc-action-generate-docs"
                                                          text="%shell.actionGenerateDocs.text" onAction="#onGenerateDocs">
                                                    <graphic><IconifyIcon iconLiteral="bi-file-earmark-text" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionTypeEditor" id="doc-action-type-editor"
                                                          text="%shell.actionTypeEditor.text" onAction="#onTypeEditor">
                                                    <graphic><IconifyIcon iconLiteral="bi-braces-asterisk" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem fx:id="actionGenerateSample" id="doc-action-generate-sample"
                                                          text="%shell.actionGenerateSample.text" onAction="#onGenerateSample">
                                                    <graphic><IconifyIcon iconLiteral="bi-file-earmark-play" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <SeparatorMenuItem/>
                                                <MenuItem fx:id="actionGenerateXsd" id="doc-action-generate-xsd"
                                                          text="%shell.actionGenerateXsd.text" onAction="#onGenerateXsdFromXml">
                                                    <graphic><IconifyIcon iconLiteral="bi-magic" iconSize="16"/></graphic>
                                                </MenuItem>
                                                <MenuItem id="doc-action-generate-xsd-batch"
                                                          text="%shell.doc-action-generate-xsd-batch.text" onAction="#onGenerateXsdBatch">
                                                    <graphic><IconifyIcon iconLiteral="bi-files" iconSize="16"/></graphic>
                                                </MenuItem>
                                            </items>
                                        </SplitMenuButton>
                                        <Separator orientation="VERTICAL"/>
                                        <Button fx:id="actionValidate" id="doc-action-validate" text="%shell.actionValidate.text"
                                                styleClass="fxt-tool-button, fxt-tool-primary, fxt-tool-accent"
                                                onAction="#onValidate">
                                            <graphic><IconifyIcon iconLiteral="bi-check2-circle" iconSize="16"/></graphic>
                                            <tooltip><Tooltip text="%shell.validate-the-document-well-formedness.text"/></tooltip>
                                        </Button>
                                    </children>
                                </FlowPane>

                                <!-- View-mode switch (Text/Tree/Graphic) — injected from EditorHost.getViewSwitch(). -->
                                <StackPane fx:id="viewSwitchHost"/>

                                <ToggleButton fx:id="inspectorToggle" id="toggle-inspector" focusTraversable="false"
                                              styleClass="fxt-tool-button, fxt-tool-neutral, fxt-panel-toggle"
                                              onAction="#onToggleInspector">
                                    <graphic><IconifyIcon iconLiteral="bi-layout-sidebar-reverse"/></graphic>
                                    <tooltip><Tooltip text="%shell.show-hide-the-properties-panel.text"/></tooltip>
                                </ToggleButton>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <center>
                <SplitPane fx:id="workSplit" orientation="VERTICAL" styleClass="fxt-work-split">
                    <items>
                        <SplitPane fx:id="workArea" orientation="HORIZONTAL" styleClass="fxt-work-area"
                                   SplitPane.resizableWithParent="true">
                            <items>
                                <!-- Left side panel (content set by showSidePanelFor; collapsed via the toolbar toggle).
                                     Width is user-draggable via the SplitPane divider (persisted by
                                     UnifiedShellView); resizableWithParent=false keeps it pixel-stable
                                     on window resize — the editor column absorbs the delta. -->
                                <StackPane fx:id="leftPanelWrapper" minWidth="200"
                                           SplitPane.resizableWithParent="false">
                                    <children>
                                        <!-- Scrolls only when the window is shorter than the panel: its height
                                             would otherwise push the editor column (and PROBLEMS) out of the window -->
                                        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                                                    styleClass="fxt-side-panel-scroll" minHeight="0">
                                            <content>
                                                <StackPane fx:id="sidePanelHost" styleClass="fxt-side-panel"/>
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </StackPane>

                                <!-- Editor column: find bar, editor host, (Problems panel appended in code). -->
                                <VBox fx:id="editorCenter" styleClass="fxt-editor-area, fxt-editor-center" minWidth="320">
                                    <children>
                                        <UnifiedSearchBar fx:id="searchBar"/>
                                        <EditorHost fx:id="editorHost" VBox.vgrow="ALWAYS" minHeight="100"/>
                                    </children>
                                </VBox>

                                <!-- Inspector wrapper: InspectorPanel inserted in code; collapsed via the toolbar toggle. -->
                                <StackPane fx:id="inspectorWrapper" minWidth="200"
                                           SplitPane.resizableWithParent="false">
                                    <children>
                                    </children>
                                </StackPane>
                            </items>
                        </SplitPane>
                    </items>
                </SplitPane>
            </center>
        </BorderPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="fxt-status-bar">
            <children>
                <Label fx:id="statusPosition" text="%shell.statusPosition.text" styleClass="fxt-status-item"/>
                <Label fx:id="statusChars" styleClass="fxt-status-item"/>
                <Label fx:id="statusType" styleClass="fxt-status-item"/>
                <Label fx:id="statusSchema" id="status-schema" text="%shell.statusSchema.text" styleClass="fxt-status-item"/>
                <Label fx:id="statusEncoding" id="status-encoding" text="%shell.statusEncoding.text" styleClass="fxt-status-item"/>
                <!-- Plugin marks of the active document ("FundsXML"), filled by UnifiedShellView.updateDocumentBadges -->
                <HBox fx:id="statusBadges" id="status-document-badges" alignment="CENTER_LEFT" spacing="6"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLastRun" styleClass="fxt-status-item"/>
                <Label fx:id="statusMemory" styleClass="fxt-status-item"/>
                <Label fx:id="statusFile" text="%shell.statusFile.text" styleClass="fxt-status-item"/>
            </children>
        </HBox>
    </bottom>
</fx:root>
