<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Large File Viewer: a read-only view of a file of any size, read from disk on demand (LargeFileIndex).
  Loaded by LargeFileView (fx:root), which puts the virtual row list into rowsSlot.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-large-file-view"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="xsd-toolbar">
            <padding>
                <Insets top="4" right="8" bottom="4" left="8"/>
            </padding>
            <children>
                <IconifyIcon iconLiteral="bi-eye" iconSize="18"/>
                <Label fx:id="info" id="large-file-info"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="%LargeFileView.line.text"/>
                <TextField fx:id="lineField" id="large-file-line" prefColumnCount="8" promptText="%LargeFileView.lineField.promptText"
                           onAction="#onGoToLine"/>
                <TextField fx:id="findField" id="large-file-find" prefColumnCount="22" promptText="%LargeFileView.findField.promptText"
                           onAction="#onFind"/>
                <CheckBox fx:id="regexCheck" id="large-file-regex" text="%LargeFileView.regexCheck.text"/>
                <CheckBox fx:id="caseCheck" id="large-file-case" text="%LargeFileView.caseCheck.text"/>
                <Button fx:id="findButton" text="%LargeFileView.findButton.text" id="large-file-find-button" onAction="#onFind">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-search" iconSize="16"/>
                    </graphic>
                </Button>
                <MenuButton fx:id="validateButton" text="%LargeFileView.validateButton.text" id="large-file-validate">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-check2-circle" iconSize="16"/>
                    </graphic>
                    <items>
                        <MenuItem fx:id="validateDeclared" text="%LargeFileView.validateDeclared.text" id="large-file-validate-declared"
                                  onAction="#onValidateDeclared">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-link-45deg" iconSize="16"/>
                            </graphic>
                        </MenuItem>
                        <MenuItem text="%LargeFileView.large-file-validate-schema.text" id="large-file-validate-schema" onAction="#onValidateSchema">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-file-earmark-code" iconSize="16"/>
                            </graphic>
                        </MenuItem>
                        <MenuItem text="%LargeFileView.large-file-validate-wellformed.text" id="large-file-validate-wellformed" onAction="#onValidateWellFormed">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-braces" iconSize="16"/>
                            </graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </children>
        </HBox>
        <HBox fx:id="progressBox" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
            <padding>
                <Insets top="4" right="8" bottom="4" left="8"/>
            </padding>
            <children>
                <Label fx:id="progressLabel" id="large-file-progress-label"/>
                <ProgressBar fx:id="progressBar" prefWidth="260"/>
                <Button text="%LargeFileView.large-file-cancel.text" id="large-file-cancel" onAction="#onCancel"/>
            </children>
        </HBox>
        <TabPane fx:id="views" id="large-file-views" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab fx:id="textTab" text="%LargeFileView.textTab.text" id="large-file-tab-text">
                    <content>
                        <SplitPane fx:id="split" orientation="VERTICAL">
                            <items>
                                <StackPane fx:id="rowsSlot" id="large-file-rows"/>
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
                <Tab fx:id="problemsTab" text="%LargeFileView.problemsTab.text" id="large-file-tab-problems" disable="true">
                    <content>
                        <VBox spacing="4">
                            <children>
                                <Label fx:id="problemsLabel" id="large-file-problems-label" styleClass="diff-xml-summary"/>
                                <TableView fx:id="problems" id="large-file-problems" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="severityColumn" text="%LargeFileView.severityColumn.text" prefWidth="80"/>
                                        <TableColumn fx:id="problemLineColumn" text="%LargeFileView.problemLineColumn.text" prefWidth="90"/>
                                        <TableColumn fx:id="problemColumnColumn" text="%LargeFileView.problemColumnColumn.text" prefWidth="70"/>
                                        <TableColumn fx:id="messageColumn" text="%LargeFileView.messageColumn.text" prefWidth="700"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="%LargeFileView.no-problems.text"/>
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab fx:id="structureTab" text="%LargeFileView.structureTab.text" id="large-file-tab-structure">
                    <content>
                        <SplitPane dividerPositions="0.35">
                            <items>
                                <TreeView fx:id="tree" id="large-file-tree"/>
                                <VBox spacing="4">
                                    <children>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <padding>
                                                <Insets top="4" right="8" bottom="2" left="8"/>
                                            </padding>
                                            <children>
                                                <Label fx:id="recordsLabel" id="large-file-records-label"
                                                       text="%LargeFileView.recordsLabel.text"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button fx:id="loadMoreButton" text="%LargeFileView.loadMoreButton.text" id="large-file-load-more"
                                                        onAction="#onLoadMore" disable="true">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-chevron-double-down" iconSize="16"/>
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </HBox>
                                        <TableView fx:id="records" id="large-file-records" VBox.vgrow="ALWAYS">
                                            <placeholder>
                                                <Label text="%LargeFileView.no-child-elements.text"/>
                                            </placeholder>
                                        </TableView>
                                    </children>
                                </VBox>
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        <ListView fx:id="results" id="large-file-results" visible="false" managed="false"/>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="diff-xml-summary">
            <children>
                <Label fx:id="status" id="large-file-status"/>
            </children>
        </HBox>
    </children>
</fx:root>
