<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Results of an XSpec run (Tools → Run XSpec Tests, XSpecRunner). Loaded by XSpecView (fx:root), which fills the
  scenario tree and shows expected and actual result of the selected test.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="8" styleClass="fxt-xspec-view"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="12"/>
    </padding>
    <children>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <IconifyIcon fx:id="summaryIcon" iconLiteral="bi-ui-checks" iconSize="20"/>
                <Label fx:id="summary" id="xspec-summary" styleClass="fxt-side-panel-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="runButton" text="%XSpecView.runButton.text" id="xspec-run-again" onAction="#onRunAgain">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-play-circle" iconSize="16"/>
                    </graphic>
                </Button>
                <Button fx:id="htmlButton" text="%XSpecView.htmlButton.text" id="xspec-html" onAction="#onHtmlReport">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-filetype-html" iconSize="16"/>
                    </graphic>
                </Button>
                <Button fx:id="junitButton" text="%XSpecView.junitButton.text" id="xspec-junit" onAction="#onExportJUnit">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-box-arrow-up" iconSize="16"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
        <Label fx:id="subject" id="xspec-subject" opacity="0.7"/>
        <SplitPane orientation="VERTICAL" dividerPositions="0.62" VBox.vgrow="ALWAYS">
            <items>
                <TreeTableView fx:id="tree" id="xspec-tree" showRoot="false">
                    <columns>
                        <TreeTableColumn fx:id="labelColumn" text="%XSpecView.labelColumn.text" prefWidth="520"/>
                        <TreeTableColumn fx:id="statusColumn" text="%XSpecView.statusColumn.text" prefWidth="140"/>
                    </columns>
                </TreeTableView>
                <SplitPane dividerPositions="0.5">
                    <items>
                        <VBox spacing="4">
                            <children>
                                <Label text="%XSpecView.expected.text"/>
                                <TextArea fx:id="expected" id="xspec-expected" editable="false" wrapText="true"
                                          styleClass="fxt-xspec-value" VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>
                        <VBox spacing="4">
                            <children>
                                <Label text="%XSpecView.actual.text"/>
                                <TextArea fx:id="actual" id="xspec-actual" editable="false" wrapText="true"
                                          styleClass="fxt-xspec-value" VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>
                    </items>
                </SplitPane>
            </items>
        </SplitPane>
    </children>
</fx:root>
