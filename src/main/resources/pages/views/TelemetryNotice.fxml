<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  One-time notice about the anonymous (opt-out) telemetry: a small card in the bottom-right
  corner of the main window. Loaded by TelemetryNotice via the fx:root pattern (FxmlViews.load);
  TelemetryNotice is root and controller. The card lives in a Popup outside the shell's
  stylesheets, so TelemetryNotice sets the theme-dependent colours inline, and the message text.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="10" prefWidth="380" maxWidth="380"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="14" right="16" bottom="12" left="16"/>
    </padding>
    <children>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <IconifyIcon fx:id="icon" iconLiteral="bi-shield-check" iconSize="20"/>
                <Label fx:id="title" text="Anonymous usage statistics"/>
            </children>
        </HBox>
        <Label fx:id="message" wrapText="true"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Hyperlink id="telemetry-notice-what" text="What is sent?" onAction="#onWhatIsSent"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button id="telemetry-notice-settings" text="Settings…" onAction="#onSettings"/>
                <Button id="telemetry-notice-ok" text="OK" defaultButton="true" onAction="#onOk"/>
            </children>
        </HBox>
    </children>
</fx:root>
