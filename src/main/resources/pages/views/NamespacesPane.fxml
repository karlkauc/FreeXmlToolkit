<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  "Namespaces" tab of the Schema Overview: the namespace declarations (xmlns:prefix) of the
  schema, edited in place. Loaded by NamespacesPane (fx:root); cell factories are built in code.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="6" styleClass="fxt-overview-pane"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="6"/>
    </padding>
    <children>
        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="fxt-overview-toolbar">
            <children>
                <Button fx:id="addButton" styleClass="fxt-tool-button" id="overview-namespace-add" text="Add Prefix" onAction="#onAdd">
                    <graphic>
                        <IconifyIcon fx:id="addIcon" iconLiteral="bi-plus-lg" iconSize="16"/>
                    </graphic>
                </Button>
                <Button fx:id="deleteButton" styleClass="fxt-tool-button" id="overview-namespace-delete" onAction="#onDelete">
                    <graphic>
                        <IconifyIcon fx:id="deleteIcon" iconLiteral="bi-trash" iconSize="16"/>
                    </graphic>
                </Button>
                <Label text="An empty prefix declares the default namespace." styleClass="fxt-placeholder-text"/>
            </children>
        </HBox>
        <TableView fx:id="namespaceTable" styleClass="fxt-analysis-table" id="overview-namespaces" editable="true" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="prefixColumn" text="Prefix" prefWidth="120" sortable="false"/>
                <TableColumn fx:id="uriColumn" text="Namespace URI" prefWidth="460" sortable="false"/>
            </columns>
            <placeholder>
                <Label text="No namespace declarations." styleClass="fxt-placeholder-text"/>
            </placeholder>
        </TableView>
    </children>
</fx:root>
