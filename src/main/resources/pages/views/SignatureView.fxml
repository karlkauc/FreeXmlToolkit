<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SourceRow?>

<!--
  The Signature page (a tab in the main editor area; the Signature side panel only picks the
  action). Every action follows the same pattern on one card: header, the inputs it needs
  (DOCUMENT and/or KEYSTORE, each shown once), the action's own form ending in its primary
  button, then the status line. Loaded by SignatureView via the fx:root pattern
  (FxmlViews.load); SignatureView is root and controller. Built in code: the favourites menus
  of the store rows and the certificate details.
-->
<fx:root type="javafx.scene.control.ScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="fxt-sign-view"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="typeGroup"/>
    </fx:define>
    <content>
        <StackPane styleClass="fxt-sign-view-wrap">
            <children>
                <VBox spacing="16" maxWidth="640" styleClass="fxt-sign-card" StackPane.alignment="TOP_CENTER">
                    <children>
                        <!-- Header: the selected action -->
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <children>
                                <StackPane styleClass="fxt-sign-icon-tile">
                                    <children>
                                        <IconifyIcon fx:id="actionIcon" iconLiteral="bi-pencil" iconSize="20"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="2">
                                    <children>
                                        <Label fx:id="actionTitle" id="sig-action-title" text="Sign XML Document"
                                               styleClass="fxt-sign-card-title"/>
                                        <Label fx:id="actionSubtitle" text="XML Digital Signature · XML-DSig"
                                               wrapText="true" styleClass="fxt-sign-card-sub"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- DOCUMENT (sign, validate, expert) -->
                        <VBox fx:id="documentSection" id="sig-section-document" spacing="8">
                            <children>
                                <Label text="DOCUMENT" styleClass="fxt-sign-section-label"/>
                                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="fxt-sign-doc-row">
                                    <children>
                                        <IconifyIcon iconLiteral="bi-code-slash" iconSize="18"/>
                                        <VBox spacing="2">
                                            <children>
                                                <Label fx:id="docName" id="sign-doc-name" text="No document"
                                                       styleClass="fxt-sign-doc-name"/>
                                                <Label fx:id="docInfo" text="Open a saved XML file to sign it"
                                                       styleClass="fxt-sign-doc-info"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Hyperlink id="sign-doc-browse" text="Browse" styleClass="fxt-vp-change"
                                                   onAction="#onChooseDocument"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- KEYSTORE (sign, create certificate): file, alias and both passwords, once -->
                        <VBox fx:id="keystoreSection" id="sig-section-keystore" spacing="8">
                            <children>
                                <Label text="KEYSTORE" styleClass="fxt-sign-section-label"/>
                                <SourceRow fx:id="keystoreRow" id="sig-keystore-row" iconLiteral="bi-file-earmark-lock"
                                           emptyText="No keystore — choose or drop a .jks / .p12"
                                           onChange="#onChooseKeystore">
                                    <name>
                                        <Label fx:id="keystoreName" id="sig-keystore-name" text="none"
                                               styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                    </name>
                                </SourceRow>
                                <HBox spacing="16">
                                    <children>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Keystore alias" styleClass="fxt-sig-field-label"/>
                                                <TextField fx:id="alias" id="sig-alias" promptText="alias"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Keystore password" styleClass="fxt-sig-field-label"/>
                                                <PasswordField fx:id="keystorePassword" id="sig-keystore-password"
                                                               promptText="keystore password"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Alias password" styleClass="fxt-sig-field-label"/>
                                                <PasswordField fx:id="aliasPassword" id="sig-alias-password"
                                                               promptText="private key password"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- SIGN -->
                        <VBox fx:id="signSection" id="sig-section-sign" spacing="12">
                            <children>
                                <Label text="SIGNATURE OPTIONS" styleClass="fxt-sign-section-label"/>
                                <Label text="Signature type" styleClass="fxt-sig-field-label"/>
                                <HBox spacing="2" styleClass="fxt-seg-group">
                                    <children>
                                        <ToggleButton fx:id="enveloped" id="sign-type-enveloped" text="Enveloped"
                                                      toggleGroup="$typeGroup" selected="true" maxWidth="Infinity"
                                                      HBox.hgrow="ALWAYS" styleClass="fxt-seg">
                                            <tooltip>
                                                <Tooltip text="The signature is inserted into the signed document"/>
                                            </tooltip>
                                        </ToggleButton>
                                        <ToggleButton fx:id="enveloping" id="sign-type-enveloping" text="Enveloping"
                                                      toggleGroup="$typeGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg">
                                            <tooltip>
                                                <Tooltip text="The signed content is wrapped inside the signature document"/>
                                            </tooltip>
                                        </ToggleButton>
                                        <ToggleButton fx:id="detached" id="sign-type-detached" text="Detached"
                                                      toggleGroup="$typeGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg">
                                            <tooltip>
                                                <Tooltip text="A standalone .sig.xml referencing the file - keep both together"/>
                                            </tooltip>
                                        </ToggleButton>
                                    </children>
                                </HBox>
                                <Label fx:id="detachedHint" id="sign-detached-hint" wrapText="true" visible="false"
                                       managed="false" styleClass="fxt-placeholder-text"
                                       text="Detached writes a separate &lt;name&gt;.sig.xml next to the document. Validate that file, and keep both files in the same folder."/>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Algorithm" styleClass="fxt-sig-field-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="RSA-SHA256 · C14N exclusive" styleClass="fxt-sign-algo"/>
                                    </children>
                                </HBox>
                                <Button id="sign-card-run" text="Sign Document" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#onSign">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-shield-lock" iconSize="15"/>
                                    </graphic>
                                </Button>
                                <!-- CERTIFICATE (the certificate inspector) -->
                                <HBox>
                                    <children>
                                        <Label text="CERTIFICATE" styleClass="fxt-sign-section-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Hyperlink id="sign-cert-load" text="Show certificate details"
                                                   styleClass="fxt-vp-change" onAction="#onShowCertificate"/>
                                    </children>
                                </HBox>
                                <VBox fx:id="certificateBox" id="sign-cert-box" spacing="8" visible="false"
                                      managed="false"/>
                            </children>
                        </VBox>

                        <!-- VALIDATE -->
                        <VBox fx:id="validateSection" id="sig-section-validate" spacing="8">
                            <children>
                                <Button id="sig-validate-run" text="Run Validation" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#validateActive">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-shield-check" iconSize="15"/>
                                    </graphic>
                                </Button>
                                <Button id="sig-validate-details" text="Validate (Details)" maxWidth="Infinity"
                                        styleClass="fxt-tool-button" onAction="#validateDetailsActive">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-card-list" iconSize="15"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Validate and open a report with the signing certificate"/>
                                    </tooltip>
                                </Button>
                            </children>
                        </VBox>

                        <!-- CREATE CERTIFICATE (uses the KEYSTORE alias and passwords) -->
                        <VBox fx:id="createSection" id="sig-section-create" spacing="8">
                            <children>
                                <Label text="CERTIFICATE" styleClass="fxt-sign-section-label"/>
                                <HBox spacing="16">
                                    <children>
                                        <TextField fx:id="cnField" promptText="Common Name (CN)" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="emailField" promptText="Email" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <HBox spacing="16">
                                    <children>
                                        <TextField fx:id="orgField" promptText="Organization (O)" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="ouField" promptText="Organizational Unit (OU)"
                                                   HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <HBox spacing="16">
                                    <children>
                                        <TextField fx:id="localityField" promptText="Locality (L)" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="stateField" promptText="State (ST)" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="countryField" promptText="Country (C)" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <Button id="sig-create-run" text="Create Certificate" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#createCertificate">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-patch-plus" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <!-- EXPERT (PKIX trust validation) -->
                        <VBox fx:id="expertSection" id="sig-section-expert" spacing="8">
                            <children>
                                <Label text="TRUST STORE" styleClass="fxt-sign-section-label"/>
                                <SourceRow fx:id="trustRow" id="sig-truststore-row" iconLiteral="bi-key"
                                           onChange="#chooseTrustStore">
                                    <name>
                                        <Label fx:id="trustStoreName" id="sig-truststore-name"
                                               text="default (cacerts)" styleClass="fxt-vp-source-name"/>
                                    </name>
                                </SourceRow>
                                <HBox spacing="16" alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Trust store password (optional)"
                                                       styleClass="fxt-sig-field-label"/>
                                                <PasswordField fx:id="trustStorePassword" id="sig-truststore-password"
                                                               promptText="trust store password"/>
                                            </children>
                                        </VBox>
                                        <CheckBox fx:id="checkRevocation" text="Check revocation (OCSP/CRL)"/>
                                    </children>
                                </HBox>
                                <Button id="sig-trust-run" text="Validate (Trust)" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#validateTrustActive">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-patch-check" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <Label fx:id="status" id="sig-status" wrapText="true" styleClass="fxt-vp-status"/>
                        <!-- After signing: check the new file without leaving the page (UX plan 7) -->
                        <Hyperlink fx:id="validateSignedLink" id="sig-validate-signed" text="Validate this signature"
                                   visible="false" managed="false" styleClass="fxt-vp-change"
                                   onAction="#onValidateSigned"/>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </content>
</fx:root>
