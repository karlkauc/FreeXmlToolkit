<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SourceRow?>

<!--
  The Signature page (a tab in the main editor area; the Signature side panel only picks the
  action). Every action follows the same pattern on one card: header, the inputs it needs
  (DOCUMENT and/or KEYSTORE, each shown once), the action's own form ending in its primary
  button, then the status line. Loaded by SignatureView via the fx:root pattern
  (FxmlViews.load); SignatureView is root and controller. Built in code: the favourites menus
  of the store rows and the certificate details.
-->
<fx:root type="javafx.scene.control.ScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="fxt-sign-view"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="typeGroup"/>
    </fx:define>
    <content>
        <StackPane styleClass="fxt-sign-view-wrap">
            <children>
                <VBox spacing="16" maxWidth="640" styleClass="fxt-sign-card" StackPane.alignment="TOP_CENTER">
                    <children>
                        <!-- Header: the selected action -->
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <children>
                                <StackPane styleClass="fxt-sign-icon-tile">
                                    <children>
                                        <IconifyIcon fx:id="actionIcon" iconLiteral="bi-pencil" iconSize="20"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="2">
                                    <children>
                                        <Label fx:id="actionTitle" id="sig-action-title" text="%SignatureView.actionTitle.text"
                                               styleClass="fxt-sign-card-title"/>
                                        <Label fx:id="actionSubtitle" text="%SignatureView.actionSubtitle.text"
                                               wrapText="true" styleClass="fxt-sign-card-sub"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- DOCUMENT (sign, validate, expert) -->
                        <VBox fx:id="documentSection" id="sig-section-document" spacing="8">
                            <children>
                                <Label text="%SignatureView.document.text" styleClass="fxt-sign-section-label"/>
                                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="fxt-sign-doc-row">
                                    <children>
                                        <IconifyIcon iconLiteral="bi-code-slash" iconSize="18"/>
                                        <VBox spacing="2">
                                            <children>
                                                <Label fx:id="docName" id="sign-doc-name" text="%SignatureView.docName.text"
                                                       styleClass="fxt-sign-doc-name"/>
                                                <Label fx:id="docInfo" text="%SignatureView.docInfo.text"
                                                       styleClass="fxt-sign-doc-info"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Hyperlink id="sign-doc-browse" text="%SignatureView.sign-doc-browse.text" styleClass="fxt-vp-change"
                                                   onAction="#onChooseDocument"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- KEYSTORE (sign, create certificate): file, alias and both passwords, once -->
                        <VBox fx:id="keystoreSection" id="sig-section-keystore" spacing="8">
                            <children>
                                <Label text="%SignatureView.keystore.text" styleClass="fxt-sign-section-label"/>
                                <SourceRow fx:id="keystoreRow" id="sig-keystore-row" iconLiteral="bi-file-earmark-lock"
                                           emptyText="%SignatureView.keystoreRow.emptyText"
                                           onChange="#onChooseKeystore">
                                    <name>
                                        <Label fx:id="keystoreName" id="sig-keystore-name" text="%SignatureView.keystoreName.text"
                                               styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                    </name>
                                </SourceRow>
                                <HBox spacing="16">
                                    <children>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.keystore-alias.text" styleClass="fxt-sig-field-label"/>
                                                <TextField fx:id="alias" id="sig-alias" promptText="%SignatureView.alias.promptText"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.keystore-password.text" styleClass="fxt-sig-field-label"/>
                                                <PasswordField fx:id="keystorePassword" id="sig-keystore-password"
                                                               promptText="%SignatureView.keystorePassword.promptText"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.alias-password.text" styleClass="fxt-sig-field-label"/>
                                                <PasswordField fx:id="aliasPassword" id="sig-alias-password"
                                                               promptText="%SignatureView.aliasPassword.promptText"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- SIGN -->
                        <VBox fx:id="signSection" id="sig-section-sign" spacing="12">
                            <children>
                                <Label text="%SignatureView.signature-options.text" styleClass="fxt-sign-section-label"/>
                                <Label text="%SignatureView.signature-type.text" styleClass="fxt-sig-field-label"/>
                                <HBox spacing="2" styleClass="fxt-seg-group">
                                    <children>
                                        <ToggleButton fx:id="enveloped" id="sign-type-enveloped" text="%SignatureView.enveloped.text"
                                                      toggleGroup="$typeGroup" selected="true" maxWidth="Infinity"
                                                      HBox.hgrow="ALWAYS" styleClass="fxt-seg">
                                            <tooltip>
                                                <Tooltip text="%SignatureView.the-signature-is-inserted-into.text"/>
                                            </tooltip>
                                        </ToggleButton>
                                        <ToggleButton fx:id="enveloping" id="sign-type-enveloping" text="%SignatureView.enveloping.text"
                                                      toggleGroup="$typeGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg">
                                            <tooltip>
                                                <Tooltip text="%SignatureView.the-signed-content-is-wrapped.text"/>
                                            </tooltip>
                                        </ToggleButton>
                                        <ToggleButton fx:id="detached" id="sign-type-detached" text="%SignatureView.detached.text"
                                                      toggleGroup="$typeGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg">
                                            <tooltip>
                                                <Tooltip text="%SignatureView.a-standalone-sig-xml-referencing.text"/>
                                            </tooltip>
                                        </ToggleButton>
                                    </children>
                                </HBox>
                                <Label fx:id="detachedHint" id="sign-detached-hint" wrapText="true" visible="false"
                                       managed="false" styleClass="fxt-placeholder-text"
                                       text="%SignatureView.detachedHint.text"/>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%SignatureView.algorithm.text" styleClass="fxt-sig-field-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="%SignatureView.rsa-sha256-c14n-exclusive.text" styleClass="fxt-sign-algo"/>
                                    </children>
                                </HBox>
                                <Button id="sign-card-run" text="%SignatureView.sign-card-run.text" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#onSign">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-shield-lock" iconSize="15"/>
                                    </graphic>
                                </Button>
                                <!-- CERTIFICATE (the certificate inspector) -->
                                <HBox>
                                    <children>
                                        <Label text="%SignatureView.certificate.text" styleClass="fxt-sign-section-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Hyperlink id="sign-cert-load" text="%SignatureView.sign-cert-load.text"
                                                   styleClass="fxt-vp-change" onAction="#onShowCertificate"/>
                                    </children>
                                </HBox>
                                <VBox fx:id="certificateBox" id="sign-cert-box" spacing="8" visible="false"
                                      managed="false"/>
                            </children>
                        </VBox>

                        <!-- VALIDATE -->
                        <VBox fx:id="validateSection" id="sig-section-validate" spacing="8">
                            <children>
                                <Button id="sig-validate-run" text="%SignatureView.sig-validate-run.text" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#validateActive">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-shield-check" iconSize="15"/>
                                    </graphic>
                                </Button>
                                <Button id="sig-validate-details" text="%SignatureView.sig-validate-details.text" maxWidth="Infinity"
                                        styleClass="fxt-tool-button" onAction="#validateDetailsActive">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-card-list" iconSize="15"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%SignatureView.validate-and-open-a-report.text"/>
                                    </tooltip>
                                </Button>
                            </children>
                        </VBox>

                        <!-- CREATE CERTIFICATE (uses the KEYSTORE alias and passwords) -->
                        <VBox fx:id="createSection" id="sig-section-create" spacing="8">
                            <children>
                                <Label text="%SignatureView.certificate.text-2" styleClass="fxt-sign-section-label"/>
                                <HBox spacing="16">
                                    <children>
                                        <TextField fx:id="cnField" promptText="%SignatureView.cnField.promptText" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="emailField" promptText="%SignatureView.emailField.promptText" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <HBox spacing="16">
                                    <children>
                                        <TextField fx:id="orgField" promptText="%SignatureView.orgField.promptText" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="ouField" promptText="%SignatureView.ouField.promptText"
                                                   HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <HBox spacing="16">
                                    <children>
                                        <TextField fx:id="localityField" promptText="%SignatureView.localityField.promptText" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="stateField" promptText="%SignatureView.stateField.promptText" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="countryField" promptText="%SignatureView.countryField.promptText" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <Button id="sig-create-run" text="%SignatureView.sig-create-run.text" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#createCertificate">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-patch-plus" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <!-- EXPERT (PKIX trust validation) -->
                        <VBox fx:id="expertSection" id="sig-section-expert" spacing="8">
                            <children>
                                <Label text="%SignatureView.trust-store.text" styleClass="fxt-sign-section-label"/>
                                <SourceRow fx:id="trustRow" id="sig-truststore-row" iconLiteral="bi-key"
                                           onChange="#chooseTrustStore">
                                    <name>
                                        <Label fx:id="trustStoreName" id="sig-truststore-name"
                                               text="%SignatureView.trustStoreName.text" styleClass="fxt-vp-source-name"/>
                                    </name>
                                </SourceRow>
                                <HBox spacing="16" alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.trust-store-password-optional.text"
                                                       styleClass="fxt-sig-field-label"/>
                                                <PasswordField fx:id="trustStorePassword" id="sig-truststore-password"
                                                               promptText="%SignatureView.trustStorePassword.promptText"/>
                                            </children>
                                        </VBox>
                                        <CheckBox fx:id="checkRevocation" text="%SignatureView.checkRevocation.text"/>
                                    </children>
                                </HBox>
                                <Button id="sig-trust-run" text="%SignatureView.sig-trust-run.text" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#validateTrustActive">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-patch-check" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <Label fx:id="status" id="sig-status" wrapText="true" styleClass="fxt-vp-status"/>
                        <!-- After signing: check the new file without leaving the page (UX plan 7) -->
                        <Hyperlink fx:id="validateSignedLink" id="sig-validate-signed" text="%SignatureView.validateSignedLink.text"
                                   visible="false" managed="false" styleClass="fxt-vp-change"
                                   onAction="#onValidateSigned"/>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </content>
</fx:root>
