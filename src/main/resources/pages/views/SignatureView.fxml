<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SourceRow?>

<!--
  The Signature page (a tab in the main editor area; the Signature side panel only picks the
  action). Every action follows the same pattern on one card: header, the inputs it needs
  (DOCUMENT and/or KEYSTORE, each shown once), the action's own form ending in its primary
  button, then the status line. Loaded by SignatureView via the fx:root pattern
  (FxmlViews.load); SignatureView is root and controller. Built in code: the favourites menus
  of the store rows and the certificate details.
-->
<fx:root type="javafx.scene.control.ScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="fxt-sign-view"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="typeGroup"/>
        <ToggleGroup fx:id="encTargetGroup"/>
        <ToggleGroup fx:id="decKeyGroup"/>
    </fx:define>
    <content>
        <StackPane styleClass="fxt-sign-view-wrap">
            <children>
                <VBox spacing="16" maxWidth="640" styleClass="fxt-sign-card" StackPane.alignment="TOP_CENTER">
                    <children>
                        <!-- Header: the selected action -->
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <children>
                                <StackPane styleClass="fxt-sign-icon-tile">
                                    <children>
                                        <IconifyIcon fx:id="actionIcon" iconLiteral="bi-pencil" iconSize="20"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="2">
                                    <children>
                                        <Label fx:id="actionTitle" id="sig-action-title" text="%SignatureView.actionTitle.text"
                                               styleClass="fxt-sign-card-title"/>
                                        <Label fx:id="actionSubtitle" text="%SignatureView.actionSubtitle.text"
                                               wrapText="true" styleClass="fxt-sign-card-sub"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- DOCUMENT (sign, validate, expert) -->
                        <VBox fx:id="documentSection" id="sig-section-document" spacing="8">
                            <children>
                                <Label text="%SignatureView.document.text" styleClass="fxt-sign-section-label"/>
                                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="fxt-sign-doc-row">
                                    <children>
                                        <IconifyIcon iconLiteral="bi-code-slash" iconSize="18"/>
                                        <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0">
                                            <children>
                                                <Label fx:id="docName" id="sign-doc-name" text="%SignatureView.docName.text"
                                                       styleClass="fxt-sign-doc-name"/>
                                                <Label fx:id="docInfo" text="%SignatureView.docInfo.text" wrapText="true"
                                                       styleClass="fxt-sign-doc-info"/>
                                            </children>
                                        </VBox>
                                        <Hyperlink id="sign-doc-browse" text="%SignatureView.sign-doc-browse.text" styleClass="fxt-vp-change"
                                                   minWidth="-Infinity" onAction="#onChooseDocument"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- KEYSTORE (sign, create certificate): file, alias and both passwords, once -->
                        <VBox fx:id="keystoreSection" id="sig-section-keystore" spacing="8">
                            <children>
                                <Label text="%SignatureView.keystore.text" styleClass="fxt-sign-section-label"/>
                                <SourceRow fx:id="keystoreRow" id="sig-keystore-row" iconLiteral="bi-file-earmark-lock"
                                           emptyText="%SignatureView.keystoreRow.emptyText"
                                           onChange="#onChooseKeystore">
                                    <name>
                                        <Label fx:id="keystoreName" id="sig-keystore-name" text="%SignatureView.keystoreName.text"
                                               styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                    </name>
                                </SourceRow>
                                <HBox spacing="16">
                                    <children>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.keystore-alias.text" styleClass="fxt-sig-field-label"/>
                                                <TextField fx:id="alias" id="sig-alias" promptText="%SignatureView.alias.promptText"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.keystore-password.text" styleClass="fxt-sig-field-label"/>
                                                <PasswordField fx:id="keystorePassword" id="sig-keystore-password"
                                                               promptText="%SignatureView.keystorePassword.promptText"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.alias-password.text" styleClass="fxt-sig-field-label"/>
                                                <PasswordField fx:id="aliasPassword" id="sig-alias-password"
                                                               promptText="%SignatureView.aliasPassword.promptText"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- SIGN -->
                        <VBox fx:id="signSection" id="sig-section-sign" spacing="12">
                            <children>
                                <Label text="%SignatureView.signature-options.text" styleClass="fxt-sign-section-label"/>
                                <Label text="%SignatureView.signature-type.text" styleClass="fxt-sig-field-label"/>
                                <HBox spacing="2" styleClass="fxt-seg-group">
                                    <children>
                                        <ToggleButton fx:id="enveloped" id="sign-type-enveloped" text="%SignatureView.enveloped.text"
                                                      toggleGroup="$typeGroup" selected="true" maxWidth="Infinity"
                                                      HBox.hgrow="ALWAYS" styleClass="fxt-seg">
                                            <tooltip>
                                                <Tooltip text="%SignatureView.the-signature-is-inserted-into.text"/>
                                            </tooltip>
                                        </ToggleButton>
                                        <ToggleButton fx:id="enveloping" id="sign-type-enveloping" text="%SignatureView.enveloping.text"
                                                      toggleGroup="$typeGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg">
                                            <tooltip>
                                                <Tooltip text="%SignatureView.the-signed-content-is-wrapped.text"/>
                                            </tooltip>
                                        </ToggleButton>
                                        <ToggleButton fx:id="detached" id="sign-type-detached" text="%SignatureView.detached.text"
                                                      toggleGroup="$typeGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg">
                                            <tooltip>
                                                <Tooltip text="%SignatureView.a-standalone-sig-xml-referencing.text"/>
                                            </tooltip>
                                        </ToggleButton>
                                    </children>
                                </HBox>
                                <Label fx:id="detachedHint" id="sign-detached-hint" wrapText="true" visible="false"
                                       managed="false" styleClass="fxt-placeholder-text"
                                       text="%SignatureView.detachedHint.text"/>
                                <HBox spacing="16">
                                    <children>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.signature-method.text" styleClass="fxt-sig-field-label"/>
                                                <ComboBox fx:id="signMethod" id="sign-method" maxWidth="Infinity"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.digest.text" styleClass="fxt-sig-field-label"/>
                                                <ComboBox fx:id="signDigest" id="sign-digest" maxWidth="Infinity"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.canonicalization.text" styleClass="fxt-sig-field-label"/>
                                                <ComboBox fx:id="signC14n" id="sign-c14n" maxWidth="Infinity"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <Button id="sign-card-run" text="%SignatureView.sign-card-run.text" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#onSign">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-shield-lock" iconSize="15"/>
                                    </graphic>
                                </Button>
                                <!-- CERTIFICATE (the certificate inspector) -->
                                <HBox>
                                    <children>
                                        <Label text="%SignatureView.certificate.text" styleClass="fxt-sign-section-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Hyperlink id="sign-cert-load" text="%SignatureView.sign-cert-load.text"
                                                   styleClass="fxt-vp-change" onAction="#onShowCertificate"/>
                                    </children>
                                </HBox>
                                <VBox fx:id="certificateBox" id="sign-cert-box" spacing="8" visible="false"
                                      managed="false"/>
                            </children>
                        </VBox>

                        <!-- VALIDATE -->
                        <VBox fx:id="validateSection" id="sig-section-validate" spacing="8">
                            <children>
                                <Button id="sig-validate-run" text="%SignatureView.sig-validate-run.text" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#validateActive">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-shield-check" iconSize="15"/>
                                    </graphic>
                                </Button>
                                <Button id="sig-validate-details" text="%SignatureView.sig-validate-details.text" maxWidth="Infinity"
                                        styleClass="fxt-tool-button" onAction="#validateDetailsActive">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-card-list" iconSize="15"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%SignatureView.validate-and-open-a-report.text"/>
                                    </tooltip>
                                </Button>
                            </children>
                        </VBox>

                        <!-- CREATE CERTIFICATE (uses the KEYSTORE alias and passwords) -->
                        <VBox fx:id="createSection" id="sig-section-create" spacing="8">
                            <children>
                                <Label text="%SignatureView.certificate.text-2" styleClass="fxt-sign-section-label"/>
                                <HBox spacing="16">
                                    <children>
                                        <TextField fx:id="cnField" promptText="%SignatureView.cnField.promptText" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="emailField" promptText="%SignatureView.emailField.promptText" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <HBox spacing="16">
                                    <children>
                                        <TextField fx:id="orgField" promptText="%SignatureView.orgField.promptText" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="ouField" promptText="%SignatureView.ouField.promptText"
                                                   HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <HBox spacing="16">
                                    <children>
                                        <TextField fx:id="localityField" promptText="%SignatureView.localityField.promptText" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="stateField" promptText="%SignatureView.stateField.promptText" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="countryField" promptText="%SignatureView.countryField.promptText" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%SignatureView.key-type.text" styleClass="fxt-sig-field-label" minWidth="-Infinity"/>
                                        <ComboBox fx:id="keyTypeChoice" id="sig-create-key-type" minWidth="-Infinity"/>
                                        <Label text="%SignatureView.ec-keys-sign-with-ecdsa.text"
                                               wrapText="true" styleClass="fxt-placeholder-text" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <Button id="sig-create-run" text="%SignatureView.sig-create-run.text" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#createCertificate">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-patch-plus" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <!-- ENCRYPT (XML Encryption 1.1): target, data algorithm, recipients, options -->
                        <VBox fx:id="encryptSection" id="sig-section-encrypt" spacing="12">
                            <children>
                                <Label text="%SignatureView.what-to-encrypt.text" styleClass="fxt-sign-section-label"/>
                                <HBox spacing="2" styleClass="fxt-seg-group">
                                    <children>
                                        <ToggleButton fx:id="encTargetDocument" id="enc-target-document" text="%SignatureView.encTargetDocument.text"
                                                      toggleGroup="$encTargetGroup" selected="true" maxWidth="Infinity"
                                                      HBox.hgrow="ALWAYS" styleClass="fxt-seg"/>
                                        <ToggleButton fx:id="encTargetCaret" id="enc-target-caret" text="%SignatureView.encTargetCaret.text"
                                                      toggleGroup="$encTargetGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg"/>
                                        <ToggleButton fx:id="encTargetXPath" id="enc-target-xpath" text="%SignatureView.encTargetXPath.text"
                                                      toggleGroup="$encTargetGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg"/>
                                    </children>
                                </HBox>
                                <TextField fx:id="encXPath" id="enc-xpath" visible="false" managed="false"
                                           promptText="%SignatureView.encXPath.promptText"/>
                                <CheckBox fx:id="encContentOnly" id="enc-content-only"
                                          text="%SignatureView.encContentOnly.text"/>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%SignatureView.data-algorithm.text" styleClass="fxt-sig-field-label" minWidth="-Infinity"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <ComboBox fx:id="encDataAlgorithm" id="enc-data-alg" minWidth="-Infinity"/>
                                    </children>
                                </HBox>
                                <Label text="%SignatureView.recipients.text" styleClass="fxt-sign-section-label"/>
                                <VBox fx:id="recipientList" id="enc-recipients" spacing="6"/>
                                <Label fx:id="recipientsEmpty" id="enc-recipients-empty" wrapText="true"
                                       styleClass="fxt-placeholder-text"
                                       text="%SignatureView.recipientsEmpty.text"/>
                                <FlowPane hgap="8" vgap="4">
                                    <children>
                                        <Button id="enc-add-certificate" minWidth="-Infinity" text="%SignatureView.enc-add-certificate.text" styleClass="fxt-tool-button"
                                                onAction="#onAddCertificate">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-person-badge" iconSize="15"/>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="%SignatureView.a-recipient-s-certificate-or.text"/>
                                            </tooltip>
                                        </Button>
                                        <Button id="enc-add-keystore" minWidth="-Infinity" text="%SignatureView.enc-add-keystore.text" styleClass="fxt-tool-button"
                                                onAction="#onAddKeystoreRecipient">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-file-earmark-lock" iconSize="15"/>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="%SignatureView.the-certificate-of-the-alias.text"/>
                                            </tooltip>
                                        </Button>
                                        <Button id="enc-add-key-file" minWidth="-Infinity" text="%SignatureView.enc-add-key-file.text" styleClass="fxt-tool-button"
                                                onAction="#onAddKeyFile">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-key" iconSize="15"/>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="%SignatureView.a-shared-symmetric-key-16.text"/>
                                            </tooltip>
                                        </Button>
                                        <Button id="enc-add-password" minWidth="-Infinity" text="%SignatureView.enc-add-password.text" styleClass="fxt-tool-button"
                                                onAction="#onAddPassword">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-asterisk" iconSize="15"/>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="%SignatureView.a-password-pbkdf2-derives-the.text"/>
                                            </tooltip>
                                        </Button>
                                    </children>
                                </FlowPane>
                                <TitledPane fx:id="encAdvanced" id="enc-advanced" text="%SignatureView.encAdvanced.text" expanded="false"
                                            animated="false">
                                    <content>
                                        <VBox spacing="8">
                                            <children>
                                                <HBox spacing="16">
                                                    <children>
                                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="%SignatureView.rsa-key-transport.text" styleClass="fxt-sig-field-label"/>
                                                                <ComboBox fx:id="encKeyTransport" id="enc-key-transport" maxWidth="Infinity"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="%SignatureView.oaep-digest.text" styleClass="fxt-sig-field-label"/>
                                                                <ComboBox fx:id="encOaepDigest" id="enc-oaep-digest" maxWidth="Infinity"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="%SignatureView.oaep-mask-mgf.text" styleClass="fxt-sig-field-label"/>
                                                                <ComboBox fx:id="encMgf" id="enc-mgf" maxWidth="Infinity"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="16">
                                                    <children>
                                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="%SignatureView.key-derivation-ec-keys.text" styleClass="fxt-sig-field-label"/>
                                                                <ComboBox fx:id="encKdf" id="enc-kdf" maxWidth="Infinity"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="%SignatureView.kdf-digest.text" styleClass="fxt-sig-field-label"/>
                                                                <ComboBox fx:id="encKdfDigest" id="enc-kdf-digest" maxWidth="Infinity"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="%SignatureView.key-wrap.text" styleClass="fxt-sig-field-label"/>
                                                                <ComboBox fx:id="encKeyWrap" id="enc-key-wrap" maxWidth="Infinity"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="16">
                                                    <children>
                                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="%SignatureView.certificate-reference.text" styleClass="fxt-sig-field-label"/>
                                                                <ComboBox fx:id="encX509" id="enc-x509" maxWidth="Infinity"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="%SignatureView.recipient-attribute.text" styleClass="fxt-sig-field-label"/>
                                                                <TextField fx:id="encRecipientName" id="enc-recipient-name"
                                                                           promptText="%SignatureView.encRecipientName.promptText"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="encKeysOutside" id="enc-keys-outside"
                                                          text="%SignatureView.encKeysOutside.text"/>
                                                <Label text="%SignatureView.encryption-properties-one-name-value.text"
                                                       styleClass="fxt-sig-field-label"/>
                                                <TextArea fx:id="encProperties" id="enc-properties" prefRowCount="3"
                                                          promptText="%SignatureView.encProperties.promptText"/>
                                            </children>
                                        </VBox>
                                    </content>
                                </TitledPane>
                                <Label fx:id="encLegacyWarning" id="enc-legacy-warning" wrapText="true" visible="false"
                                       managed="false" styleClass="fxt-sign-legacy-warning"/>
                                <Button id="enc-run" text="%SignatureView.enc-run.text" maxWidth="Infinity" styleClass="fxt-primary-button"
                                        onAction="#onEncrypt">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-lock" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <!-- DECRYPT: the key (keystore above, PEM key, key file or password) -->
                        <VBox fx:id="decryptSection" id="sig-section-decrypt" spacing="12">
                            <children>
                                <Label text="%SignatureView.key.text" styleClass="fxt-sign-section-label"/>
                                <HBox spacing="2" styleClass="fxt-seg-group">
                                    <children>
                                        <ToggleButton fx:id="decKeyKeystore" id="dec-key-keystore" text="%SignatureView.decKeyKeystore.text"
                                                      toggleGroup="$decKeyGroup" selected="true" maxWidth="Infinity"
                                                      HBox.hgrow="ALWAYS" styleClass="fxt-seg"/>
                                        <ToggleButton fx:id="decKeyPem" id="dec-key-pem" text="%SignatureView.decKeyPem.text"
                                                      toggleGroup="$decKeyGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg"/>
                                        <ToggleButton fx:id="decKeyFile" id="dec-key-file" text="%SignatureView.decKeyFile.text"
                                                      toggleGroup="$decKeyGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg"/>
                                        <ToggleButton fx:id="decKeyPassword" id="dec-key-password" text="%SignatureView.decKeyPassword.text"
                                                      toggleGroup="$decKeyGroup" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                      styleClass="fxt-seg"/>
                                    </children>
                                </HBox>
                                <VBox fx:id="decPemBox" spacing="8" visible="false" managed="false">
                                    <children>
                                        <SourceRow fx:id="decPemRow" id="dec-pem-row" iconLiteral="bi-key"
                                                   emptyText="%SignatureView.decPemRow.emptyText" onChange="#onChooseDecryptionKey">
                                            <name>
                                                <Label fx:id="decPemName" id="dec-pem-name" text="%SignatureView.decPemName.text"
                                                       styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                            </name>
                                        </SourceRow>
                                        <PasswordField fx:id="decPemPassword" id="dec-pem-password"
                                                       promptText="%SignatureView.decPemPassword.promptText"/>
                                    </children>
                                </VBox>
                                <VBox fx:id="decKeyFileBox" spacing="8" visible="false" managed="false">
                                    <children>
                                        <SourceRow fx:id="decKeyFileRow" id="dec-keyfile-row" iconLiteral="bi-key"
                                                   emptyText="%SignatureView.decKeyFileRow.emptyText" onChange="#onChooseDecryptionKeyFile">
                                            <name>
                                                <Label fx:id="decKeyFileName" id="dec-keyfile-name" text="%SignatureView.decKeyFileName.text"
                                                       styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                            </name>
                                        </SourceRow>
                                        <TextField fx:id="decKeyName" id="dec-key-name"
                                                   promptText="%SignatureView.decKeyName.promptText"/>
                                    </children>
                                </VBox>
                                <PasswordField fx:id="decPassword" id="dec-password" visible="false" managed="false"
                                               promptText="%SignatureView.decPassword.promptText"/>
                                <Button id="dec-run" text="%SignatureView.dec-run.text" maxWidth="Infinity" styleClass="fxt-primary-button"
                                        onAction="#onDecrypt">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-unlock" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <!-- INSPECT: the structure of an encrypted document, no key -->
                        <VBox fx:id="inspectSection" id="sig-section-inspect" spacing="8">
                            <children>
                                <Label wrapText="true" styleClass="fxt-placeholder-text"
                                       text="%SignatureView.shows-what-is-encrypted-for.text"/>
                                <Button id="inspect-run" text="%SignatureView.inspect-run.text" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#onInspect">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-search" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <!-- EXPERT (PKIX trust validation) -->
                        <VBox fx:id="expertSection" id="sig-section-expert" spacing="8">
                            <children>
                                <Label text="%SignatureView.trust-store.text" styleClass="fxt-sign-section-label"/>
                                <SourceRow fx:id="trustRow" id="sig-truststore-row" iconLiteral="bi-key"
                                           onChange="#chooseTrustStore">
                                    <name>
                                        <Label fx:id="trustStoreName" id="sig-truststore-name"
                                               text="%SignatureView.trustStoreName.text" styleClass="fxt-vp-source-name"/>
                                    </name>
                                </SourceRow>
                                <HBox spacing="16" alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="%SignatureView.trust-store-password-optional.text"
                                                       styleClass="fxt-sig-field-label"/>
                                                <PasswordField fx:id="trustStorePassword" id="sig-truststore-password"
                                                               promptText="%SignatureView.trustStorePassword.promptText"/>
                                            </children>
                                        </VBox>
                                        <CheckBox fx:id="checkRevocation" text="%SignatureView.checkRevocation.text" minWidth="-Infinity"/>
                                    </children>
                                </HBox>
                                <Button id="sig-trust-run" text="%SignatureView.sig-trust-run.text" maxWidth="Infinity"
                                        styleClass="fxt-primary-button" onAction="#validateTrustActive">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-patch-check" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <Label fx:id="status" id="sig-status" wrapText="true" styleClass="fxt-vp-status"/>
                        <!-- After signing: check the new file without leaving the page (UX plan 7) -->
                        <Hyperlink fx:id="validateSignedLink" id="sig-validate-signed" text="%SignatureView.validateSignedLink.text"
                                   visible="false" managed="false" styleClass="fxt-vp-change"
                                   onAction="#onValidateSigned"/>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </content>
</fx:root>
