<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  One-time hint above the editor when an FMA pension fund report (PK-Meldewesen) is opened while
  the extension is off. Loaded by PkHintBar via the fx:root pattern (FxmlViews.load).
-->
<fx:root type="javafx.scene.layout.HBox" id="pk-hint" spacing="10" alignment="CENTER_LEFT"
         styleClass="fxt-hint-bar, fxt-wf-pension" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <IconifyIcon iconLiteral="bi-lightbulb" iconSize="16" styleClass="fxt-hint-bar-icon"/>
        <Label text="%PkHintBar.text"
               wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="fxt-hint-bar-text"
               HBox.hgrow="ALWAYS"/>
        <Button id="pk-hint-enable" text="%PkHintBar.pk-hint-enable.text" minWidth="-Infinity" styleClass="fxt-primary-button"
                onAction="#onEnable">
            <graphic><IconifyIcon iconLiteral="bi-toggle-on" iconSize="16"/></graphic>
        </Button>
        <Button id="pk-hint-dismiss" text="%PkHintBar.pk-hint-dismiss.text" minWidth="-Infinity" styleClass="fxt-tool-button, fxt-tool-neutral"
                onAction="#onDismiss"/>
    </children>
</fx:root>
