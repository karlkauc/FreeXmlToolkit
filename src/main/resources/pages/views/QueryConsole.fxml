<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  XPath/XQuery console: the QUERY column (target document, Run / Save / Snippets, the XPath |
  XQuery mode toggle and the editor) and the RESULTS column (statistics, Copy / Save and the
  output). Loaded by QueryConsole (FxmlViews.loadContent), which is the controller and puts
  this SplitPane inside itself. Built in code: the RichTextFX editors (query inputs go into
  "inputStack", the result viewer is appended to "resultsBox") and the Snippets menu items.

  The divider favours the results side: queries are short, results need room. Run / Save /
  Snippets sit in the header so the completion popup, which opens downward, never hides them.
-->
<SplitPane dividerPositions="0.38" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="modeGroup"/>
    </fx:define>
    <items>
        <!-- No max-width cap: the divider can be dragged freely; the min-width keeps it usable. -->
        <VBox spacing="8" minWidth="160" styleClass="fxt-side-panel-content">
            <padding>
                <Insets topRightBottomLeft="8"/>
            </padding>
            <children>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="%QueryConsole.query.text" minWidth="-Infinity" styleClass="fxt-side-panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="runButton" text="%QueryConsole.runButton.text" minWidth="-Infinity" styleClass="fxt-tool-button" onAction="#run">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-play-fill" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="%QueryConsole.run-the-query-against-the.text"/>
                            </tooltip>
                        </Button>
                        <Button text="%QueryConsole.save.text" minWidth="-Infinity" styleClass="fxt-tool-button" onAction="#saveSnippet">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-save" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="%QueryConsole.save-the-current-query-as.text"/>
                            </tooltip>
                        </Button>
                        <MenuButton minWidth="-Infinity" fx:id="snippetsMenu" text="%QueryConsole.snippetsMenu.text" styleClass="fxt-tool-button"
                                    onShowing="#onSnippetsShowing">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="%QueryConsole.load-a-saved-xpath-xquery.text"/>
                            </tooltip>
                        </MenuButton>
                        <MenuButton minWidth="-Infinity" fx:id="examplesMenu" id="query-examples" text="%QueryConsole.examplesMenu.text"
                                    styleClass="fxt-tool-button">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-lightbulb" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="%QueryConsole.insert-a-built-in-xquery.text"/>
                            </tooltip>
                        </MenuButton>
                    </children>
                </HBox>
                <!-- Mode switch: a segmented control like the editor's Text | Tree | Graphic switch,
                     the active mode filled in the primary colour so it reads at a glance. -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <HBox styleClass="fxt-view-switch" minWidth="-Infinity" maxWidth="-Infinity">
                            <children>
                                <ToggleButton fx:id="xpathToggle" id="query-mode-xpath" text="%QueryConsole.xpathToggle.text" toggleGroup="$modeGroup"
                                              selected="true" focusTraversable="false" styleClass="fxt-view-seg">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-signpost-split" iconSize="13"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%QueryConsole.evaluate-an-xpath-expression-against.text"/>
                                    </tooltip>
                                </ToggleButton>
                                <ToggleButton fx:id="xqueryToggle" id="query-mode-xquery" text="%QueryConsole.xqueryToggle.text" toggleGroup="$modeGroup"
                                              focusTraversable="false" styleClass="fxt-view-seg">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-code-square" iconSize="13"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%QueryConsole.run-an-xquery-script-against.text"/>
                                    </tooltip>
                                </ToggleButton>
                            </children>
                        </HBox>
                        <Label fx:id="target" styleClass="fxt-toolbar-status">
                            <tooltip>
                                <Tooltip text="%QueryConsole.the-query-runs-against-the.text"/>
                            </tooltip>
                        </Label>
                    </children>
                </HBox>
                <StackPane fx:id="inputStack" maxHeight="Infinity" VBox.vgrow="ALWAYS"/>
                <!-- Enter adds a line (queries can span lines); say how to run (UX plan 7) -->
                <Label fx:id="runHint" id="query-run-hint" text="%QueryConsole.runHint.text"
                       styleClass="fxt-placeholder-text"/>
            </children>
        </VBox>

        <VBox fx:id="resultsBox" spacing="8" styleClass="fxt-side-panel-content">
            <padding>
                <Insets topRightBottomLeft="8"/>
            </padding>
            <children>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="%QueryConsole.results.text" styleClass="fxt-side-panel-title"/>
                        <Label fx:id="statsLabel" styleClass="fxt-output-status"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="tableButton" id="query-show-table" text="%QueryConsole.tableButton.text" styleClass="fxt-tool-button"
                                disable="true" onAction="#onShowTable">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-table" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="%QueryConsole.show-the-xquery-result-as.text"/>
                            </tooltip>
                        </Button>
                        <Button text="%QueryConsole.copy.text" styleClass="fxt-tool-button" onAction="#onCopyResults">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-clipboard" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="%QueryConsole.copy-the-full-result-to.text"/>
                            </tooltip>
                        </Button>
                        <Button text="%QueryConsole.save.text-2" styleClass="fxt-tool-button" onAction="#saveResults">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-save" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="%QueryConsole.save-the-result-to-a.text"/>
                            </tooltip>
                        </Button>
                        <!-- Top right of the console: closes it (same as Ctrl+Shift+X). -->
                        <Button id="query-console-close" styleClass="fxt-tool-button" onAction="#onClose">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-x-lg" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="%QueryConsole.close-the-query-console.text"/>
                            </tooltip>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </items>
</SplitPane>
