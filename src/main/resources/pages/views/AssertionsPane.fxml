<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  "Assertions" tab of the Schema Overview: the XSD 1.1 xs:assert of the selected complex type
  (or an element's anonymous complex type), edited in place (test, xpathDefaultNamespace).
  Loaded by AssertionsPane (fx:root); cell factories are built in code.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="6" styleClass="fxt-overview-pane"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="6"/>
    </padding>
    <children>
        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="fxt-overview-toolbar">
            <children>
                <Button fx:id="addButton" styleClass="fxt-tool-button" id="overview-assertion-add" text="Add Assertion" onAction="#onAdd">
                    <graphic>
                        <IconifyIcon fx:id="addIcon" iconLiteral="bi-plus-lg" iconSize="16"/>
                    </graphic>
                </Button>
                <Button fx:id="deleteButton" styleClass="fxt-tool-button" id="overview-assertion-delete" onAction="#onDelete">
                    <graphic>
                        <IconifyIcon fx:id="deleteIcon" iconLiteral="bi-trash" iconSize="16"/>
                    </graphic>
                </Button>
                <Label fx:id="hintLabel" styleClass="fxt-placeholder-text" wrapText="true"/>
            </children>
        </HBox>
        <TableView fx:id="assertTable" styleClass="fxt-analysis-table" id="overview-assertions" editable="true" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="testColumn" text="Test (XPath)" prefWidth="420" sortable="false"/>
                <TableColumn fx:id="namespaceColumn" text="xpathDefaultNamespace" prefWidth="200" sortable="false"/>
            </columns>
            <placeholder>
                <Label text="No assertions." styleClass="fxt-placeholder-text"/>
            </placeholder>
        </TableView>
    </children>
</fx:root>
