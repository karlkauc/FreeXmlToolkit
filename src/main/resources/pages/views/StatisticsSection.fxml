<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  "Statistics" sub-tab of the Schema Analysis tool tab: toolbar (Export + status), then a
  scrolling column of KPI row, detail-card grid, schema-reference table, most used / unused
  types and unused groups / circular references. Loaded by StatisticsSection via the fx:root
  pattern (FxmlViews.load); StatisticsSection is root and controller. Built in code: the Export
  menu, the KPI tiles and detail cards, the card grid's column constraints, all cell factories
  and the counts appended to the group titles.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="10" styleClass="fxt-analysis-section"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox fx:id="toolbar" spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="status" styleClass="fxt-placeholder-text"/>
            </children>
        </HBox>
        <ScrollPane fx:id="scroll" fitToWidth="true" styleClass="edge-to-edge" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="content" spacing="16">
                    <padding>
                        <Insets top="4" right="4" bottom="12" left="4"/>
                    </padding>
                    <children>
                        <HBox fx:id="kpis" id="analysis-kpis" spacing="12" alignment="CENTER_LEFT"/>
                        <GridPane fx:id="cards" id="analysis-cards" hgap="12" vgap="12"/>

                        <!-- Includes / imports with their resolution status; hidden when there are none -->
                        <VBox fx:id="referencesBox" spacing="6" visible="false">
                            <children>
                                <Label fx:id="referencesTitle" text="%StatisticsSection.referencesTitle.text"
                                       styleClass="fxt-analysis-group-title"/>
                                <TableView fx:id="references" id="analysis-references" minHeight="110"
                                           prefHeight="150" styleClass="fxt-analysis-table">
                                    <columns>
                                        <TableColumn fx:id="referenceTypeColumn" text="%StatisticsSection.referenceTypeColumn.text" prefWidth="80"/>
                                        <TableColumn fx:id="referenceLocationColumn" text="%StatisticsSection.referenceLocationColumn.text" prefWidth="260"/>
                                        <TableColumn fx:id="referenceStatusColumn" text="%StatisticsSection.referenceStatusColumn.text" prefWidth="90"/>
                                        <TableColumn fx:id="referenceNamespaceColumn" text="%StatisticsSection.referenceNamespaceColumn.text"
                                                     prefWidth="220"/>
                                        <TableColumn fx:id="referenceElementsColumn" text="%StatisticsSection.referenceElementsColumn.text" prefWidth="80"/>
                                        <TableColumn fx:id="referenceTypesColumn" text="%StatisticsSection.referenceTypesColumn.text" prefWidth="70"/>
                                        <TableColumn fx:id="referenceGroupsColumn" text="%StatisticsSection.referenceGroupsColumn.text" prefWidth="70"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                        <HBox spacing="12" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="topTypesTitle" text="%StatisticsSection.topTypesTitle.text"
                                               styleClass="fxt-analysis-group-title"/>
                                        <TableView fx:id="topTypes" id="analysis-top-types" minHeight="180"
                                                   prefHeight="220" styleClass="fxt-analysis-table"
                                                   VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="typeNameColumn" text="%StatisticsSection.typeNameColumn.text" prefWidth="260"/>
                                                <TableColumn fx:id="usageColumn" text="%StatisticsSection.usageColumn.text" prefWidth="160"/>
                                            </columns>
                                            <placeholder>
                                                <Label text="%StatisticsSection.no-user-defined-types-are.text"
                                                       styleClass="fxt-analysis-empty"/>
                                            </placeholder>
                                        </TableView>
                                    </children>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="unusedTitle" text="%StatisticsSection.unusedTitle.text"
                                               styleClass="fxt-analysis-group-title"/>
                                        <ListView fx:id="unusedTypes" id="analysis-unused-types" minHeight="180"
                                                  prefHeight="220" styleClass="fxt-analysis-list"
                                                  VBox.vgrow="ALWAYS">
                                            <placeholder>
                                                <Label text="%StatisticsSection.all-named-types-are-used.text"
                                                       styleClass="fxt-analysis-empty"/>
                                            </placeholder>
                                        </ListView>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="12">
                            <children>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="unusedGroupsTitle" text="%StatisticsSection.unusedGroupsTitle.text"
                                               styleClass="fxt-analysis-group-title"/>
                                        <ListView fx:id="unusedGroups" id="analysis-unused-groups" minHeight="120"
                                                  prefHeight="160" maxWidth="Infinity"
                                                  styleClass="fxt-analysis-list">
                                            <placeholder>
                                                <Label text="%StatisticsSection.all-groups-and-attribute-groups.text"
                                                       styleClass="fxt-analysis-empty"/>
                                            </placeholder>
                                        </ListView>
                                    </children>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="cyclesTitle" text="%StatisticsSection.cyclesTitle.text"
                                               styleClass="fxt-analysis-group-title"/>
                                        <ListView fx:id="cycles" id="analysis-cycles" minHeight="120"
                                                  prefHeight="160" maxWidth="Infinity"
                                                  styleClass="fxt-analysis-list">
                                            <placeholder>
                                                <Label text="%StatisticsSection.no-circular-references.text"
                                                       styleClass="fxt-analysis-empty"/>
                                            </placeholder>
                                        </ListView>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</fx:root>
