<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Entry helpers of the XML grid (XMLSpy: Siblings / Children / Values): what the bound schema
  allows next to and below the selected node. Loaded by GridEntryHelpersPanel via the fx:root
  pattern; the lists, their cells and the enabled state of the buttons are filled in code.
-->
<fx:root type="javafx.scene.layout.VBox" id="grid-entry-helpers" styleClass="fxt-grid-entry-helpers"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="hintLabel" id="grid-entry-hint" styleClass="fxt-grid-entry-hint" wrapText="true"/>

        <HBox alignment="CENTER_LEFT" spacing="2" styleClass="fxt-grid-entry-section">
            <children>
                <Label text="%GridEntryHelpersPanel.siblings.text" styleClass="fxt-grid-entry-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="insertBeforeButton" id="grid-entry-insert-before" styleClass="fxt-tool-button"
                        focusTraversable="false" onAction="#onInsertBefore">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-bar-up" iconSize="13"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%GridEntryHelpersPanel.insert-before-the-selected-node.text"/>
                    </tooltip>
                </Button>
                <Button fx:id="insertAfterButton" id="grid-entry-insert-after" styleClass="fxt-tool-button"
                        focusTraversable="false" onAction="#onInsertAfter">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-bar-down" iconSize="13"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%GridEntryHelpersPanel.insert-after-the-selected-node.text"/>
                    </tooltip>
                </Button>
                <Button fx:id="appendButton" id="grid-entry-append" styleClass="fxt-tool-button"
                        focusTraversable="false" onAction="#onAppend">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-plus-square" iconSize="13"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%GridEntryHelpersPanel.append-as-the-last-sibling.text"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>
        <ListView fx:id="siblingsList" id="grid-entry-siblings" styleClass="fxt-grid-entry-list" VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER_LEFT" spacing="2" styleClass="fxt-grid-entry-section">
            <children>
                <Label text="%GridEntryHelpersPanel.children.text" styleClass="fxt-grid-entry-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addChildButton" id="grid-entry-add-child" styleClass="fxt-tool-button"
                        focusTraversable="false" onAction="#onAddChild">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-plus-lg" iconSize="13"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%GridEntryHelpersPanel.add-to-the-selected-element.text"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>
        <ListView fx:id="childrenList" id="grid-entry-children" styleClass="fxt-grid-entry-list" VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER_LEFT" styleClass="fxt-grid-entry-section">
            <children>
                <Label text="%GridEntryHelpersPanel.values.text" styleClass="fxt-grid-entry-title"/>
            </children>
        </HBox>
        <ListView fx:id="valuesList" id="grid-entry-values" styleClass="fxt-grid-entry-list" VBox.vgrow="SOMETIMES"/>
    </children>
</fx:root>
