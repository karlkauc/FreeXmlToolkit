<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Developer tool tab "Execution Statistics": header with the export/clear actions, the history
  table and the per-run detail report. Loaded by ExecutionStatsView via the fx:root pattern
  (FxmlViews.load); ExecutionStatsView is root and controller and binds the column values.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="10" styleClass="fxt-side-panel-content"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <children>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label text="%ExecutionStatsView.execution-statistics.text" styleClass="fxt-side-panel-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="%ExecutionStatsView.export-csv.text" styleClass="fxt-tool-button" onAction="#onExportCsv">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-download" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%ExecutionStatsView.export-the-history-as-csv.text"/>
                    </tooltip>
                </Button>
                <Button text="%ExecutionStatsView.export-json.text" styleClass="fxt-tool-button" onAction="#onExportJson">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-filetype-json" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%ExecutionStatsView.export-the-history-as-json.text"/>
                    </tooltip>
                </Button>
                <Button text="%ExecutionStatsView.clear.text" styleClass="fxt-tool-button" onAction="#onClear">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-trash" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%ExecutionStatsView.clear-the-recorded-history.text"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>

        <!-- Recording is opt-in (it reads JVM MXBeans on every run): say so while it is off. -->
        <HBox fx:id="recordingOffBar" id="execution-stats-recording-off" spacing="10" alignment="CENTER_LEFT"
              styleClass="fxt-hint-bar">
            <children>
                <IconifyIcon iconLiteral="bi-pause-circle" iconSize="16" styleClass="fxt-hint-bar-icon"/>
                <Label text="%ExecutionStatsView.recording-is-off-transforms-queries.text"
                       wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="fxt-hint-bar-text"
                       HBox.hgrow="ALWAYS"/>
                <Button id="execution-stats-enable" text="%ExecutionStatsView.execution-stats-enable.text" styleClass="fxt-primary-button"
                        onAction="#onEnableRecording">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-record-circle" iconSize="16"/>
                    </graphic>
                </Button>
            </children>
        </HBox>

        <Label text="%ExecutionStatsView.resource-usage-per-operation-memory.text"
               wrapText="true" styleClass="fxt-placeholder-text"/>

        <TableView fx:id="table" id="execution-stats-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="timeColumn" text="%ExecutionStatsView.timeColumn.text" prefWidth="70"/>
                <TableColumn fx:id="operationColumn" text="%ExecutionStatsView.operationColumn.text" prefWidth="90"/>
                <TableColumn fx:id="targetColumn" text="%ExecutionStatsView.targetColumn.text" prefWidth="200"/>
                <TableColumn fx:id="durationColumn" text="%ExecutionStatsView.durationColumn.text" prefWidth="80"/>
                <TableColumn fx:id="cpuColumn" text="%ExecutionStatsView.cpuColumn.text" prefWidth="80"/>
                <TableColumn fx:id="memoryColumn" text="%ExecutionStatsView.memoryColumn.text" prefWidth="90"/>
                <TableColumn fx:id="gcColumn" text="%ExecutionStatsView.gcColumn.text" prefWidth="80"/>
                <TableColumn fx:id="inColumn" text="%ExecutionStatsView.inColumn.text" prefWidth="70"/>
                <TableColumn fx:id="outColumn" text="%ExecutionStatsView.outColumn.text" prefWidth="70"/>
                <TableColumn fx:id="statusColumn" text="%ExecutionStatsView.statusColumn.text" prefWidth="60"/>
            </columns>
            <placeholder>
                <Label fx:id="emptyLabel" text="%ExecutionStatsView.emptyLabel.text"/>
            </placeholder>
        </TableView>

        <TextArea fx:id="detail" editable="false" wrapText="false" prefRowCount="9"
                  promptText="%ExecutionStatsView.detail.promptText" styleClass="fxt-query-results"/>
    </children>
</fx:root>
