<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  "Manage Favorites" tool tab: header (title, search, Clean up), the FOLDERS list with its
  actions on the left, the editable favorites table in the centre and DETAILS + NOTES of the
  selected favorite on the right. Loaded by FavoritesManagerView via the fx:root pattern
  (FxmlViews.load); FavoritesManagerView is root and controller. Built in code: the column
  cell/value factories, the row context menu and the detail values.
-->
<fx:root type="javafx.scene.layout.BorderPane" styleClass="fxt-favmgr"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <BorderPane styleClass="fxt-favmgr-card">
            <BorderPane.margin>
                <Insets topRightBottomLeft="24"/>
            </BorderPane.margin>
            <top>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="fxt-favmgr-header">
                    <children>
                        <VBox spacing="2">
                            <children>
                                <Label text="Manage Favorites" styleClass="fxt-favmgr-title">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-star" iconSize="18"/>
                                    </graphic>
                                </Label>
                                <Label text="Rename favorites, group them into folders, search."
                                       styleClass="fxt-favmgr-subtitle"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="search" id="favmgr-search" promptText="Search favorites…"/>
                        <Button id="favmgr-cleanup" text="Clean up" styleClass="fxt-tool-button"
                                onAction="#onCleanup">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-eraser" iconSize="14"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Remove favorites whose files no longer exist"/>
                            </tooltip>
                        </Button>
                    </children>
                </HBox>
            </top>
            <center>
                <BorderPane>
                    <padding>
                        <Insets top="16"/>
                    </padding>
                    <left>
                        <VBox spacing="8">
                            <padding>
                                <Insets right="16"/>
                            </padding>
                            <children>
                                <Label text="FOLDERS" styleClass="fxt-sp-section-label"/>
                                <ListView fx:id="folderList" id="favmgr-folders" prefWidth="200"
                                          VBox.vgrow="ALWAYS"/>
                                <HBox spacing="6">
                                    <children>
                                        <Button id="favmgr-folder-new" text="New…" styleClass="fxt-tool-button"
                                                onAction="#onNewFolder">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-folder-plus" iconSize="14"/>
                                            </graphic>
                                        </Button>
                                        <Button id="favmgr-folder-rename" text="Rename…"
                                                styleClass="fxt-tool-button" onAction="#onRenameFolder">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-pencil" iconSize="14"/>
                                            </graphic>
                                        </Button>
                                        <Button id="favmgr-folder-delete" text="Delete" styleClass="fxt-tool-button"
                                                onAction="#onDeleteFolder">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-x-circle" iconSize="14"/>
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </left>
                    <center>
                        <TableView fx:id="table" id="favmgr-table" editable="true">
                            <columns>
                                <TableColumn fx:id="nameColumn" text="Name" prefWidth="220"/>
                                <TableColumn fx:id="typeColumn" text="Type" prefWidth="110" editable="false"/>
                                <TableColumn fx:id="folderColumn" text="Folder" prefWidth="150"/>
                                <TableColumn fx:id="pathColumn" text="Path" editable="false"/>
                            </columns>
                            <placeholder>
                                <Label text="No favorites"/>
                            </placeholder>
                        </TableView>
                    </center>
                    <right>
                        <VBox spacing="6" prefWidth="280">
                            <padding>
                                <Insets left="16"/>
                            </padding>
                            <children>
                                <Label text="DETAILS" styleClass="fxt-sp-section-label"/>
                                <VBox spacing="1">
                                    <children>
                                        <Label text="Path" styleClass="fxt-sig-field-label"/>
                                        <Label fx:id="detailPath" text="–" wrapText="true"
                                               styleClass="fxt-favmgr-detail"/>
                                    </children>
                                </VBox>
                                <VBox spacing="1">
                                    <children>
                                        <Label text="Type" styleClass="fxt-sig-field-label"/>
                                        <Label fx:id="detailType" text="–" wrapText="true"
                                               styleClass="fxt-favmgr-detail"/>
                                    </children>
                                </VBox>
                                <VBox spacing="1">
                                    <children>
                                        <Label text="Added" styleClass="fxt-sig-field-label"/>
                                        <Label fx:id="detailAdded" text="–" wrapText="true"
                                               styleClass="fxt-favmgr-detail"/>
                                    </children>
                                </VBox>
                                <VBox spacing="1">
                                    <children>
                                        <Label text="Usage" styleClass="fxt-sig-field-label"/>
                                        <Label fx:id="detailUsage" text="–" wrapText="true"
                                               styleClass="fxt-favmgr-detail"/>
                                    </children>
                                </VBox>
                                <Label text="NOTES" styleClass="fxt-sp-section-label"/>
                                <TextArea fx:id="notesArea" id="favmgr-notes" promptText="Your notes for this favorite…"
                                          wrapText="true" prefRowCount="7" disable="true"/>
                            </children>
                        </VBox>
                    </right>
                </BorderPane>
            </center>
        </BorderPane>
    </center>
</fx:root>
