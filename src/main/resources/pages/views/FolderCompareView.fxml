<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Tools → Compare Folders: two folders, file by file. Loaded by FolderCompareView (fx:root), which fills the
  table and opens a file pair in the Compare view on double-click.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="8" styleClass="fxt-folder-compare"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="12"/>
    </padding>
    <children>
        <GridPane hgap="8" vgap="6">
            <children>
                <Label text="%FolderCompareView.left.text" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="leftPath" id="folder-compare-left" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       GridPane.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="%FolderCompareView.folder-compare-left-change.text" id="folder-compare-left-change" onAction="#onChangeLeft"
                        GridPane.rowIndex="0" GridPane.columnIndex="2">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
                    </graphic>
                </Button>
                <Label text="%FolderCompareView.right.text" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="rightPath" id="folder-compare-right" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       GridPane.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="%FolderCompareView.folder-compare-right-change.text" id="folder-compare-right-change" onAction="#onChangeRight"
                        GridPane.rowIndex="1" GridPane.columnIndex="2">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
                    </graphic>
                </Button>
            </children>
        </GridPane>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <children>
                <Button fx:id="compareButton" text="%FolderCompareView.compareButton.text" id="folder-compare-run" onAction="#onCompare"
                        styleClass="btn-primary">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-clockwise" iconSize="16"/>
                    </graphic>
                </Button>
                <CheckBox fx:id="compareXml" id="folder-compare-xml" text="%FolderCompareView.compareXml.text"
                          selected="true"/>
                <CheckBox fx:id="showIdentical" id="folder-compare-show-identical" text="%FolderCompareView.showIdentical.text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ProgressIndicator fx:id="progress" prefWidth="18" prefHeight="18" visible="false" managed="false"/>
                <Label fx:id="summary" id="folder-compare-summary"/>
            </children>
        </HBox>
        <TableView fx:id="table" id="folder-compare-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="pathColumn" text="%FolderCompareView.pathColumn.text" prefWidth="320"/>
                <TableColumn fx:id="statusColumn" text="%FolderCompareView.statusColumn.text" prefWidth="200"/>
                <TableColumn fx:id="leftSizeColumn" text="%FolderCompareView.leftSizeColumn.text" prefWidth="90"/>
                <TableColumn fx:id="rightSizeColumn" text="%FolderCompareView.rightSizeColumn.text" prefWidth="90"/>
                <TableColumn fx:id="leftModifiedColumn" text="%FolderCompareView.leftModifiedColumn.text" prefWidth="140"/>
                <TableColumn fx:id="rightModifiedColumn" text="%FolderCompareView.rightModifiedColumn.text" prefWidth="140"/>
                <TableColumn fx:id="noteColumn" text="%FolderCompareView.noteColumn.text" prefWidth="220"/>
            </columns>
            <placeholder>
                <Label text="%FolderCompareView.no-files-to-show.text"/>
            </placeholder>
        </TableView>
        <Label text="%FolderCompareView.double-click-a-file-to.text"
               opacity="0.7"/>
    </children>
</fx:root>
