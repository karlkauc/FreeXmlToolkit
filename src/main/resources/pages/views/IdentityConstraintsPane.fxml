<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  "Identity Constraints" tab of the Schema Overview: xs:key / xs:keyref / xs:unique of the
  selected element, edited in place (name, selector, fields, refer). Loaded by
  IdentityConstraintsPane (fx:root); cell factories are built in code.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="6" styleClass="fxt-overview-pane"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="6"/>
    </padding>
    <children>
        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="fxt-overview-toolbar">
            <children>
                <MenuButton fx:id="addButton" styleClass="fxt-tool-button" id="overview-constraint-add" text="%IdentityConstraintsPane.addButton.text">
                    <graphic>
                        <IconifyIcon fx:id="addIcon" iconLiteral="bi-plus-lg" iconSize="16"/>
                    </graphic>
                    <items>
                        <MenuItem fx:id="addKey" id="overview-constraint-add-key" text="%IdentityConstraintsPane.addKey.text" onAction="#onAddKey"/>
                        <MenuItem fx:id="addUnique" id="overview-constraint-add-unique" text="%IdentityConstraintsPane.addUnique.text"
                                  onAction="#onAddUnique"/>
                        <MenuItem fx:id="addKeyRef" id="overview-constraint-add-keyref" text="%IdentityConstraintsPane.addKeyRef.text"
                                  onAction="#onAddKeyRef"/>
                    </items>
                </MenuButton>
                <Button fx:id="deleteButton" styleClass="fxt-tool-button" id="overview-constraint-delete" onAction="#onDelete">
                    <graphic>
                        <IconifyIcon fx:id="deleteIcon" iconLiteral="bi-trash" iconSize="16"/>
                    </graphic>
                </Button>
                <Label text="%IdentityConstraintsPane.fields-separate-several-xpaths-with.text" styleClass="fxt-placeholder-text"/>
            </children>
        </HBox>
        <TableView fx:id="constraintTable" styleClass="fxt-analysis-table" id="overview-constraints" editable="true" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="kindColumn" text="%IdentityConstraintsPane.kindColumn.text" prefWidth="80" editable="false" sortable="false"/>
                <TableColumn fx:id="nameColumn" text="%IdentityConstraintsPane.nameColumn.text" prefWidth="150" sortable="false"/>
                <TableColumn fx:id="selectorColumn" text="%IdentityConstraintsPane.selectorColumn.text" prefWidth="200" sortable="false"/>
                <TableColumn fx:id="fieldsColumn" text="%IdentityConstraintsPane.fieldsColumn.text" prefWidth="200" sortable="false"/>
                <TableColumn fx:id="referColumn" text="%IdentityConstraintsPane.referColumn.text" prefWidth="150" sortable="false"/>
            </columns>
            <placeholder>
                <Label text="%IdentityConstraintsPane.no-identity-constraints.text" styleClass="fxt-placeholder-text"/>
            </placeholder>
        </TableView>
    </children>
</fx:root>
