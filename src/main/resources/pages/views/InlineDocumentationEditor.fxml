<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Inline tab-based editor for multi-language XSD documentation: a pill tab bar, a shared text
  area and a bottom bar (language + delete), or an empty state when there is no documentation.
  Loaded by InlineDocumentationEditor via the fx:root pattern (FxmlViews.load);
  InlineDocumentationEditor is root and controller. It shows either text area + bottom bar or
  the empty state (it swaps the children), and rebuilds the language pills from the model.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="6"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="8"/>
    </padding>
    <children>
        <!-- Tab bar: the add button, followed by one pill per documentation entry -->
        <HBox fx:id="tabBar" spacing="4" alignment="CENTER_LEFT" styleClass="doc-tab-bar">
            <children>
                <Button fx:id="addButton" styleClass="doc-tab-pill" onAction="#onAdd">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-plus-circle" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%InlineDocumentationEditor.add-documentation-entry.text"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>

        <TextArea fx:id="docTextArea" wrapText="true" prefRowCount="5" promptText="%InlineDocumentationEditor.docTextArea.promptText"
                  VBox.vgrow="ALWAYS"/>

        <HBox fx:id="bottomBar" spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label text="%InlineDocumentationEditor.lang.text"/>
                <ComboBox fx:id="langComboBox" editable="true" prefWidth="100">
                    <tooltip>
                        <Tooltip text="%InlineDocumentationEditor.select-or-type-a-language.text"/>
                    </tooltip>
                </ComboBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="deleteButton" text="%InlineDocumentationEditor.deleteButton.text" styleClass="btn-danger" onAction="#onDelete">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-trash" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%InlineDocumentationEditor.delete-this-documentation-entry.text"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>

        <VBox fx:id="emptyState" spacing="8" alignment="CENTER" styleClass="doc-empty-state" VBox.vgrow="ALWAYS">
            <padding>
                <Insets topRightBottomLeft="20"/>
            </padding>
            <children>
                <IconifyIcon iconLiteral="bi-journal-text" iconSize="48" iconColor="#adb5bd"/>
                <Label text="%InlineDocumentationEditor.no-documentation-click-to-add.text"
                       style="-fx-text-fill: #6c757d; -fx-font-style: italic;"/>
            </children>
        </VBox>
    </children>
</fx:root>
