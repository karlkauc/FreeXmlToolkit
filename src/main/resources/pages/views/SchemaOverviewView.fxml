<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  The XSD "Overview" view mode (XMLSpy-style schema overview): schema header (target namespace,
  form defaults), the toolbar and table of all top-level components, and below the tabs for the
  selected component. Loaded by SchemaOverviewView via the fx:root pattern (FxmlViews.load);
  SchemaOverviewView is root and controller. Built in code: the Insert/Append menus, the cell
  factories, drag and drop, the context menu and the tab contents.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-schema-overview"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-overview-header">
            <children>
                <Label text="%SchemaOverviewView.target-namespace.text" styleClass="fxt-overview-key"/>
                <TextField fx:id="targetNamespaceField" id="overview-target-namespace" promptText="%SchemaOverviewView.targetNamespaceField.promptText"
                           HBox.hgrow="ALWAYS" onAction="#onTargetNamespaceCommit"/>
                <Label text="%SchemaOverviewView.elementformdefault.text" styleClass="fxt-overview-key"/>
                <ComboBox fx:id="elementFormCombo" id="overview-element-form" prefWidth="140" styleClass="fxt-neutral-combo"
                          onAction="#onElementFormChanged"/>
                <Label text="%SchemaOverviewView.attributeformdefault.text" styleClass="fxt-overview-key"/>
                <ComboBox fx:id="attributeFormCombo" id="overview-attribute-form" prefWidth="140" styleClass="fxt-neutral-combo"
                          onAction="#onAttributeFormChanged"/>
            </children>
        </HBox>

        <SplitPane fx:id="splitPane" orientation="VERTICAL" dividerPositions="0.58" VBox.vgrow="ALWAYS">
            <items>
                <VBox styleClass="fxt-overview-components">
                    <children>
                        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="fxt-overview-toolbar">
                            <children>
                                <MenuButton fx:id="insertButton" styleClass="fxt-tool-button" id="overview-insert" text="%SchemaOverviewView.insertButton.text">
                                    <graphic>
                                        <IconifyIcon fx:id="insertIcon" iconLiteral="bi-plus-square" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%SchemaOverviewView.insert-a-new-component-in.text"/>
                                    </tooltip>
                                </MenuButton>
                                <MenuButton fx:id="appendButton" styleClass="fxt-tool-button" id="overview-append" text="%SchemaOverviewView.appendButton.text">
                                    <graphic>
                                        <IconifyIcon fx:id="appendIcon" iconLiteral="bi-plus-lg" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%SchemaOverviewView.append-a-new-component-at.text"/>
                                    </tooltip>
                                </MenuButton>
                                <MenuButton fx:id="directiveButton" styleClass="fxt-tool-button" id="overview-directive" text="%SchemaOverviewView.directiveButton.text">
                                    <graphic>
                                        <IconifyIcon fx:id="directiveIcon" iconLiteral="bi-box-arrow-in-down-right"
                                                     iconSize="16"/>
                                    </graphic>
                                </MenuButton>
                                <Button fx:id="moveUpButton" styleClass="fxt-tool-button" id="overview-move-up" onAction="#onMoveUp">
                                    <graphic>
                                        <IconifyIcon fx:id="moveUpIcon" iconLiteral="bi-arrow-up" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%SchemaOverviewView.move-up-ctrl-up.text"/>
                                    </tooltip>
                                </Button>
                                <Button fx:id="moveDownButton" styleClass="fxt-tool-button" id="overview-move-down" onAction="#onMoveDown">
                                    <graphic>
                                        <IconifyIcon fx:id="moveDownIcon" iconLiteral="bi-arrow-down" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%SchemaOverviewView.move-down-ctrl-down.text"/>
                                    </tooltip>
                                </Button>
                                <MenuButton fx:id="sortButton" styleClass="fxt-tool-button" id="overview-sort" text="%SchemaOverviewView.sortButton.text">
                                    <graphic>
                                        <IconifyIcon fx:id="sortIcon" iconLiteral="bi-sort-alpha-down" iconSize="16"/>
                                    </graphic>
                                    <items>
                                        <MenuItem fx:id="sortTypeThenName" id="overview-sort-type-name"
                                                  text="%SchemaOverviewView.sortTypeThenName.text" onAction="#onSortTypeThenName"/>
                                        <MenuItem fx:id="sortNameThenType" id="overview-sort-name-type"
                                                  text="%SchemaOverviewView.sortNameThenType.text" onAction="#onSortNameThenType"/>
                                    </items>
                                </MenuButton>
                                <Button fx:id="deleteButton" styleClass="fxt-tool-button" id="overview-delete" onAction="#onDelete">
                                    <graphic>
                                        <IconifyIcon fx:id="deleteIcon" iconLiteral="bi-trash" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%SchemaOverviewView.delete-the-selected-components-del.text"/>
                                    </tooltip>
                                </Button>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ToggleButton fx:id="showIncludedToggle" styleClass="fxt-tool-button" id="overview-show-included"
                                              text="%SchemaOverviewView.showIncludedToggle.text" onAction="#onShowIncludedChanged">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-file-earmark-plus" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%SchemaOverviewView.also-list-the-components-of.text"/>
                                    </tooltip>
                                </ToggleButton>
                                <TextField fx:id="filterField" id="overview-filter" promptText="%SchemaOverviewView.filterField.promptText"
                                           prefColumnCount="16"/>
                            </children>
                        </HBox>
                        <TableView fx:id="componentTable" id="overview-components" editable="true"
                                   styleClass="fxt-analysis-table, fxt-overview-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="kindColumn" text="%SchemaOverviewView.kindColumn.text" prefWidth="150" editable="false"
                                             sortable="false"/>
                                <TableColumn fx:id="nameColumn" text="%SchemaOverviewView.nameColumn.text" prefWidth="220" sortable="false"/>
                                <TableColumn fx:id="detailsColumn" text="%SchemaOverviewView.detailsColumn.text" prefWidth="240" editable="false"
                                             sortable="false"/>
                                <TableColumn fx:id="annotationColumn" text="%SchemaOverviewView.annotationColumn.text" prefWidth="320"
                                             sortable="false"/>
                            </columns>
                            <placeholder>
                                <Label text="%SchemaOverviewView.the-schema-has-no-components.text"
                                       contentDisplay="TOP" graphicTextGap="8" styleClass="fxt-placeholder-text">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-table" iconSize="48"/>
                                    </graphic>
                                </Label>
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>
                <TabPane fx:id="detailTabs" id="overview-detail-tabs" tabClosingPolicy="UNAVAILABLE"
                         styleClass="fxt-overview-tabs">
                    <tabs>
                        <Tab fx:id="detailsTab" id="overview-tab-details" text="%SchemaOverviewView.detailsTab.text"/>
                        <Tab fx:id="attributesTab" id="overview-tab-attributes" text="%SchemaOverviewView.attributesTab.text"/>
                        <Tab fx:id="constraintsTab" id="overview-tab-constraints" text="%SchemaOverviewView.constraintsTab.text"/>
                        <Tab fx:id="assertionsTab" id="overview-tab-assertions" text="%SchemaOverviewView.assertionsTab.text"/>
                        <Tab fx:id="namespacesTab" id="overview-tab-namespaces" text="%SchemaOverviewView.namespacesTab.text"/>
                    </tabs>
                </TabPane>
            </items>
        </SplitPane>
    </children>
</fx:root>
