<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  The XSD "Overview" view mode (XMLSpy-style schema overview): schema header (target namespace,
  form defaults), the toolbar and table of all top-level components, and below the tabs for the
  selected component. Loaded by SchemaOverviewView via the fx:root pattern (FxmlViews.load);
  SchemaOverviewView is root and controller. Built in code: the Insert/Append menus, the cell
  factories, drag and drop, the context menu and the tab contents.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-schema-overview"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-overview-header">
            <children>
                <Label text="Target namespace" styleClass="fxt-overview-key"/>
                <TextField fx:id="targetNamespaceField" id="overview-target-namespace" promptText="(no namespace)"
                           HBox.hgrow="ALWAYS" onAction="#onTargetNamespaceCommit"/>
                <Label text="elementFormDefault" styleClass="fxt-overview-key"/>
                <ComboBox fx:id="elementFormCombo" id="overview-element-form" prefWidth="140" styleClass="fxt-neutral-combo"
                          onAction="#onElementFormChanged"/>
                <Label text="attributeFormDefault" styleClass="fxt-overview-key"/>
                <ComboBox fx:id="attributeFormCombo" id="overview-attribute-form" prefWidth="140" styleClass="fxt-neutral-combo"
                          onAction="#onAttributeFormChanged"/>
            </children>
        </HBox>

        <SplitPane fx:id="splitPane" orientation="VERTICAL" dividerPositions="0.58" VBox.vgrow="ALWAYS">
            <items>
                <VBox styleClass="fxt-overview-components">
                    <children>
                        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="fxt-overview-toolbar">
                            <children>
                                <MenuButton fx:id="insertButton" styleClass="fxt-tool-button" id="overview-insert" text="Insert">
                                    <graphic>
                                        <IconifyIcon fx:id="insertIcon" iconLiteral="bi-plus-square" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Insert a new component in front of the selected row"/>
                                    </tooltip>
                                </MenuButton>
                                <MenuButton fx:id="appendButton" styleClass="fxt-tool-button" id="overview-append" text="Append">
                                    <graphic>
                                        <IconifyIcon fx:id="appendIcon" iconLiteral="bi-plus-lg" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Append a new component at the end of the schema"/>
                                    </tooltip>
                                </MenuButton>
                                <MenuButton fx:id="directiveButton" styleClass="fxt-tool-button" id="overview-directive" text="Import / Include">
                                    <graphic>
                                        <IconifyIcon fx:id="directiveIcon" iconLiteral="bi-box-arrow-in-down-right"
                                                     iconSize="16"/>
                                    </graphic>
                                </MenuButton>
                                <Button fx:id="moveUpButton" styleClass="fxt-tool-button" id="overview-move-up" onAction="#onMoveUp">
                                    <graphic>
                                        <IconifyIcon fx:id="moveUpIcon" iconLiteral="bi-arrow-up" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Move up (Ctrl+Up)"/>
                                    </tooltip>
                                </Button>
                                <Button fx:id="moveDownButton" styleClass="fxt-tool-button" id="overview-move-down" onAction="#onMoveDown">
                                    <graphic>
                                        <IconifyIcon fx:id="moveDownIcon" iconLiteral="bi-arrow-down" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Move down (Ctrl+Down)"/>
                                    </tooltip>
                                </Button>
                                <MenuButton fx:id="sortButton" styleClass="fxt-tool-button" id="overview-sort" text="Sort">
                                    <graphic>
                                        <IconifyIcon fx:id="sortIcon" iconLiteral="bi-sort-alpha-down" iconSize="16"/>
                                    </graphic>
                                    <items>
                                        <MenuItem fx:id="sortTypeThenName" id="overview-sort-type-name"
                                                  text="Type, then Name" onAction="#onSortTypeThenName"/>
                                        <MenuItem fx:id="sortNameThenType" id="overview-sort-name-type"
                                                  text="Name, then Type" onAction="#onSortNameThenType"/>
                                    </items>
                                </MenuButton>
                                <Button fx:id="deleteButton" styleClass="fxt-tool-button" id="overview-delete" onAction="#onDelete">
                                    <graphic>
                                        <IconifyIcon fx:id="deleteIcon" iconLiteral="bi-trash" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Delete the selected components (Del)"/>
                                    </tooltip>
                                </Button>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ToggleButton fx:id="showIncludedToggle" styleClass="fxt-tool-button" id="overview-show-included"
                                              text="Included" onAction="#onShowIncludedChanged">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-file-earmark-plus" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Also list the components of included files (read-only)"/>
                                    </tooltip>
                                </ToggleButton>
                                <TextField fx:id="filterField" id="overview-filter" promptText="Filter components"
                                           prefColumnCount="16"/>
                            </children>
                        </HBox>
                        <TableView fx:id="componentTable" id="overview-components" editable="true"
                                   styleClass="fxt-analysis-table, fxt-overview-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="kindColumn" text="Kind" prefWidth="150" editable="false"
                                             sortable="false"/>
                                <TableColumn fx:id="nameColumn" text="Name" prefWidth="220" sortable="false"/>
                                <TableColumn fx:id="detailsColumn" text="Details" prefWidth="240" editable="false"
                                             sortable="false"/>
                                <TableColumn fx:id="annotationColumn" text="Annotation" prefWidth="320"
                                             sortable="false"/>
                            </columns>
                            <placeholder>
                                <Label text="The schema has no components yet. Use Insert or Append to add one."
                                       contentDisplay="TOP" graphicTextGap="8" styleClass="fxt-placeholder-text">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-table" iconSize="48"/>
                                    </graphic>
                                </Label>
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>
                <TabPane fx:id="detailTabs" id="overview-detail-tabs" tabClosingPolicy="UNAVAILABLE"
                         styleClass="fxt-overview-tabs">
                    <tabs>
                        <Tab fx:id="detailsTab" id="overview-tab-details" text="Details"/>
                        <Tab fx:id="attributesTab" id="overview-tab-attributes" text="Attributes"/>
                        <Tab fx:id="constraintsTab" id="overview-tab-constraints" text="Identity Constraints"/>
                        <Tab fx:id="assertionsTab" id="overview-tab-assertions" text="Assertions"/>
                        <Tab fx:id="namespacesTab" id="overview-tab-namespaces" text="Namespaces"/>
                    </tabs>
                </TabPane>
            </items>
        </SplitPane>
    </children>
</fx:root>
