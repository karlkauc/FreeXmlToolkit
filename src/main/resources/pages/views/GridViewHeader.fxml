<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Header bar of the shell's Grid views (XML and JSON): table icon · "Grid view" · subtitle ·…·
  zoom pill [ − 100% + ] · Optimal widths · Word wrap · Expand all · Collapse all · ⋯ (cell
  height limit). Loaded by GridViewHeader via the fx:root pattern (FxmlViews.load);
  GridViewHeader is root and controller and forwards the actions to the grid canvas. The
  subtitle, the zoom percentage and the toggle states are set in code.
-->
<fx:root type="javafx.scene.layout.HBox" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-grid-header"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="cellLinesGroup"/>
        <ToggleGroup fx:id="siblingGroupGroup"/>
        <ToggleGroup fx:id="splitGroup"/>
    </fx:define>
    <children>
        <Label text="Grid view" styleClass="fxt-grid-title" minWidth="-Infinity">
            <graphic>
                <IconifyIcon iconLiteral="bi-table" iconSize="15"/>
            </graphic>
        </Label>
        <Label fx:id="subtitle" styleClass="fxt-grid-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>

        <!-- Zoom pill; clicking the percentage resets to 100 % -->
        <HBox alignment="CENTER" styleClass="fxt-graph-zoom-pill, fxt-grid-zoom-pill" minWidth="-Infinity">
            <children>
                <Button id="grid-zoom-out" text="−" focusTraversable="false" styleClass="fxt-graph-zoom-button"
                        onAction="#onZoomOut">
                    <tooltip>
                        <Tooltip text="Zoom out (Ctrl −)"/>
                    </tooltip>
                </Button>
                <Label fx:id="zoomLabel" id="grid-zoom-label" styleClass="fxt-graph-zoom-label" minWidth="-Infinity"
                       onMouseClicked="#onZoomReset">
                    <tooltip>
                        <Tooltip text="Reset zoom to 100% (Ctrl 0)"/>
                    </tooltip>
                </Label>
                <Button id="grid-zoom-in" text="+" focusTraversable="false" styleClass="fxt-graph-zoom-button"
                        onAction="#onZoomIn">
                    <tooltip>
                        <Tooltip text="Zoom in (Ctrl +)"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>

        <Button id="grid-optimal-widths" minWidth="-Infinity" text="Optimal widths" styleClass="fxt-tool-button" focusTraversable="false"
                onAction="#onOptimalWidths">
            <graphic>
                <IconifyIcon iconLiteral="bi-arrows-angle-expand" iconSize="13"/>
            </graphic>
            <tooltip>
                <Tooltip text="Size every name column and table column to its content"/>
            </tooltip>
        </Button>
        <ToggleButton fx:id="wordWrapButton" id="grid-word-wrap" minWidth="-Infinity" text="Wrap" styleClass="fxt-tool-button"
                      focusTraversable="false" onAction="#onWordWrap">
            <graphic>
                <IconifyIcon iconLiteral="bi-text-wrap" iconSize="13"/>
            </graphic>
            <tooltip>
                <Tooltip text="Word wrap: long values wrap onto further lines"/>
            </tooltip>
        </ToggleButton>
        <Button id="grid-expand-all" minWidth="-Infinity" text="Expand all" styleClass="fxt-tool-button" onAction="#onExpandAll">
            <graphic>
                <IconifyIcon iconLiteral="bi-arrows-expand" iconSize="13"/>
            </graphic>
        </Button>
        <Button id="grid-collapse-all" minWidth="-Infinity" text="Collapse all" styleClass="fxt-tool-button" onAction="#onCollapseAll">
            <graphic>
                <IconifyIcon iconLiteral="bi-arrows-collapse" iconSize="13"/>
            </graphic>
        </Button>
        <ToggleButton fx:id="sidePanelButton" id="grid-entry-helpers-toggle" minWidth="-Infinity" styleClass="fxt-tool-button"
                      focusTraversable="false" visible="false" managed="false" onAction="#onSidePanel">
            <graphic>
                <IconifyIcon iconLiteral="bi-layout-sidebar-reverse" iconSize="13"/>
            </graphic>
            <tooltip>
                <Tooltip text="Entry helpers: elements, attributes and values the schema allows here"/>
            </tooltip>
        </ToggleButton>
        <MenuButton id="grid-more" minWidth="-Infinity" styleClass="fxt-tool-button" focusTraversable="false">
            <graphic>
                <IconifyIcon iconLiteral="bi-three-dots" iconSize="13"/>
            </graphic>
            <tooltip>
                <Tooltip text="Grid settings"/>
            </tooltip>
            <items>
                <RadioMenuItem fx:id="cellLinesOff" id="grid-cell-lines-off" text="Cell height: unlimited"
                               toggleGroup="$cellLinesGroup" onAction="#onCellLinesOff"/>
                <RadioMenuItem fx:id="cellLines3" id="grid-cell-lines-3" text="Cell height: 3 lines"
                               toggleGroup="$cellLinesGroup" onAction="#onCellLines3"/>
                <RadioMenuItem fx:id="cellLines6" id="grid-cell-lines-6" text="Cell height: 6 lines"
                               toggleGroup="$cellLinesGroup" onAction="#onCellLines6"/>
                <RadioMenuItem fx:id="cellLines12" id="grid-cell-lines-12" text="Cell height: 12 lines"
                               toggleGroup="$cellLinesGroup" onAction="#onCellLines12"/>
                <SeparatorMenuItem/>
                <RadioMenuItem fx:id="siblingGroupsOff" id="grid-sibling-groups-off" text="Sibling groups: unlimited"
                               toggleGroup="$siblingGroupGroup" onAction="#onSiblingGroupsOff"/>
                <RadioMenuItem fx:id="siblingGroups100" id="grid-sibling-groups-100" text="Sibling groups: 100 nodes"
                               toggleGroup="$siblingGroupGroup" onAction="#onSiblingGroups100"/>
                <RadioMenuItem fx:id="siblingGroups1000" id="grid-sibling-groups-1000" text="Sibling groups: 1,000 nodes"
                               toggleGroup="$siblingGroupGroup" onAction="#onSiblingGroups1000"/>
                <RadioMenuItem fx:id="siblingGroups10000" id="grid-sibling-groups-10000" text="Sibling groups: 10,000 nodes"
                               toggleGroup="$siblingGroupGroup" onAction="#onSiblingGroups10000"/>
                <SeparatorMenuItem/>
                <RadioMenuItem fx:id="splitOff" id="grid-split-off" text="Single view"
                               toggleGroup="$splitGroup" onAction="#onSplitOff"/>
                <RadioMenuItem fx:id="splitTopBottom" id="grid-split-top-bottom" text="Split: top / bottom"
                               toggleGroup="$splitGroup" onAction="#onSplitTopBottom"/>
                <RadioMenuItem fx:id="splitSideBySide" id="grid-split-side-by-side" text="Split: side by side"
                               toggleGroup="$splitGroup" onAction="#onSplitSideBySide"/>
            </items>
        </MenuButton>
    </children>
</fx:root>
