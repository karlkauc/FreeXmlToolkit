<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  "Attributes" tab of the Schema Overview: the attributes, attribute group references and the
  attribute wildcard of the selected element / complex type / attribute group, edited in place
  (Name, Type, Use, Default, Fixed). Loaded by AttributesPane (fx:root); cell factories and the
  attribute group menu are built in code.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="6" styleClass="fxt-overview-pane"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="6"/>
    </padding>
    <children>
        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="fxt-overview-toolbar">
            <children>
                <Button fx:id="addButton" styleClass="fxt-tool-button" id="overview-attribute-add" text="Add Attribute" onAction="#onAdd">
                    <graphic>
                        <IconifyIcon fx:id="addIcon" iconLiteral="bi-plus-lg" iconSize="16"/>
                    </graphic>
                </Button>
                <MenuButton fx:id="groupRefButton" styleClass="fxt-tool-button" id="overview-attribute-group-ref" text="Add Group Reference">
                    <graphic>
                        <IconifyIcon fx:id="groupRefIcon" iconLiteral="bi-link-45deg" iconSize="16"/>
                    </graphic>
                </MenuButton>
                <Button fx:id="deleteButton" styleClass="fxt-tool-button" id="overview-attribute-delete" onAction="#onDelete">
                    <graphic>
                        <IconifyIcon fx:id="deleteIcon" iconLiteral="bi-trash" iconSize="16"/>
                    </graphic>
                </Button>
                <Label fx:id="hintLabel" id="overview-attribute-hint" styleClass="fxt-placeholder-text" wrapText="true"/>
            </children>
        </HBox>
        <TableView fx:id="attributeTable" styleClass="fxt-analysis-table" id="overview-attributes" editable="true" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="170" sortable="false"/>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="170" sortable="false"/>
                <TableColumn fx:id="useColumn" text="Use" prefWidth="100" sortable="false"/>
                <TableColumn fx:id="defaultColumn" text="Default" prefWidth="140" sortable="false"/>
                <TableColumn fx:id="fixedColumn" text="Fixed" prefWidth="140" sortable="false"/>
            </columns>
            <placeholder>
                <Label text="No attributes." styleClass="fxt-placeholder-text"/>
            </placeholder>
        </TableView>
    </children>
</fx:root>
