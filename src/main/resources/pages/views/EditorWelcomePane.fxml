<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Polyline?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.WelcomeQuickCard?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.WelcomeStatCard?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.WelcomeToolCard?>

<!--
  Welcome / Dashboard landing shown when no document is open (Figma "Redesign · Unified —
  Welcome / Dashboard"): hero, quick-action cards, FundsXML quick access, counters, activity
  trend, tips, sponsor banner, recent files and the task list. On a first start (no data yet) the
  counters and the trend stay hidden and an "Open an Example" card is offered instead (UX plan 5.1).
  Loaded by EditorWelcomePane via the fx:root pattern (FxmlViews.load); EditorWelcomePane is root
  and controller. Data-driven parts stay in code: the version badge text, the sparkline points
  and category cards of the trend, the sponsor heart and the recent-files cells.
  Cards and task rows report their userData key through #onCardAction.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-editor-empty-state"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="fxt-welcome-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="24" styleClass="fxt-welcome-content">
                    <padding>
                        <Insets topRightBottomLeft="40"/>
                    </padding>
                    <children>
                        <!-- Hero -->
                        <HBox spacing="18" alignment="CENTER_LEFT">
                            <children>
                                <StackPane styleClass="fxt-welcome-hero-icon">
                                    <children>
                                        <IconifyIcon iconLiteral="bi-code-slash" iconSize="28"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="6" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%EditorWelcomePane.welcome-to-freexmltoolkit.text" styleClass="fxt-welcome-hero-title"/>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="%EditorWelcomePane.the-modern-xml-xsd-xslt.text"
                                                       styleClass="fxt-welcome-hero-subtitle"/>
                                                <Label fx:id="versionBadge" styleClass="fxt-welcome-version-badge">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-check-circle-fill" iconSize="12"/>
                                                    </graphic>
                                                </Label>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Quick actions -->
                        <HBox spacing="16">
                            <children>
                                <WelcomeQuickCard id="welcome-new" iconLiteral="bi-file-earmark-plus" title="%EditorWelcomePane.welcome-new.title"
                                                  subtitle="%EditorWelcomePane.welcome-new.subtitle" primary="true" HBox.hgrow="ALWAYS"
                                                  onAction="#onNew"/>
                                <WelcomeQuickCard id="welcome-open" iconLiteral="bi-folder2-open" title="%EditorWelcomePane.welcome-open.title"
                                                  subtitle="%EditorWelcomePane.welcome-open.subtitle" HBox.hgrow="ALWAYS" onAction="#onOpen"/>
                                <WelcomeQuickCard id="welcome-openfolder" iconLiteral="bi-folder" title="%EditorWelcomePane.welcome-openfolder.title"
                                                  subtitle="%EditorWelcomePane.welcome-openfolder.subtitle" userData="open-folder"
                                                  HBox.hgrow="ALWAYS" onAction="#onCardAction"/>
                                <WelcomeQuickCard id="welcome-url" iconLiteral="bi-box-arrow-up-right" title="%EditorWelcomePane.welcome-url.title"
                                                  subtitle="%EditorWelcomePane.welcome-url.subtitle" userData="from-url" HBox.hgrow="ALWAYS"
                                                  onAction="#onCardAction"/>
                                <!-- First start only (no recent files yet): a small XML + XSD + XSLT to try -->
                                <WelcomeQuickCard fx:id="exampleCard" id="welcome-example"
                                                  iconLiteral="bi-file-earmark-play" title="%EditorWelcomePane.exampleCard.title"
                                                  subtitle="%EditorWelcomePane.exampleCard.subtitle" userData="open-example"
                                                  HBox.hgrow="ALWAYS" onAction="#onCardAction"/>
                            </children>
                        </HBox>

                        <!-- Recent projects: hidden until a project was opened once -->
                        <VBox fx:id="projectsSection" id="welcome-projects" spacing="12" visible="false" managed="false">
                            <children>
                                <Label text="%EditorWelcomePane.projects.text" styleClass="fxt-welcome-section-title"/>
                                <HBox fx:id="projectCards" spacing="16"/>
                            </children>
                        </VBox>

                        <!-- FundsXML quick access: hidden until the extension is active and content is cached -->
                        <VBox fx:id="fundsXmlSection" spacing="12" visible="false" managed="false">
                            <children>
                                <Label text="%EditorWelcomePane.fundsxml.text" styleClass="fxt-welcome-section-title"/>
                                <HBox spacing="16">
                                    <children>
                                        <WelcomeQuickCard id="welcome-fundsxml-example"
                                                          iconLiteral="bi-file-earmark-play" title="%EditorWelcomePane.welcome-fundsxml-example.title"
                                                          subtitle="%EditorWelcomePane.welcome-fundsxml-example.subtitle"
                                                          userData="fundsxml-open-example" HBox.hgrow="ALWAYS"
                                                          onAction="#onCardAction"/>
                                        <WelcomeQuickCard id="welcome-fundsxml-schema"
                                                          iconLiteral="bi-file-earmark-code" title="%EditorWelcomePane.welcome-fundsxml-schema.title"
                                                          subtitle="%EditorWelcomePane.welcome-fundsxml-schema.subtitle"
                                                          userData="fundsxml-open-schema" HBox.hgrow="ALWAYS"
                                                          onAction="#onCardAction"/>
                                        <WelcomeQuickCard id="welcome-fundsxml-browse" iconLiteral="bi-folder2-open"
                                                          title="%EditorWelcomePane.welcome-fundsxml-browse.title" subtitle="%EditorWelcomePane.welcome-fundsxml-browse.subtitle"
                                                          userData="fundsxml-browse-examples" HBox.hgrow="ALWAYS"
                                                          onAction="#onCardAction"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Counters: shown once at least one of them is above zero (UX plan 5.1) -->
                        <HBox fx:id="statsRow" spacing="16">
                            <children>
                                <WelcomeStatCard fx:id="recentStat" numberId="welcome-stat-recent"
                                                 iconLiteral="bi-clock-history" caption="%EditorWelcomePane.recentStat.caption"
                                                 HBox.hgrow="ALWAYS"/>
                                <WelcomeStatCard fx:id="favoritesStat" numberId="welcome-stat-favorites"
                                                 iconLiteral="bi-star" caption="%EditorWelcomePane.favoritesStat.caption" HBox.hgrow="ALWAYS"/>
                                <WelcomeStatCard fx:id="templatesStat" numberId="welcome-stat-templates"
                                                 iconLiteral="bi-collection" caption="%EditorWelcomePane.templatesStat.caption" HBox.hgrow="ALWAYS"/>
                                <WelcomeStatCard fx:id="queriesStat" numberId="welcome-stat-queries"
                                                 iconLiteral="bi-braces" caption="%EditorWelcomePane.queriesStat.caption" HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>

                        <!-- Activity trend: sparkline + one colour-coded card per feature category;
                             shown only when the last 7 days recorded any activity (UX plan 5.1) -->
                        <VBox fx:id="trendBox" spacing="8" styleClass="fxt-welcome-trend">
                            <children>
                                <Label text="%EditorWelcomePane.activity-last-7-days.text" styleClass="fxt-side-panel-title"/>
                                <Pane minWidth="220" minHeight="40" prefWidth="220" prefHeight="40" maxWidth="220"
                                      maxHeight="40">
                                    <children>
                                        <Polyline fx:id="sparkline" styleClass="fxt-welcome-sparkline"/>
                                    </children>
                                </Pane>
                                <HBox fx:id="trendRow" spacing="12" styleClass="fxt-welcome-trend-row"/>
                            </children>
                        </VBox>

                        <!-- Tips -->
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="fxt-welcome-tips">
                            <children>
                                <IconifyIcon iconLiteral="bi-lightbulb" iconSize="16"/>
                                <Label text="%EditorWelcomePane.tip-drag-a-file-onto.text"
                                       wrapText="true"/>
                            </children>
                        </HBox>

                        <!-- Sponsor banner; EditorWelcomePane prepends the sponsor heart -->
                        <HBox fx:id="sponsorBanner" spacing="10" alignment="CENTER_LEFT"
                              styleClass="fxt-welcome-sponsor">
                            <children>
                                <Label text="%EditorWelcomePane.freexmltoolkit-is-free-and-open.text"
                                       wrapText="true"/>
                                <Hyperlink id="welcome-sponsor" text="%EditorWelcomePane.welcome-sponsor.text" onAction="#onSponsor"/>
                            </children>
                        </HBox>

                        <!-- Recent files + Tools -->
                        <HBox spacing="24" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="12" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="%EditorWelcomePane.recent-files.text" styleClass="fxt-welcome-section-title"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Hyperlink id="welcome-clear" text="%EditorWelcomePane.welcome-clear.text"
                                                           styleClass="fxt-welcome-clear" onAction="#onClearRecent"/>
                                            </children>
                                        </HBox>
                                        <ListView fx:id="recentList" styleClass="fxt-welcome-recent"
                                                  VBox.vgrow="ALWAYS">
                                            <placeholder>
                                                <Label text="%EditorWelcomePane.no-recent-files-yet-files.text"
                                                       wrapText="true" styleClass="fxt-placeholder-text"/>
                                            </placeholder>
                                        </ListView>
                                    </children>
                                </VBox>

                                <!-- Tasks (UX plan 5.2): each row leads into its workflow - pick a file where one
                                     is needed, then the matching panel opens. Replaces the Tools grid, which only
                                     repeated the Activity Bar. -->
                                <VBox spacing="12" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="%EditorWelcomePane.what-do-you-want-to.text" styleClass="fxt-welcome-section-title"/>
                                        <VBox fx:id="taskList" id="welcome-tasks" spacing="8">
                                            <children>
                                                <WelcomeToolCard id="task-validate" activity="validation"
                                                                 iconLiteral="bi-check2-circle" title="%EditorWelcomePane.task-validate.title"
                                                                 subtitle="%EditorWelcomePane.task-validate.subtitle" userData="task-validate"
                                                                 onAction="#onCardAction"/>
                                                <WelcomeToolCard id="task-transform" activity="transform"
                                                                 iconLiteral="bi-arrow-left-right" title="%EditorWelcomePane.task-transform.title"
                                                                 subtitle="%EditorWelcomePane.task-transform.subtitle" userData="task-transform"
                                                                 onAction="#onCardAction"/>
                                                <WelcomeToolCard id="task-query" activity="search"
                                                                 iconLiteral="bi-terminal" title="%EditorWelcomePane.task-query.title"
                                                                 subtitle="%EditorWelcomePane.task-query.subtitle" userData="task-query"
                                                                 onAction="#onCardAction"/>
                                                <WelcomeToolCard id="task-schema" activity="schema"
                                                                 iconLiteral="bi-diagram-3" title="%EditorWelcomePane.task-schema.title"
                                                                 subtitle="%EditorWelcomePane.task-schema.subtitle" userData="task-schema"
                                                                 onAction="#onCardAction"/>
                                                <WelcomeToolCard id="task-pdf" activity="pdf"
                                                                 iconLiteral="bi-file-earmark-pdf" title="%EditorWelcomePane.task-pdf.title"
                                                                 subtitle="%EditorWelcomePane.task-pdf.subtitle" userData="task-pdf"
                                                                 onAction="#onCardAction"/>
                                                <WelcomeToolCard id="task-sign" activity="signature"
                                                                 iconLiteral="bi-shield-lock" title="%EditorWelcomePane.task-sign.title"
                                                                 subtitle="%EditorWelcomePane.task-sign.subtitle" userData="task-sign"
                                                                 onAction="#onCardAction"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</fx:root>
