<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Tools → Merge Files: the merged text of base, left and right with its conflicts. Loaded by MergeView (fx:root),
  which puts the editor into editorSlot and resolves conflicts.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-merge-view"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox spacing="6" alignment="CENTER_LEFT" styleClass="xsd-toolbar">
            <padding>
                <Insets top="4" right="8" bottom="4" left="8"/>
            </padding>
            <children>
                <Button text="%MergeView.merge-prev.text" id="merge-prev" onAction="#onPrevious" styleClass="toolbar-button">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-up" iconSize="18"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%MergeView.previous-conflict.text"/>
                    </tooltip>
                </Button>
                <Button text="%MergeView.merge-next.text" id="merge-next" onAction="#onNext" styleClass="toolbar-button">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-down" iconSize="18"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%MergeView.next-conflict.text"/>
                    </tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="useLeft" text="%MergeView.useLeft.text" id="merge-use-left" onAction="#onUseLeft"
                        styleClass="toolbar-button">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-bar-left" iconSize="18"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%MergeView.resolve-the-current-conflict-with.text"/>
                    </tooltip>
                </Button>
                <Button fx:id="useRight" text="%MergeView.useRight.text" id="merge-use-right" onAction="#onUseRight"
                        styleClass="toolbar-button">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-bar-right" iconSize="18"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%MergeView.resolve-the-current-conflict-with.text-2"/>
                    </tooltip>
                </Button>
                <Button fx:id="useBoth" text="%MergeView.useBoth.text" id="merge-use-both" onAction="#onUseBoth"
                        styleClass="toolbar-button">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-layout-split" iconSize="18"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%MergeView.resolve-the-current-conflict-with.text-3"/>
                    </tooltip>
                </Button>
                <Button fx:id="useBase" text="%MergeView.useBase.text" id="merge-use-base" onAction="#onUseBase"
                        styleClass="toolbar-button">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-counterclockwise" iconSize="18"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%MergeView.resolve-the-current-conflict-with.text-4"/>
                    </tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <Button text="%MergeView.merge-save.text" id="merge-save" onAction="#onSave" styleClass="toolbar-button">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-floppy" iconSize="18"/>
                    </graphic>
                </Button>
                <Button text="%MergeView.merge-save-as.text" id="merge-save-as" onAction="#onSaveAs" styleClass="toolbar-button">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-file-earmark-arrow-down" iconSize="18"/>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="status" id="merge-status"/>
            </children>
        </HBox>
        <Label fx:id="sources" id="merge-sources" styleClass="diff-xml-summary" wrapText="true"/>
        <StackPane fx:id="editorSlot" VBox.vgrow="ALWAYS"/>
    </children>
</fx:root>
