<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  One-time hint above the editor when a FundsXML document is opened while the FundsXML extension
  is off (UX plan 5.5). Loaded by FundsXmlHintBar via the fx:root pattern (FxmlViews.load).
-->
<fx:root type="javafx.scene.layout.HBox" id="fundsxml-hint" spacing="10" alignment="CENTER_LEFT"
         styleClass="fxt-hint-bar, fxt-wf-fundsxml" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <IconifyIcon iconLiteral="bi-lightbulb" iconSize="16" styleClass="fxt-hint-bar-icon"/>
        <Label text="This looks like a FundsXML document. The FundsXML extension adds its schemas, examples and quality checks."
               wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="fxt-hint-bar-text"
               HBox.hgrow="ALWAYS"/>
        <Button id="fundsxml-hint-enable" text="Enable FundsXML extensions" styleClass="fxt-primary-button"
                onAction="#onEnable">
            <graphic><IconifyIcon iconLiteral="bi-toggle-on" iconSize="16"/></graphic>
        </Button>
        <Button id="fundsxml-hint-dismiss" text="Not now" styleClass="fxt-tool-button, fxt-tool-neutral"
                onAction="#onDismiss"/>
    </children>
</fx:root>
