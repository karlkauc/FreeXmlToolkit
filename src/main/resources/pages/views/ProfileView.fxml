<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  The XSLT profile of one run (Transform panel → Profile run, XsltProfile). Loaded by ProfileView (fx:root), which fills
  the tables, the call tree and the flame graph.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="8" styleClass="fxt-profile-view"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="12"/>
    </padding>
    <children>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="summary" id="profile-summary" styleClass="fxt-side-panel-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="againButton" text="%ProfileView.againButton.text" id="profile-again" onAction="#onProfileAgain">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-clockwise" iconSize="16"/>
                    </graphic>
                </Button>
                <MenuButton text="%ProfileView.profile-export.text" id="profile-export">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-box-arrow-up" iconSize="16"/>
                    </graphic>
                    <items>
                        <MenuItem text="%ProfileView.profile-export-json.text" id="profile-export-json" onAction="#onExportJson">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-filetype-json" iconSize="16"/>
                            </graphic>
                        </MenuItem>
                        <MenuItem text="%ProfileView.profile-export-text.text" id="profile-export-text" onAction="#onExportText">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-file-earmark-text" iconSize="16"/>
                            </graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </children>
        </HBox>
        <TabPane fx:id="tabs" id="profile-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="%ProfileView.profile-tab-hotspots.text" id="profile-tab-hotspots">
                    <content>
                        <TableView fx:id="components" id="profile-components">
                            <columns>
                                <TableColumn fx:id="nameColumn" text="%ProfileView.nameColumn.text" prefWidth="280"/>
                                <TableColumn fx:id="kindColumn" text="%ProfileView.kindColumn.text" prefWidth="135"/>
                                <TableColumn fx:id="locationColumn" text="%ProfileView.locationColumn.text" prefWidth="150"/>
                                <TableColumn fx:id="callsColumn" text="%ProfileView.callsColumn.text" prefWidth="70"/>
                                <TableColumn fx:id="selfColumn" text="%ProfileView.selfColumn.text" prefWidth="90"/>
                                <TableColumn fx:id="selfPercentColumn" text="%ProfileView.selfPercentColumn.text" prefWidth="70"/>
                                <TableColumn fx:id="totalColumn" text="%ProfileView.totalColumn.text" prefWidth="90"/>
                                <TableColumn fx:id="avgColumn" text="%ProfileView.avgColumn.text" prefWidth="90"/>
                            </columns>
                            <placeholder>
                                <Label text="%ProfileView.no-templates-or-functions-were.text"/>
                            </placeholder>
                        </TableView>
                    </content>
                </Tab>
                <Tab text="%ProfileView.profile-tab-tree.text" id="profile-tab-tree">
                    <content>
                        <TreeTableView fx:id="tree" id="profile-tree" showRoot="true">
                            <columns>
                                <TreeTableColumn fx:id="treeNameColumn" text="%ProfileView.treeNameColumn.text" prefWidth="360"/>
                                <TreeTableColumn fx:id="treeCallsColumn" text="%ProfileView.treeCallsColumn.text" prefWidth="70"/>
                                <TreeTableColumn fx:id="treeTotalColumn" text="%ProfileView.treeTotalColumn.text" prefWidth="90"/>
                                <TreeTableColumn fx:id="treePercentColumn" text="%ProfileView.treePercentColumn.text" prefWidth="70"/>
                                <TreeTableColumn fx:id="treeSelfColumn" text="%ProfileView.treeSelfColumn.text" prefWidth="90"/>
                            </columns>
                        </TreeTableView>
                    </content>
                </Tab>
                <Tab text="%ProfileView.profile-tab-flame.text" id="profile-tab-flame">
                    <content>
                        <VBox spacing="6">
                            <padding>
                                <Insets top="6"/>
                            </padding>
                            <children>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <children>
                                        <Button text="%ProfileView.profile-flame-reset.text" id="profile-flame-reset" onAction="#onResetZoom">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-zoom-out" iconSize="16"/>
                                            </graphic>
                                        </Button>
                                        <Label text="%ProfileView.width-total-time-click-a.text"
                                               opacity="0.7"/>
                                    </children>
                                </HBox>
                                <ScrollPane fx:id="flameScroll" fitToWidth="true" VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="%ProfileView.profile-tab-lines.text" id="profile-tab-lines">
                    <content>
                        <TableView fx:id="lines" id="profile-lines">
                            <columns>
                                <TableColumn fx:id="lineLocationColumn" text="%ProfileView.lineLocationColumn.text" prefWidth="150"/>
                                <TableColumn fx:id="lineSourceColumn" text="%ProfileView.lineSourceColumn.text" prefWidth="420"/>
                                <TableColumn fx:id="lineHitsColumn" text="%ProfileView.lineHitsColumn.text" prefWidth="80"/>
                                <TableColumn fx:id="lineSelfColumn" text="%ProfileView.lineSelfColumn.text" prefWidth="90"/>
                                <TableColumn fx:id="lineSelfPercentColumn" text="%ProfileView.lineSelfPercentColumn.text" prefWidth="70"/>
                            </columns>
                        </TableView>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        <Label fx:id="note" id="profile-note" wrapText="true" opacity="0.7"
               text="%ProfileView.note.text"/>
    </children>
</fx:root>
