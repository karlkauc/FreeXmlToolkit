<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  XSD documentation generator (main-area tool tab): a form card (source/output, format, options,
  PDF/Word detail options, languages, generate) with a PROGRESS panel on the right.
  Loaded by DocumentationView via the fx:root pattern (FxmlViews.load); DocumentationView is root
  and controller. Filled in code: the page-size, colour-scheme and watermark choices (from the
  PDF/Word config enums), the language check boxes after a scan, and the progress rows.
-->
<fx:root type="javafx.scene.layout.BorderPane" styleClass="fxt-docgen"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="formatGroup"/>
        <ToggleGroup fx:id="orientationGroup"/>
    </fx:define>
    <center>
        <BorderPane styleClass="fxt-favmgr-card">
            <BorderPane.margin>
                <Insets topRightBottomLeft="24"/>
            </BorderPane.margin>
            <top>
                <VBox spacing="16">
                    <children>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <children>
                                <StackPane styleClass="fxt-sign-icon-tile">
                                    <children>
                                        <IconifyIcon iconLiteral="bi-file-earmark-text" iconSize="20"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="2">
                                    <children>
                                        <Label text="%DocumentationView.generate-documentation.text" styleClass="fxt-favmgr-title"/>
                                        <Label text="%DocumentationView.html-pdf-or-word-documentation.text"
                                               styleClass="fxt-favmgr-subtitle"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Region/>
                    </children>
                </VBox>
            </top>
            <center>
                <HBox spacing="20">
                    <children>
                        <!-- The form is the primary area: it grows but is capped at 640px. -->
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge"
                                    HBox.hgrow="ALWAYS">
                            <content>
                                <VBox spacing="10" maxWidth="640" styleClass="fxt-docgen-form">
                                    <children>
                                        <Label text="%DocumentationView.source-output.text" styleClass="fxt-sign-section-label"/>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <children>
                                                <IconifyIcon iconLiteral="bi-diagram-3" iconSize="15"/>
                                                <Label fx:id="xsdName" id="docgen-xsd-name" text="%DocumentationView.xsdName.text"
                                                       styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Hyperlink text="%DocumentationView.browse.text" styleClass="fxt-vp-change"
                                                           onAction="#onChooseXsd"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <children>
                                                <IconifyIcon iconLiteral="bi-folder2-open" iconSize="15"/>
                                                <Label fx:id="outputName" id="docgen-output-name" text="%DocumentationView.outputName.text"
                                                       styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Hyperlink text="%DocumentationView.browse.text-2" styleClass="fxt-vp-change"
                                                           onAction="#onChooseOutput"/>
                                            </children>
                                        </HBox>

                                        <Label text="%DocumentationView.format.text" styleClass="fxt-sign-section-label"/>
                                        <HBox spacing="2" styleClass="fxt-seg-group">
                                            <children>
                                                <ToggleButton fx:id="html" text="%DocumentationView.html.text" toggleGroup="$formatGroup"
                                                              selected="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                              styleClass="fxt-seg"/>
                                                <ToggleButton fx:id="pdf" text="%DocumentationView.pdf.text" toggleGroup="$formatGroup"
                                                              maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                              styleClass="fxt-seg"/>
                                                <ToggleButton fx:id="word" text="%DocumentationView.word.text" toggleGroup="$formatGroup"
                                                              maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                              styleClass="fxt-seg"/>
                                            </children>
                                        </HBox>

                                        <Label text="%DocumentationView.options.text" styleClass="fxt-sign-section-label"/>
                                        <VBox spacing="8">
                                            <children>
                                                <Label text="%DocumentationView.markdown-rendering.text" styleClass="fxt-sig-field-label"/>
                                                <ComboBox fx:id="markdownMode" id="docgen-markdown-mode">
                                                    <tooltip>
                                                        <Tooltip text="%DocumentationView.a-node-s-own-xs.text"/>
                                                    </tooltip>
                                                </ComboBox>
                                                <CheckBox fx:id="includeTypeDefs"
                                                          text="%DocumentationView.includeTypeDefs.text" selected="true"/>
                                                <CheckBox fx:id="showDocInSvg" text="%DocumentationView.showDocInSvg.text"/>
                                                <CheckBox fx:id="showConstraintsInSvg" id="docgen-show-constraints"
                                                          text="%DocumentationView.showConstraintsInSvg.text" selected="true">
                                                    <tooltip>
                                                        <Tooltip text="%DocumentationView.lists-keys-unique-and-keyref.text"/>
                                                    </tooltip>
                                                </CheckBox>
                                                <CheckBox fx:id="showRootConstraintsInSvg" id="docgen-show-root-constraints"
                                                          text="%DocumentationView.showRootConstraintsInSvg.text">
                                                    <padding>
                                                        <Insets left="24"/>
                                                    </padding>
                                                    <tooltip>
                                                        <Tooltip text="%DocumentationView.off-only-the-child-boxes.text"/>
                                                    </tooltip>
                                                </CheckBox>
                                                <CheckBox fx:id="showConstraintTargetsInSvg" id="docgen-show-constraint-targets"
                                                          text="%DocumentationView.showConstraintTargetsInSvg.text">
                                                    <tooltip>
                                                        <Tooltip text="%DocumentationView.also-lists-a-key-unique.text"/>
                                                    </tooltip>
                                                </CheckBox>
                                                <CheckBox fx:id="svgOverview" text="%DocumentationView.svgOverview.text" selected="true"/>
                                                <CheckBox fx:id="addMetadata" text="%DocumentationView.addMetadata.text" selected="true"/>
                                                <CheckBox fx:id="dedupDataDictionary"
                                                          text="%DocumentationView.dedupDataDictionary.text">
                                                    <tooltip>
                                                        <Tooltip text="%DocumentationView.list-each-named-complex-simple.text"/>
                                                    </tooltip>
                                                </CheckBox>
                                                <Label text="%DocumentationView.diagram-image-format.text" styleClass="fxt-sig-field-label"/>
                                                <ComboBox fx:id="imageFormat">
                                                    <items>
                                                        <FXCollections fx:factory="observableArrayList">
                                                            <String fx:value="SVG"/>
                                                            <String fx:value="PNG"/>
                                                            <String fx:value="JPG"/>
                                                        </FXCollections>
                                                    </items>
                                                </ComboBox>
                                                <Label text="%DocumentationView.favicon-html.text" styleClass="fxt-sig-field-label"/>
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <children>
                                                        <IconifyIcon iconLiteral="bi-image" iconSize="15"/>
                                                        <Label fx:id="faviconName" id="docgen-favicon-name" text="%DocumentationView.faviconName.text"
                                                               styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Hyperlink text="%DocumentationView.browse.text-3" styleClass="fxt-vp-change"
                                                                   onAction="#onChooseFavicon"/>
                                                        <Hyperlink text="%DocumentationView.clear.text" styleClass="fxt-vp-change"
                                                                   onAction="#onClearFavicon"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- PDF/Word detail options: shown only for those formats -->
                                        <VBox fx:id="formatOptionsBox" id="docgen-format-options" spacing="8">
                                            <children>
                                                <Label fx:id="formatOptionsLabel" text="%DocumentationView.formatOptionsLabel.text"
                                                       styleClass="fxt-sign-section-label"/>
                                                <Label text="%DocumentationView.page-size.text" styleClass="fxt-sig-field-label"/>
                                                <ComboBox fx:id="docPageSize" id="docgen-page-size"
                                                          maxWidth="Infinity"/>
                                                <Label text="%DocumentationView.orientation.text" styleClass="fxt-sig-field-label"/>
                                                <HBox spacing="2" styleClass="fxt-seg-group">
                                                    <children>
                                                        <ToggleButton fx:id="portrait" text="%DocumentationView.portrait.text"
                                                                      toggleGroup="$orientationGroup" selected="true"
                                                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                                      styleClass="fxt-seg"/>
                                                        <ToggleButton fx:id="landscape" text="%DocumentationView.landscape.text"
                                                                      toggleGroup="$orientationGroup"
                                                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                                      styleClass="fxt-seg"/>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="coverPage" text="%DocumentationView.coverPage.text"/>
                                                <CheckBox fx:id="tableOfContents" text="%DocumentationView.tableOfContents.text"
                                                          selected="true"/>
                                                <CheckBox fx:id="dataDictionary" text="%DocumentationView.dataDictionary.text"
                                                          selected="true"/>
                                                <CheckBox fx:id="schemaDiagram" text="%DocumentationView.schemaDiagram.text" selected="true"/>
                                                <CheckBox fx:id="elementDiagrams" text="%DocumentationView.elementDiagrams.text" selected="true"/>
                                                <Label text="%DocumentationView.element-reference.text" styleClass="fxt-sig-field-label"/>
                                                <ComboBox fx:id="pdfElementReference" id="docgen-element-reference">
                                                    <tooltip>
                                                        <Tooltip text="%DocumentationView.a-section-per-element-with.text"/>
                                                    </tooltip>
                                                </ComboBox>
                                                <CheckBox fx:id="pdfSourceCode" id="docgen-pdf-source"
                                                          text="%DocumentationView.pdfSourceCode.text">
                                                    <tooltip>
                                                        <Tooltip text="%DocumentationView.shows-the-xsd-source-of.text"/>
                                                    </tooltip>
                                                </CheckBox>
                                                <!-- PDF only -->
                                                <VBox fx:id="pdfOnlyBox" id="docgen-pdf-only" spacing="8">
                                                    <children>
                                                        <Label text="%DocumentationView.color-scheme.text" styleClass="fxt-sig-field-label"/>
                                                        <ComboBox fx:id="pdfColorScheme" id="docgen-color-scheme"/>
                                                        <Label text="%DocumentationView.watermark.text" styleClass="fxt-sig-field-label"/>
                                                        <ComboBox fx:id="pdfWatermark" id="docgen-watermark"/>
                                                        <CheckBox fx:id="pageNumbers" text="%DocumentationView.pageNumbers.text"
                                                                  selected="true"/>
                                                        <CheckBox fx:id="pdfBookmarks" text="%DocumentationView.pdfBookmarks.text"
                                                                  selected="true"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <Label text="%DocumentationView.languages.text" styleClass="fxt-sign-section-label"/>
                                        <VBox spacing="8">
                                            <children>
                                                <HBox spacing="10">
                                                    <children>
                                                        <Hyperlink id="docgen-scan-languages" text="%DocumentationView.docgen-scan-languages.text"
                                                                   styleClass="fxt-vp-change"
                                                                   onAction="#onScanLanguages"/>
                                                        <Label fx:id="languagesStatus"
                                                               text="%DocumentationView.languagesStatus.text"
                                                               styleClass="fxt-favmgr-subtitle"/>
                                                    </children>
                                                </HBox>
                                                <FlowPane fx:id="languagesPane" hgap="10" vgap="6"/>
                                                <Label text="%DocumentationView.fallback-language.text" styleClass="fxt-sig-field-label"/>
                                                <ComboBox fx:id="fallbackLanguage" promptText="%DocumentationView.fallbackLanguage.promptText"/>
                                            </children>
                                        </VBox>

                                        <CheckBox fx:id="openAfter"
                                                  text="%DocumentationView.openAfter.text"
                                                  selected="true"/>
                                        <HBox spacing="8">
                                            <children>
                                                <Button fx:id="generate" id="docgen-generate"
                                                        text="%DocumentationView.generate.text" maxWidth="Infinity"
                                                        HBox.hgrow="ALWAYS" styleClass="fxt-primary-button"
                                                        onAction="#onGenerate">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-play-fill" iconSize="14"/>
                                                    </graphic>
                                                </Button>
                                                <Button fx:id="cancel" id="docgen-cancel" text="%DocumentationView.cancel.text" disable="true"
                                                        styleClass="fxt-tool-button" onAction="#onCancel"/>
                                            </children>
                                        </HBox>
                                        <Label fx:id="status" id="docgen-status" text="%DocumentationView.status.text" wrapText="true"
                                               styleClass="fxt-vp-status"/>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- PROGRESS: bounded-width secondary panel; spinner + timer show while running -->
                        <VBox spacing="8" minWidth="240" prefWidth="300" maxWidth="340"
                              styleClass="fxt-docgen-progress-pane">
                            <children>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%DocumentationView.progress.text" styleClass="fxt-sign-section-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <ProgressIndicator fx:id="spinner" minWidth="16" minHeight="16"
                                                           prefWidth="16" prefHeight="16" maxWidth="16"
                                                           maxHeight="16" visible="false" managed="false"
                                                           styleClass="fxt-docgen-spinner"/>
                                        <Label fx:id="elapsedLabel" visible="false" managed="false"
                                               styleClass="fxt-docgen-elapsed"/>
                                    </children>
                                </HBox>
                                <ListView fx:id="progressList" id="docgen-progress" focusTraversable="false"
                                          styleClass="fxt-docgen-progress" VBox.vgrow="ALWAYS">
                                    <placeholder>
                                        <Label text="%DocumentationView.progress-messages-appear-here-during.text"/>
                                    </placeholder>
                                </ListView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </center>
        </BorderPane>
    </center>
</fx:root>
