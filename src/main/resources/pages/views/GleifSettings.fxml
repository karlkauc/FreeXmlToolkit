<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Settings → GLEIF (LEI lookup): when LEIs are sent to GLEIF besides an explicit lookup, how long answers are kept.
  Loaded by GleifSettings (fx:root); changes are saved at once.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="6"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="%GleifSettings.intro.text" wrapText="true" minHeight="-Infinity" styleClass="fxt-placeholder-text"/>
        <Label fx:id="policyNote" id="settings-gleif-policy" text="%GleifSettings.policyNote.text" wrapText="true"
               minHeight="-Infinity"/>
        <CheckBox fx:id="onValidation" id="settings-gleif-validation" text="%GleifSettings.onValidation.text"
                  onAction="#onValidationChanged">
            <tooltip>
                <Tooltip text="%GleifSettings.onValidation.tooltip"/>
            </tooltip>
        </CheckBox>
        <CheckBox fx:id="hover" id="settings-gleif-hover" text="%GleifSettings.hover.text" onAction="#onHoverChanged">
            <tooltip>
                <Tooltip text="%GleifSettings.hover.tooltip"/>
            </tooltip>
        </CheckBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="hoursLabel" text="%GleifSettings.hours.text"/>
                <Spinner fx:id="hours" id="settings-gleif-hours" prefWidth="90" editable="true"/>
                <Button fx:id="clearButton" id="settings-gleif-clear" text="%GleifSettings.clearButton.text"
                        styleClass="fxt-tool-button" onAction="#onClear">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-trash" iconSize="16"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </children>
</fx:root>
