<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  One-time hint above the editor when a document is opened that a switched-off extension recognises
  (FxtPlugin.recognises). Loaded by PluginHintBar via the fx:root pattern; the text names the extension.
-->
<fx:root type="javafx.scene.layout.HBox" id="plugin-hint" spacing="10" alignment="CENTER_LEFT"
         styleClass="fxt-hint-bar" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <IconifyIcon iconLiteral="bi-lightbulb" iconSize="16" styleClass="fxt-hint-bar-icon"/>
        <Label fx:id="message" id="plugin-hint-text" wrapText="true" minWidth="0" maxWidth="Infinity"
               styleClass="fxt-hint-bar-text" HBox.hgrow="ALWAYS"/>
        <Button fx:id="enableButton" id="plugin-hint-enable" text="%PluginHintBar.enable.text" styleClass="fxt-primary-button"
                onAction="#onEnable">
            <graphic><IconifyIcon iconLiteral="bi-toggle-on" iconSize="16"/></graphic>
        </Button>
        <Button fx:id="dismissButton" id="plugin-hint-dismiss" text="%PluginHintBar.dismiss.text"
                styleClass="fxt-tool-button, fxt-tool-neutral" onAction="#onDismiss"/>
    </children>
</fx:root>
