<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Statistics tab of the Large File Viewer: element paths with counts, read in one streaming pass.
  Loaded by LargeFileStatisticsPane (fx:root).
-->
<fx:root type="javafx.scene.layout.VBox" spacing="4" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <padding>
                <Insets top="4" right="8" bottom="2" left="8"/>
            </padding>
            <children>
                <Button fx:id="scanButton" text="%LargeFileStatisticsPane.scanButton.text" id="large-file-stats-scan" onAction="#onScan">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-play-fill" iconSize="16"/>
                    </graphic>
                </Button>
                <Label fx:id="summaryLabel" id="large-file-stats-summary" wrapText="true"
                       text="%LargeFileStatisticsPane.summaryLabel.text"/>
            </children>
        </HBox>
        <TableView fx:id="paths" id="large-file-stats" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="pathColumn" text="%LargeFileStatisticsPane.pathColumn.text" prefWidth="260"/>
                <TableColumn fx:id="countColumn" text="%LargeFileStatisticsPane.countColumn.text" prefWidth="100"/>
                <TableColumn fx:id="perParentColumn" text="%LargeFileStatisticsPane.perParentColumn.text" prefWidth="110"/>
                <TableColumn fx:id="attributesColumn" text="%LargeFileStatisticsPane.attributesColumn.text" prefWidth="220"/>
                <TableColumn fx:id="textColumn" text="%LargeFileStatisticsPane.textColumn.text" prefWidth="60"/>
                <TableColumn fx:id="sampleColumn" text="%LargeFileStatisticsPane.sampleColumn.text" prefWidth="260"/>
            </columns>
            <placeholder>
                <Label text="%LargeFileStatisticsPane.placeholder.text"/>
            </placeholder>
        </TableView>
    </children>
</fx:root>
