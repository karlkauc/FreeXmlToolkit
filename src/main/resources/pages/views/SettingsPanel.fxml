<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SettingsCard?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SettingsCardGrid?>
<?import org.fxt.freexmltoolkit.controls.theme.SemanticColors?>

<!--
  The Settings page (a tab in the main editor area): seven groups (Appearance, Editor, Schemas &amp;
  Validation, Files &amp; Cache, Network &amp; Security, Privacy, Extensions), each a wrapping
  two-column flow of colour-coded SettingsCards, and a fixed save bar below the scroll area.
  The Settings side panel lists the groups and filters them (SettingsPanel.sections / filter). Loaded by SettingsPanel via the fx:root pattern
  (FxmlViews.load); SettingsPanel is root and controller and loads/saves the values.
  Stylesheets are inherited from the shell root.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-side-panel-content"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
        <ToggleGroup fx:id="toolbarIconSizeGroup"/>
    </fx:define>
    <children>
        <ScrollPane fx:id="scroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="fxt-settings-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="page" spacing="16" styleClass="fxt-settings-page">
                    <children>
                        <Label text="SETTINGS" styleClass="fxt-side-panel-title, fxt-panel-title"/>

                        <!-- One group per topic; the side panel (PageNavigator) lists the groups. -->
                        <VBox fx:id="groups" spacing="28" maxWidth="1200">
                            <children>
                                <VBox id="settings-group-appearance" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="Appearance" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#1373D9">
                                            <children>
                                        <SettingsCard title="THEME" iconLiteral="bi-palette">
                                            <children>
                                                <HBox spacing="6">
                                                    <children>
                                                        <ToggleButton fx:id="light" text="Light" toggleGroup="$themeGroup"
                                                                      focusTraversable="false" styleClass="fxt-view-seg"
                                                                      onAction="#onThemeLight">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-sun" iconSize="16"/>
                                                            </graphic>
                                                        </ToggleButton>
                                                        <ToggleButton fx:id="dark" text="Dark" toggleGroup="$themeGroup"
                                                                      focusTraversable="false" styleClass="fxt-view-seg"
                                                                      onAction="#onThemeDark">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-moon" iconSize="16"/>
                                                            </graphic>
                                                        </ToggleButton>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="LAYOUT" iconLiteral="bi-layout-sidebar">
                                            <children>
                                                <CheckBox fx:id="smallIcons" text="Use small icons"/>
                                                <CheckBox fx:id="toolbarLabels" text="Show toolbar button labels"/>
                                                <CheckBox fx:id="activityBarLabels" text="Show activity bar labels"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Toolbar icons:"/>
                                                        <HBox spacing="6">
                                                            <children>
                                                                <ToggleButton fx:id="toolbarIconSmall" text="Small"
                                                                              toggleGroup="$toolbarIconSizeGroup"/>
                                                                <ToggleButton fx:id="toolbarIconLarge" text="Large"
                                                                              toggleGroup="$toolbarIconSizeGroup"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="showLeftPanel" text="Show left side panel"/>
                                                <CheckBox fx:id="showInspector" text="Show Properties (inspector) panel"/>
                                            </children>
                                        </SettingsCard>
                                        <!-- JavaFX Prism pipeline; applied at next startup -->
                                        <SettingsCard title="RENDERING" iconLiteral="bi-gpu-card">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Mode:"/>
                                                        <ComboBox fx:id="renderingMode">
                                                            <items>
                                                                <FXCollections fx:factory="observableArrayList">
                                                                    <String fx:value="Auto"/>
                                                                    <String fx:value="Hardware"/>
                                                                    <String fx:value="Software"/>
                                                                </FXCollections>
                                                            </items>
                                                        </ComboBox>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="renderingActiveStatus" wrapText="true"/>
                                                <Label fx:id="renderingGpuStatus" wrapText="true"
                                                       styleClass="fxt-placeholder-text"/>
                                                <Label text="Auto picks GPU rendering on dedicated graphics, software otherwise. Takes effect after restart."
                                                       wrapText="true" styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="MEMORY" iconLiteral="bi-memory">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Maximum memory:"/>
                                                        <ComboBox fx:id="maxMemory" id="settings-max-memory"/>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="memoryStatus" id="settings-memory-status" wrapText="true"/>
                                                <Label text="More memory lets you open and edit larger files. Automatic uses half of the installed memory. Takes effect after restart."
                                                       wrapText="true" styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                            </children>
                                        </SettingsCardGrid>
                                    </children>
                                </VBox>
                                <VBox id="settings-group-editor" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="Editor" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#0e8fa3">
                                            <children>
                                        <SettingsCard title="EDITOR" iconLiteral="bi-pencil-square">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="XML indent:"/>
                                                        <Spinner fx:id="indentSpaces" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="8" initialValue="2"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="JSON indent:"/>
                                                        <Spinner fx:id="jsonIndent" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="8" initialValue="2"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="autoFormat" text="Auto-format after loading"/>
                                                <CheckBox fx:id="xsdPrettyPrint" text="Pretty-print XSD on save"/>
                                                <CheckBox fx:id="schematronPretty" text="Pretty-print Schematron on load"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Recent files to remember:"/>
                                                        <Spinner fx:id="recentFilesLimit" id="settings-recent-files-limit" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="100" initialValue="20"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="GRID TABLE COLOURS" iconLiteral="bi-table">
                                            <children>
                                                <CheckBox fx:id="gridCustomColors" id="settings-grid-custom-colors"
                                                          text="Custom cell colours in the Graphic grid"/>
                                                <Label fx:id="gridColorsTheme" styleClass="fxt-placeholder-text" wrapText="true"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Table header:" minWidth="110"/>
                                                        <ColorPicker fx:id="gridHeaderColor" id="settings-grid-header-color"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Missing cell:" minWidth="110"/>
                                                        <ColorPicker fx:id="gridMissingColor" id="settings-grid-missing-color"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Selection:" minWidth="110"/>
                                                        <ColorPicker fx:id="gridSelectionColor" id="settings-grid-selection-color"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Focus frame:" minWidth="110"/>
                                                        <ColorPicker fx:id="gridFocusColor" id="settings-grid-focus-color"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="TEMPLATES" iconLiteral="bi-file-earmark-plus">
                                            <children>
                                                <Label text="Templates directory:"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="templatesDir"
                                                                   promptText="templates directory (leave empty for default)"
                                                                   HBox.hgrow="ALWAYS"/>
                                                        <Button text="…" onAction="#onBrowseTemplatesDir"/>
                                                    </children>
                                                </HBox>
                                                <Label text="Your templates:"/>
                                                <ListView fx:id="templatesList" prefHeight="140" maxWidth="Infinity"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Button text="New" styleClass="fxt-tool-button"
                                                                onAction="#onNewTemplate">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-plus-lg" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                        <Button fx:id="editTemplateButton" text="Edit"
                                                                styleClass="fxt-tool-button" onAction="#onEditTemplate">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-pencil" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                        <Button fx:id="deleteTemplateButton" text="Delete"
                                                                styleClass="fxt-tool-button" onAction="#onDeleteTemplate">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-trash" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="USER INFO" iconLiteral="bi-person">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Name:"/>
                                                        <TextField fx:id="userName" promptText="name"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Email:"/>
                                                        <TextField fx:id="userEmail" promptText="email"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Company:"/>
                                                        <TextField fx:id="userCompany" promptText="company"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                            </children>
                                        </SettingsCardGrid>
                                    </children>
                                </VBox>
                                <VBox id="settings-group-schemas" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="Schemas &amp; Validation" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#6f42c1">
                                            <children>
                                        <SettingsCard title="XSD" iconLiteral="bi-diagram-3">
                                            <children>
                                                <CheckBox fx:id="xsdAutoSave" text="Auto-save"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Interval (min):"/>
                                                        <Spinner fx:id="xsdAutoSaveInterval" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="120" initialValue="5"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="xsdBackup" text="Create backups on save"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Keep versions:"/>
                                                        <Spinner fx:id="xsdBackupVersions" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="50" initialValue="5"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="backupSeparateDir" text="Use a separate backup directory"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="backupDir" promptText="backup directory"
                                                                   HBox.hgrow="ALWAYS"/>
                                                        <Button text="…" onAction="#onBrowseBackupDir"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="SCHEMA LIBRARY" iconLiteral="bi-collection">
                                            <children>
                                                <CheckBox fx:id="schemaLibraryAutoBind" id="settings-schema-library-autobind"
                                                          text="Use the Schema Library to bind schemas automatically"
                                                          wrapText="true"/>
                                                <Label fx:id="libraryFile" wrapText="true" styleClass="fxt-lib-status"/>
                                                <Hyperlink id="settings-manage-schema-cache"
                                                           text="Manage schema cache…" onAction="#onManageSchemaCache">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-collection" iconSize="16"/>
                                                    </graphic>
                                                </Hyperlink>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="PARSER" iconLiteral="bi-cpu">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="XML parser:"/>
                                                        <ComboBox fx:id="parserType"/>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="xsltExtensions" text="Allow XSLT extension functions"/>
                                            </children>
                                        </SettingsCard>
                                            </children>
                                        </SettingsCardGrid>
                                    </children>
                                </VBox>
                                <VBox id="settings-group-files" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="Files &amp; Cache" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#c2850c">
                                            <children>
                                        <SettingsCard title="TEMP &amp; CACHE" iconLiteral="bi-trash">
                                            <children>
                                                <CheckBox fx:id="useSystemTemp" text="Use system temp folder"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="customTempDir" promptText="custom temp folder"
                                                                   HBox.hgrow="ALWAYS"/>
                                                        <Button text="…" onAction="#onBrowseTempDir"/>
                                                    </children>
                                                </HBox>
                                                <Button fx:id="clearTempButton" id="settings-clear-temp" text="Clear Temp Folder" maxWidth="Infinity"
                                                        styleClass="fxt-tool-button" onAction="#onClearTemp">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-trash" iconSize="16"/>
                                                    </graphic>
                                                </Button>
                                                <Button fx:id="clearCacheButton" id="settings-clear-cache" text="Clear Cache Folder" maxWidth="Infinity"
                                                        styleClass="fxt-tool-button" onAction="#onClearCache">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-trash" iconSize="16"/>
                                                    </graphic>
                                                </Button>
                                                <Label fx:id="tempStatus" styleClass="fxt-placeholder-text"/>
                                                <Hyperlink id="settings-manage-schema-cache-2" text="Manage schema cache…"
                                                           onAction="#onManageSchemaCache">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-collection" iconSize="16"/>
                                                    </graphic>
                                                </Hyperlink>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="LOG FILES" iconLiteral="bi-journal-text">
                                            <children>
                                                <CheckBox fx:id="logCleanup" id="settings-log-cleanup"
                                                          text="Delete old log files automatically at startup"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Keep for (days):" minWidth="150"/>
                                                        <Spinner fx:id="logMaxAge" id="settings-log-max-age" editable="true" prefWidth="100">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="365" initialValue="14"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Maximum total size (MB):" minWidth="150"/>
                                                        <Spinner fx:id="logMaxSize" id="settings-log-max-size" editable="true" prefWidth="100">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="10000" initialValue="100" amountToStepBy="10"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <Label text="0 means no limit. The log file in use is never deleted."
                                                       styleClass="fxt-placeholder-text" wrapText="true"/>
                                                <Button fx:id="cleanLogsButton" id="settings-log-clean-now" text="Clean Up Now"
                                                        maxWidth="Infinity" styleClass="fxt-tool-button" onAction="#onCleanLogsNow">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-trash" iconSize="16"/>
                                                    </graphic>
                                                </Button>
                                                <Hyperlink id="settings-log-open-folder" text="Open log folder"
                                                           onAction="#onOpenLogFolder">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
                                                    </graphic>
                                                </Hyperlink>
                                                <Label fx:id="logStatus" id="settings-log-status"
                                                       styleClass="fxt-placeholder-text" wrapText="true"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="FILE ASSOCIATIONS" iconLiteral="bi-file-earmark-check">
                                            <children>
                                                <Label text="Make FreeXmlToolkit the default application for the selected file types (current user only)."
                                                       wrapText="true" styleClass="fxt-placeholder-text"/>
                                                <CheckBox fx:id="assocXml" text="XML (.xml)"/>
                                                <CheckBox fx:id="assocXsd" text="XSD Schema (.xsd)"/>
                                                <CheckBox fx:id="assocXslt" text="XSLT Stylesheet (.xsl, .xslt)"/>
                                                <CheckBox fx:id="assocSch" text="Schematron (.sch, .schematron)"/>
                                                <CheckBox fx:id="assocJson" text="JSON (.json)"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Button fx:id="assocRegister" text="Register"
                                                                styleClass="fxt-tool-button"
                                                                onAction="#onRegisterAssociations">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-box-arrow-in-down" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                        <Button fx:id="assocUnregister" text="Unregister"
                                                                styleClass="fxt-tool-button"
                                                                onAction="#onUnregisterAssociations">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-x-circle" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="assocStatus" wrapText="true" styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                            </children>
                                        </SettingsCardGrid>
                                    </children>
                                </VBox>
                                <VBox id="settings-group-network" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="Network &amp; Security" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#6610f2">
                                            <children>
                                        <SettingsCard title="HTTP PROXY" iconLiteral="bi-globe">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Connection:" minWidth="110"/>
                                                        <ComboBox fx:id="proxyMode" id="settings-proxy-mode" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Proxy host:" minWidth="110"/>
                                                        <TextField fx:id="proxyHost" id="settings-proxy-host" promptText="proxy.example.com" HBox.hgrow="ALWAYS"/>
                                                        <Label text="Port:"/>
                                                        <TextField fx:id="proxyPort" id="settings-proxy-port" promptText="8080" prefColumnCount="5"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="No proxy for:" minWidth="110"/>
                                                        <TextField fx:id="proxyBypass" id="settings-proxy-bypass" promptText="localhost, *.corp.example, 10.*" HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <Separator/>
                                                <Label text="Proxy authentication" styleClass="fxt-settings-subtitle"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="User:" minWidth="110"/>
                                                        <TextField fx:id="proxyUser" id="settings-proxy-user" promptText="user or DOMAIN\user" HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Password:" minWidth="110"/>
                                                        <PasswordField fx:id="proxyPassword" id="settings-proxy-password" HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Domain (NTLM):" minWidth="110"/>
                                                        <TextField fx:id="proxyDomain" id="settings-proxy-domain" promptText="optional" HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="proxyWindowsSignOn" id="settings-proxy-windows-sign-on"
                                                          text="Without a user, sign in with the Windows account (NTLM / Kerberos)" wrapText="true"/>
                                                <Separator/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Timeouts (s):" minWidth="110"/>
                                                        <Label text="connect"/>
                                                        <Spinner fx:id="connectTimeout" id="settings-connect-timeout" editable="true" prefWidth="80">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="600" initialValue="30"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                        <Label text="read"/>
                                                        <Spinner fx:id="readTimeout" id="settings-read-timeout" editable="true" prefWidth="80">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="3600" initialValue="60"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="proxyTestUrl" id="settings-proxy-test-url" text="https://github.com" HBox.hgrow="ALWAYS"/>
                                                        <Button fx:id="proxyTestButton" id="settings-proxy-test" text="Test Connection"
                                                                styleClass="fxt-tool-button" onAction="#onTestConnection">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-plug" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="proxyTestStatus" id="settings-proxy-test-status" styleClass="fxt-placeholder-text"/>
                                                <Label text="Used by every connection: schema and catalog downloads, updates, FundsXML, telemetry, doc() in XPath and XQuery, XProc and HTML previews. The test uses the values shown here, saved or not. Changing the Windows sign-in takes effect after a restart."
                                                       styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="SECURITY" iconLiteral="bi-shield-lock">
                                            <children>
                                                <CheckBox fx:id="trustAllCerts" text="Trust all certificates"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="UPDATES" iconLiteral="bi-arrow-repeat">
                                            <children>
                                                <CheckBox fx:id="updateCheck" text="Check for updates on startup"/>
                                            </children>
                                        </SettingsCard>
                                            </children>
                                        </SettingsCardGrid>
                                    </children>
                                </VBox>
                                <VBox id="settings-group-privacy" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="Privacy" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#64748b">
                                            <children>
                                        <SettingsCard title="USAGE STATISTICS" iconLiteral="bi-graph-up">
                                            <children>
                                                <CheckBox fx:id="trackingEnabled" text="Enable usage tracking"/>
                                                <Button text="Clear statistics" maxWidth="Infinity"
                                                        styleClass="fxt-tool-button" onAction="#onClearStatistics">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-trash" iconSize="16"/>
                                                    </graphic>
                                                </Button>
                                                <Label fx:id="usageStatus" styleClass="fxt-placeholder-text"/>
                                                <Separator/>
                                                <!-- Anonymous telemetry (opt-out, see docs/telemetry.md) -->
                                                <CheckBox fx:id="telemetryUsage" id="settings-telemetry-usage"
                                                          text="Send anonymous usage statistics" wrapText="true"/>
                                                <CheckBox fx:id="telemetryErrors" id="settings-telemetry-errors"
                                                          text="Send anonymous error reports" wrapText="true"/>
                                                <!-- minHeight -Infinity = USE_PREF_SIZE: wrap fully instead of ellipsizing -->
                                                <Label text="Helps improve FreeXmlToolkit. Only anonymous data is sent (feature usage, timings, document type, error signatures) — never file names, paths or content. The local statistics above stay on this computer."
                                                       wrapText="true" minHeight="-Infinity"
                                                       styleClass="fxt-placeholder-text"/>
                                                <Hyperlink id="settings-telemetry-what" text="What is sent?"
                                                           onAction="#onWhatIsSent">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-info-circle" iconSize="16"/>
                                                    </graphic>
                                                </Hyperlink>
                                            </children>
                                        </SettingsCard>
                                            </children>
                                        </SettingsCardGrid>
                                    </children>
                                </VBox>
                                <VBox id="settings-group-extensions" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="Extensions" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#0ca678">
                                            <children>
                                        <SettingsCard title="FUNDSXML" iconLiteral="bi-file-earmark-code">
                                            <children>
                                                <CheckBox fx:id="fundsXmlEnabled" text="Enable FundsXML extensions"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="DEVELOPER" iconLiteral="bi-speedometer2">
                                            <children>
                                                <CheckBox fx:id="execStatsEnabled" text="Record execution statistics"/>
                                                <Label text="Collects duration, CPU and memory per XSLT/XQuery/validation run. View them in the &quot;Execution Statistics&quot; tool tab."
                                                       wrapText="true" minHeight="-Infinity"
                                                       styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                        <!-- "Support the Project": short pitch plus a button to GitHub Sponsors -->
                                        <SettingsCard title="SUPPORT THE PROJECT" iconLiteral="bi-heart-fill">
                                            <color>
                                                <SemanticColors fx:constant="SPONSOR"/>
                                            </color>
                                            <children>
                                                <Label text="FreeXmlToolkit is free and open source. If it saves you time, please consider sponsoring its development on GitHub."
                                                       wrapText="true" styleClass="fxt-placeholder-text"/>
                                                <!-- The sponsor heart keeps its own colour; SettingsPanel sets the graphic. -->
                                                <Button fx:id="sponsorButton" id="settings-sponsor" text="Sponsor on GitHub"
                                                        styleClass="fxt-tool-button" onAction="#onSponsor"/>
                                            </children>
                                        </SettingsCard>
                                            </children>
                                        </SettingsCardGrid>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                        <Label fx:id="noMatch" id="settings-no-match" text="No settings match the search."
                               visible="false" managed="false" styleClass="fxt-placeholder-text"/>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Fixed save bar (decision E5): changes apply on Save; the hint shows unsaved edits. -->
        <HBox id="settings-save-bar" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-settings-save-bar">
            <children>
                <Label fx:id="dirtyHint" id="settings-dirty" text="Unsaved changes" visible="false"
                       styleClass="fxt-settings-dirty">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-circle-fill" iconSize="8"/>
                    </graphic>
                </Label>
                <Label fx:id="saveStatus" id="settings-save-status" styleClass="fxt-placeholder-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button id="settings-reset" text="Reset to Defaults…" styleClass="fxt-tool-button"
                        onAction="#onResetDefaults">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-counterclockwise" iconSize="16"/>
                    </graphic>
                </Button>
                <Button fx:id="saveButton" id="settings-save" text="Save Settings"
                        styleClass="fxt-tool-button, fxt-primary-button" onAction="#onSave">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-save" iconSize="16"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </children>
</fx:root>
