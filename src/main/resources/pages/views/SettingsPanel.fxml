<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.ai.AiSettingsPane?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.FoProcessorsSettings?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SettingsCard?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SettingsCardGrid?>
<?import org.fxt.freexmltoolkit.controls.theme.SemanticColors?>

<!--
  The Settings page (a tab in the main editor area): seven groups (Appearance, Editor, Schemas &amp;
  Validation, Files &amp; Cache, Network &amp; Security, Privacy, Extensions), each a wrapping
  two-column flow of colour-coded SettingsCards, and a fixed save bar below the scroll area.
  The Settings side panel lists the groups and filters them (SettingsPanel.sections / filter). Loaded by SettingsPanel via the fx:root pattern
  (FxmlViews.load); SettingsPanel is root and controller and loads/saves the values.
  Stylesheets are inherited from the shell root.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-side-panel-content"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
        <ToggleGroup fx:id="uiFontSizeGroup"/>
        <ToggleGroup fx:id="densityGroup"/>
        <ToggleGroup fx:id="toolbarIconSizeGroup"/>
    </fx:define>
    <children>
        <ScrollPane fx:id="scroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="fxt-settings-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="page" spacing="16" styleClass="fxt-settings-page">
                    <children>
                        <Label text="%SettingsPanel.settings.text" styleClass="fxt-side-panel-title, fxt-panel-title"/>
                        <!-- Shown when an administrator's policy file locks settings (AdminPolicy). -->
                        <Label fx:id="policyNotice" id="settings-policy-notice" visible="false" managed="false"
                               wrapText="true" maxWidth="1200" styleClass="fxt-settings-policy-notice">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-shield-lock" iconSize="16"/>
                            </graphic>
                        </Label>

                        <!-- One group per topic; the side panel (PageNavigator) lists the groups. -->
                        <VBox fx:id="groups" spacing="28" maxWidth="1200">
                            <children>
                                <VBox id="settings-group-appearance" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="%SettingsPanel.appearance.text" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#1373D9">
                                            <children>
                                        <SettingsCard title="%SettingsPanel.theme.title" iconLiteral="bi-palette">
                                            <children>
                                                <HBox spacing="6">
                                                    <children>
                                                        <ToggleButton fx:id="light" text="%SettingsPanel.light.text" toggleGroup="$themeGroup" styleClass="fxt-view-seg"
                                                                      onAction="#onThemeLight">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-sun" iconSize="16"/>
                                                            </graphic>
                                                        </ToggleButton>
                                                        <ToggleButton fx:id="dark" text="%SettingsPanel.dark.text" toggleGroup="$themeGroup" styleClass="fxt-view-seg"
                                                                      onAction="#onThemeDark">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-moon" iconSize="16"/>
                                                            </graphic>
                                                        </ToggleButton>
                                                        <ToggleButton fx:id="systemTheme" id="settings-theme-system" text="%SettingsPanel.systemTheme.text"
                                                                      toggleGroup="$themeGroup" styleClass="fxt-view-seg" onAction="#onThemeSystem">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-circle-half" iconSize="16"/>
                                                            </graphic>
                                                        </ToggleButton>
                                                    </children>
                                                </HBox>
                                                <Label text="%SettingsPanel.theme-system-hint.text" wrapText="true"
                                                       minHeight="-Infinity" styleClass="fxt-placeholder-text"/>
                                                <CheckBox fx:id="highContrast" id="settings-high-contrast"
                                                          text="%SettingsPanel.highContrast.text" onAction="#onHighContrast"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.accent.title" iconLiteral="bi-droplet-half">
                                            <children>
                                                <FlowPane fx:id="accentSwatches" id="settings-accent-swatches" hgap="6" vgap="6"/>
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.accent-custom.text"/>
                                                        <ColorPicker fx:id="accentPicker" id="settings-accent-custom"
                                                                     accessibleText="%SettingsPanel.accent-custom.accessibleText"
                                                                     onAction="#onAccentCustom"/>
                                                    </children>
                                                </HBox>
                                                <Label text="%SettingsPanel.accent-hint.text" wrapText="true"
                                                       minHeight="-Infinity" styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.ui-font.title" iconLiteral="bi-type">
                                            <children>
                                                <HBox spacing="6">
                                                    <children>
                                                        <ToggleButton fx:id="uiFontSmall" id="settings-ui-font-small" text="%Appearance.fontSize.small"
                                                                      toggleGroup="$uiFontSizeGroup" styleClass="fxt-view-seg" onAction="#onUiFontSize"/>
                                                        <ToggleButton fx:id="uiFontNormal" id="settings-ui-font-normal" text="%Appearance.fontSize.normal"
                                                                      toggleGroup="$uiFontSizeGroup" styleClass="fxt-view-seg" onAction="#onUiFontSize"/>
                                                        <ToggleButton fx:id="uiFontLarge" id="settings-ui-font-large" text="%Appearance.fontSize.large"
                                                                      toggleGroup="$uiFontSizeGroup" styleClass="fxt-view-seg" onAction="#onUiFontSize"/>
                                                        <ToggleButton fx:id="uiFontXLarge" id="settings-ui-font-xlarge" text="%Appearance.fontSize.xlarge"
                                                                      toggleGroup="$uiFontSizeGroup" styleClass="fxt-view-seg" onAction="#onUiFontSize"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.density.text"/>
                                                        <ToggleButton fx:id="densityCompact" id="settings-density-compact" text="%Appearance.density.compact"
                                                                      toggleGroup="$densityGroup" styleClass="fxt-view-seg" onAction="#onDensity"/>
                                                        <ToggleButton fx:id="densityNormal" id="settings-density-normal" text="%Appearance.density.normal"
                                                                      toggleGroup="$densityGroup" styleClass="fxt-view-seg" onAction="#onDensity"/>
                                                        <ToggleButton fx:id="densityComfortable" id="settings-density-comfortable" text="%Appearance.density.comfortable"
                                                                      toggleGroup="$densityGroup" styleClass="fxt-view-seg" onAction="#onDensity"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.ui-font-family.text"/>
                                                        <ComboBox fx:id="uiFontFamily" id="settings-ui-font-family" editable="true" prefWidth="200"/>
                                                        <Button text="%SettingsPanel.ui-font-reset.text" id="settings-ui-font-reset"
                                                                onAction="#onUiFontReset" styleClass="fxt-tool-button">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-arrow-counterclockwise" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                                <Label text="%SettingsPanel.ui-font-hint.text" wrapText="true"
                                                       minHeight="-Infinity" styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.language.title" iconLiteral="bi-translate">
                                            <children>
                                                <ComboBox fx:id="uiLanguage" id="settings-language" accessibleText="%SettingsPanel.language.accessibleText" maxWidth="Infinity"/>
                                                <Label text="%SettingsPanel.language-restart.text" wrapText="true"
                                                       minHeight="-Infinity" styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.layout.title" iconLiteral="bi-layout-sidebar">
                                            <children>
                                                <CheckBox fx:id="smallIcons" text="%SettingsPanel.smallIcons.text"/>
                                                <CheckBox fx:id="toolbarLabels" text="%SettingsPanel.toolbarLabels.text"/>
                                                <CheckBox fx:id="activityBarLabels" text="%SettingsPanel.activityBarLabels.text"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.toolbar-icons.text"/>
                                                        <HBox spacing="6">
                                                            <children>
                                                                <ToggleButton fx:id="toolbarIconSmall" text="%SettingsPanel.toolbarIconSmall.text"
                                                                              toggleGroup="$toolbarIconSizeGroup"/>
                                                                <ToggleButton fx:id="toolbarIconLarge" text="%SettingsPanel.toolbarIconLarge.text"
                                                                              toggleGroup="$toolbarIconSizeGroup"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="showLeftPanel" text="%SettingsPanel.showLeftPanel.text"/>
                                                <CheckBox fx:id="showInspector" text="%SettingsPanel.showInspector.text"/>
                                            </children>
                                        </SettingsCard>
                                        <!-- JavaFX Prism pipeline; applied at next startup -->
                                        <SettingsCard title="%SettingsPanel.rendering.title" iconLiteral="bi-gpu-card">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.mode.text"/>
                                                        <ComboBox fx:id="renderingMode">
                                                            <items>
                                                                <FXCollections fx:factory="observableArrayList">
                                                                    <String fx:value="Auto"/>
                                                                    <String fx:value="Hardware"/>
                                                                    <String fx:value="Software"/>
                                                                </FXCollections>
                                                            </items>
                                                        </ComboBox>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="renderingActiveStatus" wrapText="true"/>
                                                <Label fx:id="renderingGpuStatus" wrapText="true"
                                                       styleClass="fxt-placeholder-text"/>
                                                <Label text="%SettingsPanel.auto-picks-gpu-rendering-on.text"
                                                       wrapText="true" styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.memory.title" iconLiteral="bi-memory">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.maximum-memory.text"/>
                                                        <ComboBox fx:id="maxMemory" id="settings-max-memory"/>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="memoryStatus" id="settings-memory-status" wrapText="true"/>
                                                <Label text="%SettingsPanel.more-memory-lets-you-open.text"
                                                       wrapText="true" styleClass="fxt-placeholder-text"/>
                                            </children>
                                        </SettingsCard>
                                            </children>
                                        </SettingsCardGrid>
                                    </children>
                                </VBox>
                                <VBox id="settings-group-editor" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="%SettingsPanel.editor.text" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#0e8fa3">
                                            <children>
                                        <SettingsCard title="%SettingsPanel.editor.title" iconLiteral="bi-pencil-square">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.xml-indent.text"/>
                                                        <Spinner fx:id="indentSpaces" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="8" initialValue="2"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.json-indent.text"/>
                                                        <Spinner fx:id="jsonIndent" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="8" initialValue="2"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="autoFormat" text="%SettingsPanel.autoFormat.text"/>
                                                <CheckBox fx:id="xsdPrettyPrint" text="%SettingsPanel.xsdPrettyPrint.text"/>
                                                <CheckBox fx:id="schematronPretty" text="%SettingsPanel.schematronPretty.text"/>
                                                <CheckBox fx:id="editedWithComment" id="settings-edited-with-comment"
                                                          text="%SettingsPanel.editedWithComment.text" wrapText="true">
                                                    <tooltip>
                                                        <Tooltip text="%SettingsPanel.editedWithComment.tooltip"/>
                                                    </tooltip>
                                                </CheckBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.recent-files-to-remember.text"/>
                                                        <Spinner fx:id="recentFilesLimit" id="settings-recent-files-limit" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="100" initialValue="20"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.editor-font.title" iconLiteral="bi-fonts">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.editor-font-family.text"/>
                                                        <ComboBox fx:id="editorFontFamily" id="settings-editor-font-family" editable="true"
                                                                  prefWidth="200"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.editor-font-size.text"/>
                                                        <Spinner fx:id="editorFontSize" id="settings-editor-font-size" editable="true" prefWidth="80">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="8" max="32" initialValue="11"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                        <Label text="%SettingsPanel.editor-line-spacing.text"/>
                                                        <Spinner fx:id="editorLineSpacing" id="settings-editor-line-spacing" editable="true" prefWidth="80">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.DoubleSpinnerValueFactory min="1.0" max="2.0" initialValue="1.0" amountToStepBy="0.1"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="editorRememberZoom" id="settings-editor-remember-zoom"
                                                          text="%SettingsPanel.editorRememberZoom.text"/>
                                                <Label fx:id="editorFontPreview" id="settings-editor-font-preview"
                                                       styleClass="fxt-editor-font-preview" maxWidth="Infinity"
                                                       text="&lt;order id=&quot;42&quot;&gt;0O 1lI {}[]&lt;/order&gt;"/>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Button text="%SettingsPanel.editor-font-reset.text" id="settings-editor-font-reset"
                                                                onAction="#onEditorFontReset" styleClass="fxt-tool-button">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-arrow-counterclockwise" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.syntax-colours.title" iconLiteral="bi-brush">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.syntax-scheme.text"/>
                                                        <ComboBox fx:id="syntaxScheme" id="settings-syntax-scheme" prefWidth="180"/>
                                                        <Button text="%SettingsPanel.syntax-reset.text" id="settings-syntax-reset"
                                                                onAction="#onSyntaxReset" styleClass="fxt-tool-button">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-arrow-counterclockwise" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="syntaxColorsTheme" styleClass="fxt-placeholder-text" wrapText="true" minHeight="-Infinity"/>
                                                <GridPane fx:id="syntaxRoles" id="settings-syntax-roles" hgap="8" vgap="4"/>
                                                <javafx.scene.text.TextFlow fx:id="syntaxPreview" id="settings-syntax-preview"
                                                                            styleClass="fxt-syntax-preview"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.grid-table-colours.title" iconLiteral="bi-table">
                                            <children>
                                                <CheckBox fx:id="gridCustomColors" id="settings-grid-custom-colors"
                                                          text="%SettingsPanel.gridCustomColors.text"/>
                                                <Label fx:id="gridColorsTheme" styleClass="fxt-placeholder-text" wrapText="true"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.table-header.text" minWidth="110"/>
                                                        <ColorPicker fx:id="gridHeaderColor" id="settings-grid-header-color"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.missing-cell.text" minWidth="110"/>
                                                        <ColorPicker fx:id="gridMissingColor" id="settings-grid-missing-color"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.selection.text" minWidth="110"/>
                                                        <ColorPicker fx:id="gridSelectionColor" id="settings-grid-selection-color"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.focus-frame.text" minWidth="110"/>
                                                        <ColorPicker fx:id="gridFocusColor" id="settings-grid-focus-color"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.templates.title" iconLiteral="bi-file-earmark-plus">
                                            <children>
                                                <Label text="%SettingsPanel.templates-directory.text"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="templatesDir"
                                                                   promptText="%SettingsPanel.templatesDir.promptText"
                                                                   HBox.hgrow="ALWAYS"/>
                                                        <Button text="…" onAction="#onBrowseTemplatesDir"/>
                                                    </children>
                                                </HBox>
                                                <Label text="%SettingsPanel.your-templates.text"/>
                                                <ListView fx:id="templatesList" prefHeight="140" maxWidth="Infinity"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Button text="%SettingsPanel.new.text" styleClass="fxt-tool-button"
                                                                onAction="#onNewTemplate">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-plus-lg" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                        <Button fx:id="editTemplateButton" text="%SettingsPanel.editTemplateButton.text"
                                                                styleClass="fxt-tool-button" onAction="#onEditTemplate">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-pencil" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                        <Button fx:id="deleteTemplateButton" text="%SettingsPanel.deleteTemplateButton.text"
                                                                styleClass="fxt-tool-button" onAction="#onDeleteTemplate">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-trash" iconSize="16"/>
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.user-info.title" iconLiteral="bi-person">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.name.text"/>
                                                        <TextField fx:id="userName" promptText="%SettingsPanel.userName.promptText"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.email.text"/>
                                                        <TextField fx:id="userEmail" promptText="%SettingsPanel.userEmail.promptText"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.company.text"/>
                                                        <TextField fx:id="userCompany" promptText="%SettingsPanel.userCompany.promptText"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                            </children>
                                        </SettingsCardGrid>
                                    </children>
                                </VBox>
                                <VBox id="settings-group-schemas" spacing="12" styleClass="fxt-settings-group">
                                    <children>
                                        <Label text="%SettingsPanel.schemas-validation.text" styleClass="fxt-settings-group-title"/>
                                        <SettingsCardGrid color="#6f42c1">
                                            <children>
                                        <SettingsCard title="%SettingsPanel.xsd.title" iconLiteral="bi-diagram-3">
                                            <children>
                                                <CheckBox fx:id="xsdAutoSave" text="%SettingsPanel.xsdAutoSave.text"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.interval-min.text"/>
                                                        <Spinner fx:id="xsdAutoSaveInterval" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="120" initialValue="5"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="xsdBackup" text="%SettingsPanel.xsdBackup.text"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.keep-versions.text"/>
                                                        <Spinner fx:id="xsdBackupVersions" editable="true">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="50" initialValue="5"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="backupSeparateDir" text="%SettingsPanel.backupSeparateDir.text"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="backupDir" promptText="%SettingsPanel.backupDir.promptText"
                                                                   HBox.hgrow="ALWAYS"/>
                                                        <Button text="…" onAction="#onBrowseBackupDir"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.schema-library.title" iconLiteral="bi-collection">
                                            <children>
                                                <CheckBox fx:id="schemaLibraryAutoBind" id="settings-schema-library-autobind"
                                                          text="%SettingsPanel.schemaLibraryAutoBind.text"
                                                          wrapText="true"/>
                                                <Label fx:id="libraryFile" wrapText="true" styleClass="fxt-lib-status"/>
                                                <Hyperlink id="settings-manage-schema-cache"
                                                           text="%SettingsPanel.settings-manage-schema-cache.text" onAction="#onManageSchemaCache">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-collection" iconSize="16"/>
                                                    </graphic>
                                                </Hyperlink>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.parser.title" iconLiteral="bi-cpu">
                                            <children>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="%SettingsPanel.xml-parser.text"/>
                                                        <ComboBox fx:id="parserType"/>
                                                    </children>
                                                </HBox>
                                                <CheckBox fx:id="xsltExtensions" text="%SettingsPanel.xsltExtensions.text"/>
                                            </children>
                                        </SettingsCard>
                                        <SettingsCard title="%SettingsPanel.standards.title" iconLiteral="bi-sliders">
                                            <children>
                                                <CheckBox fx:id="standardsExpertMode" id="settings-standards-expert"
                                                          text="%SettingsPanel.standardsExpertMode.text" wrapText="true"/>
                                                <Label text="%SettingsPanel.standards.hint.text" wrapText="true"
                                                       styleClass="fxt-text-xs"/>
