<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.inspector.DocLanguagesEditor?>

<!--
  The shell inspector (right-hand Properties pane): pinned PROPERTIES header and node header,
  then the flat sections in a vertical scroll pane. Loaded by InspectorPanel via the fx:root
  pattern (FxmlViews.load); InspectorPanel is root and controller.
  A key/value row is an HBox "fxt-inspector-row": a 92px key label plus the control, which grows.
  InspectorPanel shows/hides whole sections and single rows (those with an fx:id) per node type,
  and keeps everything data-driven in code: combo choices, table cell factories, list cells, the
  commit listeners (all edits go through the EditorHost command stack) and the AppInfoFieldsEditor.
  Stylesheets are inherited from the shell root.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-inspector"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="PROPERTIES" styleClass="fxt-inspector-header"/>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-node-header">
            <children>
                <Label fx:id="nodeHeaderName" text="—" styleClass="fxt-inspector-node-name"/>
                <Label fx:id="nodeHeaderKind" styleClass="fxt-inspector-kind-chip"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="validationBadge" id="inspector-validation-badge" visible="false" managed="false"/>
            </children>
        </HBox>

        <!-- Empty state: says what to do to see properties (shown by populateCaret). -->
        <Label fx:id="emptyHint" id="inspector-empty-hint" wrapText="true" visible="false" managed="false"
               styleClass="fxt-placeholder-text, fxt-inspector-empty-hint"/>

        <!-- The sections can exceed the window height; the header above stays pinned. -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" minHeight="0"
                    styleClass="fxt-inspector-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="8">
                    <children>
                        <TitledPane text="NODE &amp; XPATH" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Kind" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <Label fx:id="kindValue" text="—" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-value"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Name" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="nameField" id="inspector-name" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <!-- XPath: key + copy buttons, the value on its own full-width line (click copies it) -->
                                        <VBox spacing="2" styleClass="fxt-inspector-row">
                                            <children>
                                                <HBox spacing="4" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="XPath" minWidth="92" styleClass="fxt-inspector-key"/>
                                                        <Button fx:id="copyXPathButton" styleClass="fxt-inspector-icon-button" onAction="#copyXPathToClipboard">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-clipboard" iconSize="13"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="Copy XPath"/>
                                                            </tooltip>
                                                        </Button>
                                                        <Button fx:id="copyNodeButton" styleClass="fxt-inspector-icon-button" onAction="#copyNodeToClipboard">
                                                            <graphic>
                                                                <IconifyIcon iconLiteral="bi-clipboard-data" iconSize="13"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="Copy Node (XML)"/>
                                                            </tooltip>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="xpathValue" id="inspector-xpath-value" text="—" wrapText="true" maxWidth="Infinity"
                                                       styleClass="fxt-inspector-value" onMouseClicked="#copyXPathToClipboard">
                                                    <tooltip>
                                                        <Tooltip text="Click to copy XPath"/>
                                                    </tooltip>
                                                </Label>
                                            </children>
                                        </VBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Depth" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <Label fx:id="depthValue" text="—" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-value"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <TitledPane fx:id="typeFacetsSection" text="TYPE &amp; FACETS" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <HBox fx:id="typeRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Type" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <ComboBox fx:id="typeCombo" id="inspector-type" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <VBox fx:id="facetBox" spacing="4">
                                            <children>
                                                <TableView fx:id="facetTable" editable="true" prefHeight="120" styleClass="fxt-facet-table">
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                                    </columnResizePolicy>
                                                    <placeholder>
                                                        <Label text="No facets"/>
                                                    </placeholder>
                                                    <columns>
                                                        <TableColumn fx:id="facetNameCol" text="Facet" prefWidth="140"/>
                                                        <TableColumn fx:id="facetValueCol" text="Value" prefWidth="180" editable="true"/>
                                                    </columns>
                                                </TableView>
                                                <!-- Add a facet (type + value) / delete the selected one -->
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <ComboBox fx:id="facetTypeCombo" id="inspector-facet-type" styleClass="fxt-inspector-edit"/>
                                                        <TextField fx:id="facetValueField" id="inspector-facet-value" promptText="value" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                                        <Button id="inspector-facet-add" text="Add" minWidth="-Infinity" onAction="#onAddFacet"/>
                                                        <Button id="inspector-facet-delete" text="Delete" minWidth="-Infinity" onAction="#onDeleteFacet"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <!-- XML element namespace (prefix + URI) -->
                        <TitledPane fx:id="namespaceSection" text="NAMESPACE" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Prefix" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="nsPrefixField" id="inspector-ns-prefix" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="URI" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="nsUriField" id="inspector-ns-uri" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <!-- XML-instance / JSON value and attributes -->
                        <TitledPane fx:id="valueAttrSection" text="VALUE &amp; ATTRIBUTES" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <VBox fx:id="xmlTextBox" spacing="4">
                                            <children>
                                                <Label fx:id="xmlTextLabel" text="Text" styleClass="fxt-inspector-key"/>
                                                <TextArea fx:id="xmlTextArea" id="inspector-xml-text" wrapText="true" prefRowCount="2" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </VBox>
                                        <VBox fx:id="xmlAttrBox" spacing="4">
                                            <children>
                                                <Label text="Attributes" styleClass="fxt-inspector-key"/>
                                                <TableView fx:id="xmlAttrTable" id="inspector-xml-attrs" editable="true" prefHeight="120" styleClass="fxt-facet-table">
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                                    </columnResizePolicy>
                                                    <placeholder>
                                                        <Label text="No attributes"/>
                                                    </placeholder>
                                                    <columns>
                                                        <TableColumn fx:id="attrNameCol" text="Attribute" prefWidth="140" editable="true"/>
                                                        <TableColumn fx:id="attrValueCol" text="Value" editable="true"/>
                                                    </columns>
                                                </TableView>
                                                <!-- Add an attribute (name + value) / delete the selected one -->
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="attrNameField" id="inspector-xml-attr-name" promptText="name" styleClass="fxt-inspector-edit"/>
                                                        <TextField fx:id="attrValueField" id="inspector-xml-attr-value" promptText="value" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                                        <Button id="inspector-xml-attr-add" text="Add" minWidth="-Infinity" onAction="#onAddXmlAttribute"/>
                                                        <Button id="inspector-xml-attr-delete" text="Delete" minWidth="-Infinity" onAction="#onDeleteXmlAttribute"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <!-- XSD-derived, read-only info for an XML element when a schema is bound -->
                                        <VBox fx:id="xmlSchemaBox" spacing="4">
                                            <children>
                                                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                                    <children>
                                                        <Label text="Schema type" minWidth="92" styleClass="fxt-inspector-key"/>
                                                        <Label fx:id="xmlSchemaTypeValue" text="—" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-value"/>
                                                    </children>
                                                </HBox>
                                                <!-- "Documentation" sits above its (often long, wrapping) text -->
                                                <Label text="Documentation" styleClass="fxt-inspector-key"/>
                                                <Label fx:id="xmlSchemaDocValue" text="—" wrapText="true" styleClass="fxt-inspector-value"/>
                                                <Label text="Valid children (double-click to add)" styleClass="fxt-inspector-key"/>
                                                <ListView fx:id="validChildrenList" id="inspector-valid-children" prefHeight="90" onMouseClicked="#onValidChildClicked">
                                                    <placeholder>
                                                        <Label text="—"/>
                                                    </placeholder>
                                                </ListView>
                                                <Label text="Example values (double-click to set)" styleClass="fxt-inspector-key"/>
                                                <ListView fx:id="exampleValuesList" id="inspector-example-values" prefHeight="70" onMouseClicked="#onExampleValueClicked">
                                                    <placeholder>
                                                        <Label text="—"/>
                                                    </placeholder>
                                                </ListView>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <!-- Comment / CDATA / text node content -->
                        <TitledPane fx:id="contentSection" text="CONTENT" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <Label fx:id="contentLabel" text="Content" styleClass="fxt-inspector-key"/>
                                        <TextArea fx:id="contentArea" id="inspector-content" wrapText="true" prefRowCount="3" styleClass="fxt-inspector-edit"/>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <TitledPane fx:id="piSection" text="PROCESSING INSTRUCTION" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Target" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="piTargetField" id="inspector-pi-target" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Data" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="piDataField" id="inspector-pi-data" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <TitledPane fx:id="declarationSection" text="XML DECLARATION" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Version" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="declVersionField" id="inspector-decl-version" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Encoding" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="declEncodingField" id="inspector-decl-encoding" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Standalone" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <ComboBox fx:id="declStandaloneCombo" id="inspector-decl-standalone" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <!-- Rows are toggled per node type -->
                        <TitledPane fx:id="cardUseSection" text="CARDINALITY &amp; USE" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <HBox fx:id="minRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="minOccurs" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <Spinner fx:id="minSpinner" id="inspector-min" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit">
                                                    <valueFactory>
                                                        <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="9999" initialValue="1"/>
                                                    </valueFactory>
                                                </Spinner>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="maxRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="maxOccurs" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <HBox spacing="8" alignment="CENTER_LEFT" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Spinner fx:id="maxSpinner" id="inspector-max" editable="true" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit">
                                                            <valueFactory>
                                                                <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="9999" initialValue="1"/>
                                                            </valueFactory>
                                                        </Spinner>
                                                        <CheckBox fx:id="unboundedCheck" text="unbounded"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="useRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Use" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <ComboBox fx:id="useCombo" id="inspector-use" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="formRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Form" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <ComboBox fx:id="formCombo" id="inspector-form" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="nillableRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Nillable" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <CheckBox fx:id="nillableCheck" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="abstractRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Abstract" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <CheckBox fx:id="abstractCheck" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="fixedRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Fixed" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="fixedField" id="inspector-fixed" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="substRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Subst. Group" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="substField" id="inspector-subst" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <!-- default/ref/block/final/mixed + xs:any wildcard; each row is toggled per node type -->
                        <TitledPane fx:id="advancedSection" text="ADVANCED" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <HBox fx:id="defaultRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Default" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="defaultField" id="inspector-default" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="refRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Ref" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="refField" id="inspector-ref" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="blockRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Block" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="blockField" id="inspector-block" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="finalRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Final" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="finalField" id="inspector-final" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="mixedRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Mixed" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <CheckBox fx:id="mixedCheck" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="wildcardNsRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Namespace" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="wildcardNsField" id="inspector-wildcard-ns" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="wildcardProcessRow" spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Process" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <ComboBox fx:id="wildcardProcessCombo" id="inspector-wildcard-process" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <!-- Schema-level attributes, shown only for the xs:schema root -->
                        <TitledPane fx:id="schemaSection" text="SCHEMA" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Target NS" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="schemaTargetNsField" id="inspector-schema-targetns" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Version" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <TextField fx:id="schemaVersionField" id="inspector-schema-version" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Element form" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <ComboBox fx:id="schemaElementFormCombo" id="inspector-schema-elementform" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-inspector-row">
                                            <children>
                                                <Label text="Attr form" minWidth="92" styleClass="fxt-inspector-key"/>
                                                <ComboBox fx:id="schemaAttributeFormCombo" id="inspector-schema-attrform" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-inspector-edit"/>
                                            </children>
                                        </HBox>
                                        <!-- xs:import / xs:include directives with add/delete -->
                                        <VBox spacing="4">
                                            <children>
                                                <Label text="Imports / Includes" styleClass="fxt-inspector-sub-label"/>
                                                <ListView fx:id="schemaRefList" id="inspector-schema-refs" prefHeight="90" styleClass="fxt-facet-table">
                                                    <placeholder>
                                                        <Label text="No imports/includes"/>
                                                    </placeholder>
                                                </ListView>
                                                <ComboBox fx:id="schemaRefKindCombo" id="inspector-schema-ref-kind" styleClass="fxt-inspector-edit"/>
                                                <TextField fx:id="schemaRefNsField" id="inspector-schema-ref-ns" promptText="namespace (import)" styleClass="fxt-inspector-edit"/>
                                                <TextField fx:id="schemaRefLocationField" id="inspector-schema-ref-location" promptText="schemaLocation" styleClass="fxt-inspector-edit"/>
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Button id="inspector-schema-ref-add" text="Add" minWidth="-Infinity" onAction="#onAddSchemaRef"/>
                                                        <Button id="inspector-schema-ref-delete" text="Delete" minWidth="-Infinity" onAction="#onDeleteSchemaRef"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <!-- Identity constraints / assertions of the selected node -->
                        <TitledPane fx:id="constraintsSection" text="CONSTRAINTS" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox spacing="4">
                                    <children>
                                        <TableView fx:id="constraintsTable" prefHeight="110" styleClass="fxt-facet-table">
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                            </columnResizePolicy>
                                            <placeholder>
                                                <Label text="No constraints"/>
                                            </placeholder>
                                            <columns>
                                                <TableColumn fx:id="constraintKindCol" text="Kind" prefWidth="70"/>
                                                <TableColumn fx:id="constraintNameCol" text="Name" prefWidth="90"/>
                                                <TableColumn fx:id="constraintDetailCol" text="Detail" prefWidth="200"/>
                                            </columns>
                                        </TableView>
                                        <Button fx:id="deleteConstraintButton" text="Delete constraint" minWidth="-Infinity" onAction="#onDeleteConstraint"/>
                                        <!-- Add an identity constraint (key/unique/keyref) to the selected element -->
                                        <VBox fx:id="constraintAddBox" spacing="4">
                                            <children>
                                                <Label text="Add identity constraint" styleClass="fxt-inspector-sub-label"/>
                                                <ComboBox fx:id="constraintKindCombo" id="inspector-constraint-kind" styleClass="fxt-inspector-edit"/>
                                                <TextField fx:id="constraintNameField" id="inspector-constraint-name" promptText="name" styleClass="fxt-inspector-edit"/>
                                                <TextField fx:id="constraintSelectorField" id="inspector-constraint-selector" promptText="selector XPath, e.g. .//item" styleClass="fxt-inspector-edit"/>
                                                <TextField fx:id="constraintFieldField" id="inspector-constraint-field" promptText="field XPath, e.g. @id" styleClass="fxt-inspector-edit"/>
                                                <TextField fx:id="constraintReferField" id="inspector-constraint-refer" promptText="refer (keyref only)" disable="true" styleClass="fxt-inspector-edit"/>
                                                <Button id="inspector-constraint-add" text="Add constraint" minWidth="-Infinity" onAction="#onAddConstraint"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <TitledPane fx:id="docSection" text="DOCUMENTATION &amp; REFS" expanded="true" styleClass="fxt-inspector-section">
                            <content>
                                <VBox fx:id="docBox" spacing="4">
                                    <children>
                                        <DocLanguagesEditor fx:id="docEditor" id="inspector-doc"/>
                                        <Label text="App info (@tags)" styleClass="fxt-inspector-sub-label"/>
                                        <!-- InspectorPanel inserts the AppInfoFieldsEditor here (it needs constructor arguments) -->
                                        <!-- Nested sub-pane: shares the section look but is not a top-level fxt-inspector-section -->
                                        <TitledPane text="Raw appinfo" expanded="false" styleClass="fxt-inspector-subsection">
                                            <content>
                                                <TextArea fx:id="appinfoArea" id="inspector-appinfo" wrapText="true" prefRowCount="2"
                                                          promptText="xs:appinfo (raw display string)" styleClass="fxt-inspector-edit"/>
                                            </content>
                                        </TitledPane>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</fx:root>
