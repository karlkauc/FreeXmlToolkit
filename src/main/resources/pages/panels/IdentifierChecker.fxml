<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  The identifier checker of the industry, FundsXML and PK-Meldewesen panels: kind, value, check result and, for an LEI,
  the GLEIF lookup. Loaded by IdentifierChecker (fx:root); the kinds are set in code.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="6" styleClass="fxt-tp-section-body"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ComboBox fx:id="kindCombo" id="industry-identifier-kind" maxWidth="Infinity" styleClass="fxt-neutral-combo"
                  accessibleText="%IdentifierChecker.kindCombo.accessibleText"/>
        <TextField fx:id="valueField" id="industry-identifier" promptText="%IndustryPanel.identifierField.promptText"/>
        <Label fx:id="result" id="industry-identifier-result" wrapText="true" minHeight="-Infinity"/>
        <Button fx:id="gleifButton" id="industry-identifier-gleif" text="%IndustryPanel.gleifButton.text"
                onAction="#onGleifLookup" styleClass="fxt-secondary-button" mnemonicParsing="false">
            <tooltip>
                <Tooltip text="%IndustryPanel.gleifButton.tooltip"/>
            </tooltip>
            <graphic>
                <IconifyIcon iconLiteral="bi-globe2" iconSize="14"/>
            </graphic>
        </Button>
        <VBox fx:id="gleifResult" id="industry-identifier-gleif-result" spacing="2"/>
    </children>
</fx:root>
