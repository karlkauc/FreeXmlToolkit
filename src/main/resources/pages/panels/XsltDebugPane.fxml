<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  The DEBUG pane of the editor's bottom dock: a header with the run controls (Continue, Step
  Into/Over/Out, Restart, Stop, Pause on entry, Show in editor, ✕ = end session) and the status
  line, above a two-way split of two tab groups: Variables | Watch on the left (the state you
  read on every pause), Call Stack | Messages | Breakpoints on the right (navigation and log).
  The tab contents are set in code because the Breakpoints view needs the session; the divider
  position is persisted (editor.debugPane.divider). Loaded by XsltDebugPane via the fx:root
  pattern (FxmlViews.load); XsltDebugPane is root and controller.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-debug-pane"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox spacing="6" alignment="CENTER_LEFT" styleClass="fxt-output-header">
            <children>
                <Label text="DEBUG" styleClass="fxt-output-title"/>
                <Label fx:id="status" id="debug-status" text="Ready." styleClass="fxt-output-status"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="continueButton" id="debug-continue" text="Continue"
                        styleClass="fxt-sp-action, fxt-output-action" onAction="#onContinue">
                    <graphic><IconifyIcon iconLiteral="bi-play-fill" iconSize="14"/></graphic>
                    <tooltip><Tooltip text="Continue to the next breakpoint (F5)"/></tooltip>
                </Button>
                <Button fx:id="stepIntoButton" id="debug-step-into" text="Step Into"
                        styleClass="fxt-sp-action, fxt-output-action" onAction="#onStepInto">
                    <graphic><IconifyIcon iconLiteral="bi-box-arrow-in-down-right" iconSize="14"/></graphic>
                    <tooltip><Tooltip text="Step into the current instruction (F7)"/></tooltip>
                </Button>
                <Button fx:id="stepOverButton" id="debug-step-over" text="Step Over"
                        styleClass="fxt-sp-action, fxt-output-action" onAction="#onStepOver">
                    <graphic><IconifyIcon iconLiteral="bi-arrow-right-short" iconSize="14"/></graphic>
                    <tooltip><Tooltip text="Execute the current instruction without descending (F8)"/></tooltip>
                </Button>
                <Button fx:id="stepOutButton" id="debug-step-out" text="Step Out"
                        styleClass="fxt-sp-action, fxt-output-action" onAction="#onStepOut">
                    <graphic><IconifyIcon iconLiteral="bi-box-arrow-up-right" iconSize="14"/></graphic>
                    <tooltip><Tooltip text="Run until the current template / function returns (Shift+F8)"/></tooltip>
                </Button>
                <Button fx:id="restartButton" id="debug-restart" text="Restart"
                        styleClass="fxt-sp-action, fxt-output-action" onAction="#onRestart">
                    <graphic><IconifyIcon iconLiteral="bi-arrow-counterclockwise" iconSize="14"/></graphic>
                    <tooltip><Tooltip text="Run again from the start, keeping the breakpoints (re-reads the stylesheet)"/></tooltip>
                </Button>
                <Button fx:id="stopButton" id="debug-stop" text="Stop"
                        styleClass="fxt-sp-action, fxt-output-action" onAction="#onStop">
                    <graphic><IconifyIcon iconLiteral="bi-stop-fill" iconSize="14"/></graphic>
                    <tooltip><Tooltip text="Abort the running transformation"/></tooltip>
                </Button>
                <CheckBox fx:id="pauseOnEntry" id="debug-pause-on-entry" text="Pause on entry" onAction="#onPauseOnEntry">
                    <tooltip><Tooltip text="Stop at the first instruction of the next run / restart"/></tooltip>
                </CheckBox>
                <ToggleButton fx:id="muteToggle" id="debug-mute" text="Mute"
                              styleClass="fxt-sp-action, fxt-output-action" onAction="#onMute">
                    <graphic><IconifyIcon iconLiteral="bi-slash-circle" iconSize="14"/></graphic>
                    <tooltip><Tooltip text="Mute all breakpoints: the run does not stop at them (steps and Pause still work)"/></tooltip>
                </ToggleButton>
                <Button fx:id="showButton" id="debug-show-in-editor" text="Show in editor"
                        styleClass="fxt-sp-action, fxt-output-action" onAction="#onShowInEditor">
                    <graphic><IconifyIcon iconLiteral="bi-eye" iconSize="14"/></graphic>
                    <tooltip><Tooltip text="Jump the editor to the paused line"/></tooltip>
                </Button>
                <Button fx:id="closeButton" id="debug-close" styleClass="fxt-sp-action" onAction="#onClose">
                    <graphic><IconifyIcon iconLiteral="bi-x" iconSize="14"/></graphic>
                    <tooltip><Tooltip text="End the debug session and close this pane"/></tooltip>
                </Button>
            </children>
        </HBox>
        <SplitPane fx:id="panels" id="debug-panels" orientation="HORIZONTAL" VBox.vgrow="ALWAYS"
                   dividerPositions="0.5">
            <items>
                <TabPane fx:id="leftTabs" id="debug-left-tabs" styleClass="fxt-analysis-tabs, fxt-debug-tabs"
                         tabClosingPolicy="UNAVAILABLE" minWidth="260">
                    <tabs>
                        <Tab fx:id="variablesTab" id="debug-tab-variables" text="Variables" closable="false">
                            <graphic><IconifyIcon iconLiteral="bi-braces" iconSize="14"/></graphic>
                        </Tab>
                        <Tab fx:id="watchTab" id="debug-tab-watch" text="Watch" closable="false">
                            <graphic><IconifyIcon iconLiteral="bi-eye" iconSize="14"/></graphic>
                        </Tab>
                    </tabs>
                </TabPane>
                <TabPane fx:id="rightTabs" id="debug-right-tabs" styleClass="fxt-analysis-tabs, fxt-debug-tabs"
                         tabClosingPolicy="UNAVAILABLE" minWidth="340">
                    <tabs>
                        <Tab fx:id="callStackTab" id="debug-tab-call-stack" text="Call Stack" closable="false">
                            <graphic><IconifyIcon iconLiteral="bi-list-nested" iconSize="14"/></graphic>
                        </Tab>
                        <Tab fx:id="messagesTab" id="debug-tab-messages" text="Messages" closable="false">
                            <graphic><IconifyIcon iconLiteral="bi-chat-left-text" iconSize="14"/></graphic>
                        </Tab>
                        <Tab fx:id="breakpointsTab" id="debug-tab-breakpoints" text="Breakpoints" closable="false">
                            <graphic><IconifyIcon iconLiteral="bi-record-circle" iconSize="14"/></graphic>
                        </Tab>
                    </tabs>
                </TabPane>
            </items>
        </SplitPane>
    </children>
</fx:root>
