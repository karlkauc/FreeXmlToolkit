<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.plugins.IdentifierChecker?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionButton?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionList?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelHeader?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelSection?>

<!--
  Side panel of the industry plugins (ISO 20022, ebInterface, FinDatEx, XBRL, KAG, ESMA): about text,
  the active document (what it is, counts of its last check, check + optional HTML report), the
  plugin's tools, optional settings and an identifier checker. Loaded by IndustryPanel (fx:root);
  title, texts, the tool rows, the options and the identifier kinds are set in code.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-industry-panel"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <SidePanelHeader fx:id="header" title="%IndustryPanel.header.title"/>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge" VBox.vgrow="ALWAYS">
            <content>
                <VBox>
                    <children>
                        <SidePanelSection title="%IndustryPanel.about.title">
                            <children>
                                <VBox styleClass="fxt-tp-section-body">
                                    <children>
                                        <Label fx:id="about" id="industry-about" wrapText="true" minHeight="-Infinity"
                                               styleClass="fxt-placeholder-text"/>
                                    </children>
                                </VBox>
                            </children>
                        </SidePanelSection>
                        <SidePanelSection title="%IndustryPanel.active-document.title">
                            <children>
                                <VBox spacing="6" styleClass="fxt-tp-section-body">
                                    <children>
                                        <Label fx:id="documentSummary" id="industry-document" wrapText="true"
                                               minHeight="-Infinity"/>
                                        <Label fx:id="checkCounts" id="industry-check-counts" wrapText="true"
                                               minHeight="-Infinity" visible="false" managed="false"/>
                                        <Hyperlink fx:id="showProblemsLink" id="industry-show-problems"
                                                   text="%IndustryPanel.showProblemsLink.text"
                                                   visible="false" managed="false" onAction="#onShowProblems"/>
                                    </children>
                                </VBox>
                                <PanelActionList id="industry-check-actions">
                                    <children>
                                        <PanelActionButton fx:id="checkButton" id="industry-check" iconLiteral="bi-check2-circle"
                                                           text="%IndustryPanel.checkButton.text" color="CREATE" primary="true"
                                                           onAction="#onCheck"/>
                                        <PanelActionButton fx:id="reportButton" id="industry-report" iconLiteral="bi-clipboard-data"
                                                           text="%IndustryPanel.reportButton.text" color="NAVIGATE"
                                                           onAction="#onReport"/>
                                    </children>
                                </PanelActionList>
                            </children>
                        </SidePanelSection>
                        <SidePanelSection fx:id="toolsSection" title="%IndustryPanel.toolsSection.title">
                            <children>
                                <PanelActionList fx:id="actions" id="industry-actions"/>
                            </children>
                        </SidePanelSection>
                        <SidePanelSection fx:id="optionsSection" title="%IndustryPanel.optionsSection.title">
                            <children>
                                <VBox fx:id="optionsBody" spacing="6" styleClass="fxt-tp-section-body"/>
                            </children>
                        </SidePanelSection>
                        <SidePanelSection fx:id="identifierSection" title="%IndustryPanel.identifierSection.title">
                            <children>
                                <IdentifierChecker fx:id="identifierChecker"/>
                            </children>
                        </SidePanelSection>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
        <VBox spacing="4" styleClass="fxt-tp-section-body">
            <children>
                <ProgressBar fx:id="progress" id="industry-progress" maxWidth="Infinity" visible="false" managed="false"/>
                <Label fx:id="status" id="industry-status" wrapText="true" minHeight="-Infinity"
                       styleClass="fxt-placeholder-text"/>
            </children>
        </VBox>
    </children>
</fx:root>
