<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelProgress?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.search.SearchResultsTree?>

<!--
  Text mode of the Search side panel ("Find in Files"): query row with the option toggles, the
  collapsible replace row, the folder + glob scope, status, progress and the results tree.
  Loaded by TextSearchPane via the fx:root pattern (FxmlViews.load); TextSearchPane is root and
  controller and restores the saved options.
-->
<fx:root type="javafx.scene.layout.VBox" spacing="6" styleClass="fxt-search-text-pane"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <TextField fx:id="queryField" id="search-query" promptText="Search"/>
        <!-- Options as labelled switches with a visible on/off state (UX plan 2.6); wraps when narrow -->
        <FlowPane hgap="4" vgap="4" styleClass="fxt-search-options">
            <children>
                <ToggleButton fx:id="caseToggle" id="search-opt-case" text="Match case"
                              styleClass="fxt-search-option-toggle">
                    <tooltip>
                        <Tooltip text="Match upper and lower case exactly"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="wordToggle" id="search-opt-word" text="Whole word"
                              styleClass="fxt-search-option-toggle">
                    <tooltip>
                        <Tooltip text="Match whole words only"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="regexToggle" id="search-opt-regex" text="Regex"
                              styleClass="fxt-search-option-toggle">
                    <tooltip>
                        <Tooltip text="Treat the search text as a regular expression"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="replaceToggle" id="search-replace-toggle" text="Replace"
                              styleClass="fxt-search-option-toggle">
                    <tooltip>
                        <Tooltip text="Show the replace field"/>
                    </tooltip>
                </ToggleButton>
            </children>
        </FlowPane>

        <!-- Replace row: collapsed until requested -->
        <VBox fx:id="replaceRow" spacing="4" visible="false" managed="false">
            <children>
                <TextField fx:id="replaceField" id="search-replace" promptText="Replace"/>
                <Button fx:id="replaceButton" id="search-replace-button" text="Replace…" maxWidth="Infinity"
                        styleClass="fxt-primary-button" onAction="#onReplaceChecked"/>
            </children>
        </VBox>

        <!-- Scope: folder and file globs, each with its own caption and line -->
        <Label text="Search in folder" styleClass="fxt-sp-section-label"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="folderLabel" id="search-folder" text="No folder — choose one" maxWidth="Infinity"
                       styleClass="fxt-vp-source-name" HBox.hgrow="ALWAYS"/>
                <Button styleClass="fxt-tool-button" onAction="#onChooseFolder">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-folder2-open"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Choose folder to search"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>
        <Label text="Files matching" styleClass="fxt-sp-section-label"/>
        <TextField fx:id="globField" id="search-glob" promptText="File globs, e.g. *.xml,*.xsd"/>

        <Label fx:id="status" text="Type to search" wrapText="true" styleClass="fxt-vp-status"/>
        <PanelProgress fx:id="progress"/>
        <SearchResultsTree fx:id="resultsTree" VBox.vgrow="ALWAYS"/>
    </children>
</fx:root>
