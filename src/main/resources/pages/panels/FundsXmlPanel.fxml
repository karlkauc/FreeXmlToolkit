<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionButton?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionList?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelHeader?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelSection?>

<!--
  FundsXML activity side panel: manage versions, validate the active document, docs/resources.
  Loaded by FundsXmlPanel via the fx:root pattern (FxmlViews.load); FundsXmlPanel is root and
  controller. The installed versions are filled in code.
-->
<fx:root type="javafx.scene.layout.VBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <SidePanelHeader title="%FundsXmlPanel.fundsxml.title"/>

        <SidePanelSection title="%FundsXmlPanel.management.title">
            <children>
                <VBox spacing="4" styleClass="fxt-tp-section-body">
                    <children>
                        <Label text="%FundsXmlPanel.active-version.text"/>
                        <ComboBox fx:id="versionCombo" onAction="#onVersionSelected"/>
                    </children>
                </VBox>
                <PanelActionList>
                    <children>
                        <PanelActionButton id="fundsxml-download" iconLiteral="bi-cloud-arrow-down"
                                           text="%FundsXmlPanel.fundsxml-download.text" color="TOOL" onAction="#onDownload"/>
                    </children>
                </PanelActionList>
            </children>
        </SidePanelSection>

        <SidePanelSection title="%FundsXmlPanel.validate.title">
            <children>
                <PanelActionList>
                    <children>
                        <PanelActionButton id="fundsxml-validate" iconLiteral="bi-check2-circle"
                                           text="%FundsXmlPanel.fundsxml-validate.text" color="CREATE" onAction="#onValidate"/>
                        <PanelActionButton id="fundsxml-dq" iconLiteral="bi-clipboard2-check"
                                           text="%FundsXmlPanel.fundsxml-dq.text" color="CREATE" onAction="#onDataQuality"/>
                        <PanelActionButton id="fundsxml-grid-setup" iconLiteral="bi-calculator"
                                           text="%FundsXmlPanel.fundsxml-grid-setup.text" color="TOOL" onAction="#onGridSetup"/>
                    </children>
                </PanelActionList>
            </children>
        </SidePanelSection>

        <SidePanelSection title="%FundsXmlPanel.docs-resources.title">
            <children>
                <PanelActionList>
                    <children>
                        <PanelActionButton id="fundsxml-open-schema" iconLiteral="bi-file-earmark-code"
                                           text="%FundsXmlPanel.fundsxml-open-schema.text" color="NAVIGATE" onAction="#onOpenSchema"/>
                        <PanelActionButton id="fundsxml-generate-docs" iconLiteral="bi-file-earmark-text"
                                           text="%FundsXmlPanel.fundsxml-generate-docs.text" color="CREATE"
                                           onAction="#onGenerateDocs"/>
                        <PanelActionButton id="fundsxml-examples-folder" iconLiteral="bi-folder2-open"
                                           text="%FundsXmlPanel.fundsxml-examples-folder.text" color="NAVIGATE"
                                           onAction="#onOpenExamplesFolder"/>
                        <PanelActionButton id="fundsxml-schema-folder" iconLiteral="bi-folder2-open"
                                           text="%FundsXmlPanel.fundsxml-schema-folder.text" color="NAVIGATE" onAction="#onOpenSchemaFolder"/>
                        <PanelActionButton id="fundsxml-schematron-folder" iconLiteral="bi-folder2-open"
                                           text="%FundsXmlPanel.fundsxml-schematron-folder.text" color="NAVIGATE"
                                           onAction="#onOpenSchematronFolder"/>
                        <PanelActionButton id="fundsxml-online-docs" iconLiteral="bi-globe" text="%FundsXmlPanel.fundsxml-online-docs.text"
                                           color="NAVIGATE" onAction="#onOpenOnlineDocs"/>
                    </children>
                </PanelActionList>
            </children>
        </SidePanelSection>

        <VBox VBox.vgrow="ALWAYS"/>

        <VBox spacing="6" styleClass="fxt-tp-section-body">
            <children>
                <ProgressBar fx:id="progress" maxWidth="Infinity"/>
                <Label fx:id="status" wrapText="true" styleClass="fxt-placeholder-text"/>
            </children>
        </VBox>
    </children>
</fx:root>
