<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionButton?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionList?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelProgress?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelHeader?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelSection?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SourceRow?>

<!--
  Validation activity side panel (Figma "Redesign · Unified — Validation", node 40:48): the
  TOOLS rows, the bound sources, the Single-file/Batch toggle with "Run Validation" and the
  status line. Loaded by ValidationPanel via the fx:root pattern (FxmlViews.load);
  ValidationPanel is root and controller.
  Added in code: the favourites menus of the source rows, and - below the status line - the
  collapsible RESULTS and PROBLEMS sections with their data-driven lists. Only the source rows
  matching the active document type are shown; "Validate against FundsXML" is removed when the
  extension is switched off.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-validation-panel"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="modeGroup"/>
        <!-- Shown below "Run Validation" in batch mode -->
        <ContextMenu fx:id="batchSourceMenu">
            <items>
                <MenuItem text="%ValidationPanel.select-xml-files.text" onAction="#onChooseBatch">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-file-earmark-text" iconSize="16"/>
                    </graphic>
                </MenuItem>
                <MenuItem text="%ValidationPanel.select-folder.text" onAction="#onChooseBatchFolder">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
                    </graphic>
                </MenuItem>
            </items>
        </ContextMenu>
    </fx:define>
    <children>
        <!-- The ⋮ overflow menu keeps only toggles; every tool is a visible row in TOOLS. -->
        <SidePanelHeader title="%ValidationPanel.validation.title">
            <children>
                <MenuButton fx:id="overflowMenu" id="validation-overflow" styleClass="fxt-vp-overflow">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-three-dots-vertical" iconSize="15"/>
                    </graphic>
                    <items>
                        <CheckMenuItem fx:id="liveValidation" text="%ValidationPanel.liveValidation.text" selected="true"
                                       onAction="#onLiveValidationToggled"/>
                    </items>
                </MenuButton>
            </children>
        </SidePanelHeader>

        <!-- TOOLS in two groups (UX plan 2.4), both open at the top: results/reports of a run, and the
             Schematron authoring tools (needed also without a run, so they stay in this panel). -->
        <SidePanelSection id="validation-reports-section" title="%ValidationPanel.validation-reports-section.title">
            <children>
                <PanelActionList fx:id="tools" id="validation-tools">
                    <children>
                        <!-- Enabled after a validation run with a bound Schematron -->
                        <PanelActionButton fx:id="schematronReportButton" id="validation-schematron-report"
                                           iconLiteral="bi-journal-check" text="%ValidationPanel.schematronReportButton.text" color="NAVIGATE"
                                           disable="true" onAction="#openSchematronReport">
                            <tooltip>
                                <Tooltip text="%ValidationPanel.detailed-report-of-the-last.text"/>
                            </tooltip>
                        </PanelActionButton>
                        <PanelActionButton fx:id="exportProblems" id="validation-export-problems"
                                           iconLiteral="bi-file-earmark-excel" text="%ValidationPanel.exportProblems.text"
                                           color="TOOL" onAction="#exportProblemsToExcel"/>
                        <PanelActionButton fx:id="batchReportButton" id="validation-tool-batch-report"
                                           iconLiteral="bi-file-earmark-text" text="%ValidationPanel.batchReportButton.text"
                                           color="NAVIGATE" onAction="#onOpenBatchReport"/>
                    </children>
                </PanelActionList>
            </children>
        </SidePanelSection>
        <SidePanelSection id="validation-authoring-section" title="%ValidationPanel.validation-authoring-section.title">
            <children>
                <PanelActionList fx:id="authoringTools" id="validation-authoring-tools">
                    <children>
                        <PanelActionButton id="validation-tool-templates" iconLiteral="bi-journal-code"
                                           text="%ValidationPanel.validation-tool-templates.text" color="NAVIGATE"
                                           onAction="#openSchematronTemplates"/>
                        <PanelActionButton id="validation-tool-tester" iconLiteral="bi-flask"
                                           text="%ValidationPanel.validation-tool-tester.text" color="NAVIGATE"
                                           onAction="#openSchematronTester"/>
                        <PanelActionButton id="validation-tool-builder" iconLiteral="bi-tools" text="%ValidationPanel.validation-tool-builder.text"
                                           color="NAVIGATE" onAction="#openSchematronBuilder"/>
                        <PanelActionButton id="validation-tool-check" iconLiteral="bi-check2-square"
                                           text="%ValidationPanel.validation-tool-check.text" color="CREATE" onAction="#openSchematronCheck"/>
                        <PanelActionButton id="validation-tool-documentation" iconLiteral="bi-book"
                                           text="%ValidationPanel.validation-tool-documentation.text" color="NAVIGATE"
                                           onAction="#openSchematronDocumentation"/>
                    </children>
                </PanelActionList>
            </children>
        </SidePanelSection>

        <!-- SOURCES -->
        <HBox spacing="6" alignment="CENTER_LEFT" styleClass="fxt-vp-section-header">
            <children>
                <IconifyIcon iconLiteral="bi-chevron-down" iconSize="11"/>
                <Label text="%ValidationPanel.sources.text"/>
            </children>
        </HBox>
        <SourceRow fx:id="xsdRow" id="validation-xsd-row" iconLiteral="bi-diagram-3" caption="%ValidationPanel.xsdRow.caption"
                   emptyText="%ValidationPanel.xsdRow.emptyText" onChange="#onChooseXsd">
            <name>
                <Label fx:id="xsdName" text="%ValidationPanel.xsdName.text" styleClass="fxt-vp-source-name"/>
            </name>
        </SourceRow>
        <SourceRow fx:id="schematronRow" id="validation-schematron-row" iconLiteral="bi-ui-checks-grid" caption="%ValidationPanel.schematronRow.caption"
                   emptyText="%ValidationPanel.schematronRow.emptyText"
                   onChange="#onChooseSchematron">
            <name>
                <Label fx:id="schematronName" text="%ValidationPanel.schematronName.text" styleClass="fxt-vp-source-name"/>
            </name>
        </SourceRow>
        <SourceRow fx:id="jsonSchemaRow" id="validation-json-schema-row" iconLiteral="bi-braces" caption="%ValidationPanel.jsonSchemaRow.caption"
                   emptyText="%ValidationPanel.jsonSchemaRow.emptyText"
                   onChange="#onChooseJsonSchema">
            <name>
                <Label fx:id="jsonSchemaName" text="%ValidationPanel.jsonSchemaName.text" styleClass="fxt-vp-source-name"/>
            </name>
        </SourceRow>

        <!-- Mode toggle + Run Validation -->
        <VBox spacing="10" styleClass="fxt-vp-run-box">
            <children>
                <HBox spacing="2" styleClass="fxt-seg-group">
                    <children>
                        <ToggleButton fx:id="singleMode" text="%ValidationPanel.singleMode.text" toggleGroup="$modeGroup" selected="true"
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-seg"/>
                        <ToggleButton fx:id="batchMode" text="%ValidationPanel.batchMode.text" toggleGroup="$modeGroup" maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS" styleClass="fxt-seg"/>
                    </children>
                </HBox>
                <Button fx:id="run" id="validation-run" text="%ValidationPanel.run.text" maxWidth="Infinity"
                        styleClass="fxt-primary-button" onAction="#onRun">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-play-fill" iconSize="14"/>
                    </graphic>
                </Button>
                <PanelProgress fx:id="progress"/>
            </children>
        </VBox>

        <Label fx:id="status" text="%ValidationPanel.status.text" styleClass="fxt-vp-status"/>
    </children>
</fx:root>
