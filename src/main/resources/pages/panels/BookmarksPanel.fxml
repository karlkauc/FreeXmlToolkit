<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionButton?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionList?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelHeader?>

<!--
  Bookmarks activity side panel: actions, a filter, "only the active document" and the bookmarks of all
  files grouped by file. Loaded by BookmarksPanel via the fx:root pattern (FxmlViews.load); BookmarksPanel
  is root and controller. Rows, cells and the context menu are built in code.
-->
<fx:root type="javafx.scene.layout.VBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <SidePanelHeader title="%BookmarksPanel.title"/>
        <PanelActionList>
            <children>
                <PanelActionButton id="bookmarks-toggle" iconLiteral="bi-bookmark-plus" text="%BookmarksPanel.toggle.text"
                                   color="CREATE" onAction="#toggleAtCaret"/>
                <PanelActionButton id="bookmarks-remove-missing" iconLiteral="bi-file-earmark-x"
                                   text="%BookmarksPanel.remove-missing.text" onAction="#removeMissing"/>
                <PanelActionButton id="bookmarks-clear-all" iconLiteral="bi-trash" text="%BookmarksPanel.clear-all.text"
                                   color="DELETE" onAction="#clearAll"/>
            </children>
        </PanelActionList>
        <VBox styleClass="fxt-side-panel-body" spacing="6" VBox.vgrow="ALWAYS">
            <children>
                <TextField fx:id="search" id="bookmarks-search" promptText="%BookmarksPanel.search.promptText"/>
                <CheckBox fx:id="onlyActive" id="bookmarks-only-active" text="%BookmarksPanel.onlyActive.text"/>
                <ListView fx:id="list" id="bookmarks-list" styleClass="fxt-open-editors" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label wrapText="true" styleClass="fxt-text-sm"
                               text="%BookmarksPanel.empty.text"/>
                    </placeholder>
                </ListView>
            </children>
        </VBox>
    </children>
</fx:root>
