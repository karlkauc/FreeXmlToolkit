<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionButton?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionList?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelProgress?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelHeader?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelSection?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SourceRow?>

<!--
  Transform activity side panel (Figma "Redesign · Unified — Transform (XSLT)"): the OPTIONS &amp; TOOLS
  section, stylesheet and input rows, output method, parameters, "Run Transform" and the Query
  Console hint. The result lives in the editor-docked TransformOutputPanel.
  Loaded by TransformPanel via the fx:root pattern (FxmlViews.load); TransformPanel is root and
  controller. Added in code: the recent/favourites menus and ◀/▶ browse controls of the source
  rows, the output-method segments (one per FormatChoice), the parameter rows with their
  "Add parameter" row, and the "Saved Queries" / "Examples" menu rows. The title of the query
  section switches between XPATH and JSONPATH with the active document.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-transform-panel"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <!-- Shown by "Change" in the INPUT row -->
        <ContextMenu fx:id="inputMenu">
            <items>
                <MenuItem text="%TransformPanel.select-xml-file.text" onAction="#onChooseInputFile"/>
                <MenuItem text="%TransformPanel.use-active-editor.text" onAction="#onUseActiveEditor"/>
            </items>
        </ContextMenu>
    </fx:define>
    <children>
        <SidePanelHeader title="%TransformPanel.transform.title"/>

        <!-- The sections scroll on short windows. -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge" VBox.vgrow="ALWAYS">
            <content>
                <VBox>
                    <children>
                        <!-- One place for everything secondary (UX plan 2.5): the run options (formerly
                             in the ⋮ menu) and the tools, open at the top of the panel. -->
                        <SidePanelSection id="transform-options-section" title="%TransformPanel.transform-options-section.title">
                            <children>
                                <VBox spacing="6" styleClass="fxt-tp-section-body">
                                    <children>
                                        <CheckBox fx:id="livePreview" id="transform-live-preview" text="%TransformPanel.livePreview.text"
                                                  onAction="#onLivePreviewToggled"/>
                                        <CheckBox fx:id="watchXslt" id="transform-watch-xslt" text="%TransformPanel.watchXslt.text"/>
                                        <CheckBox fx:id="profileCheck" id="transform-profile" text="%TransformPanel.profileCheck.text"/>
                                        <CheckBox fx:id="traceCheck" id="transform-trace" text="%TransformPanel.traceCheck.text"/>
                                        <CheckBox fx:id="autoOpenResultTab" id="transform-auto-open"
                                                  text="%TransformPanel.autoOpenResultTab.text"/>
                                    </children>
                                </VBox>
                                <PanelActionList fx:id="tools" id="transform-tools">
                                    <children>
                                        <PanelActionButton id="transform-tool-debug" iconLiteral="bi-bug"
                                                           text="%TransformPanel.transform-tool-debug.text" color="TOOL" onAction="#startDebug"/>
                                        <PanelActionButton id="transform-tool-batch" iconLiteral="bi-collection"
                                                           text="%TransformPanel.transform-tool-batch.text" color="TOOL"
                                                           onAction="#openBatch"/>
                                        <PanelActionButton id="transform-tool-stats" iconLiteral="bi-speedometer2"
                                                           text="%TransformPanel.transform-tool-stats.text" color="NAVIGATE"
                                                           onAction="#onOpenExecutionStats"/>
                                        <PanelActionButton fx:id="generateStylesheetButton" id="transform-tool-ai-generate" iconLiteral="bi-stars"
                                                           text="%TransformPanel.transform-tool-ai-generate.text" color="TOOL"
                                                           onAction="#onGenerateStylesheet"/>
                                    </children>
                                </PanelActionList>
                            </children>
                        </SidePanelSection>

                        <!-- The open project's transformation scenarios (shown only while a project is
                             open): choosing one fills stylesheet, input, parameters and output method. -->
                        <SidePanelSection fx:id="scenarioSection" id="transform-scenario-section" title="%TransformPanel.scenarioSection.title"
                                          visible="false" managed="false">
                            <children>
                                <VBox spacing="6" styleClass="fxt-tp-section-body">
                                    <children>
                                        <ComboBox fx:id="scenarioChoice" id="transform-scenario" maxWidth="Infinity"
                                                  promptText="%TransformPanel.scenarioChoice.promptText" styleClass="fxt-neutral-combo"
                                                  onAction="#onScenarioChosen"/>
                                        <Label fx:id="scenarioInfo" id="transform-scenario-info" wrapText="true"
                                               opacity="0.7" visible="false" managed="false"/>
                                        <HBox spacing="6">
                                            <children>
                                                <Button fx:id="runScenarioButton" id="transform-scenario-run"
                                                        text="%TransformPanel.runScenarioButton.text" styleClass="fxt-secondary-button"
                                                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                                        onAction="#onRunScenario">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-play" iconSize="14"/>
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="%TransformPanel.runs-the-saved-scenario-from.text"/>
                                                    </tooltip>
                                                </Button>
                                                <Button fx:id="checkScenarioButton" id="transform-scenario-check"
                                                        styleClass="fxt-secondary-button" onAction="#onCheckScenario">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-clipboard-check" iconSize="14"/>
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="%TransformPanel.check-scenario.tooltip"/>
                                                    </tooltip>
                                                </Button>
                                                <Button id="transform-scenario-save" styleClass="fxt-secondary-button"
                                                        onAction="#onSaveScenario">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-floppy" iconSize="14"/>
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="%TransformPanel.save-the-current-settings-as.text"/>
                                                    </tooltip>
                                                </Button>
                                                <Button fx:id="deleteScenarioButton" id="transform-scenario-delete"
                                                        styleClass="fxt-secondary-button" onAction="#onDeleteScenario">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-trash" iconSize="14"/>
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="%TransformPanel.remove-the-chosen-scenario-from.text"/>
                                                    </tooltip>
                                                </Button>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="checkActions" id="transform-check-actions" spacing="6"
                                              visible="false" managed="false">
                                            <children>
                                                <Button id="transform-check-differences" text="%TransformPanel.check-differences.text"
                                                        styleClass="fxt-secondary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                                        onAction="#onShowCheckDifferences">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-layout-split" iconSize="14"/>
                                                    </graphic>
                                                </Button>
                                                <Button id="transform-check-accept" text="%TransformPanel.check-accept.text"
                                                        styleClass="fxt-secondary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                                        onAction="#onAcceptCheck">
                                                    <graphic>
                                                        <IconifyIcon iconLiteral="bi-check2-square" iconSize="14"/>
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="%TransformPanel.check-accept.tooltip"/>
                                                    </tooltip>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </SidePanelSection>

                        <SidePanelSection title="%TransformPanel.stylesheet.title">
                            <children>
                                <SourceRow fx:id="xsltRow" id="transform-xslt-row" iconLiteral="bi-arrow-repeat"
                                           emptyText="%TransformPanel.xsltRow.emptyText"
                                           onChange="#onChooseXslt">
                                    <name>
                                        <Label fx:id="xsltName" text="%TransformPanel.xsltName.text"
                                               styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                    </name>
                                </SourceRow>
                            </children>
                        </SidePanelSection>

                        <SidePanelSection title="%TransformPanel.input.title">
                            <children>
                                <SourceRow fx:id="inputRow" id="transform-input-row" iconLiteral="bi-code-slash"
                                           emptyText="%TransformPanel.inputRow.emptyText"
                                           onChange="#onChangeInput">
                                    <name>
                                        <Label fx:id="inputName" text="%TransformPanel.inputName.text" styleClass="fxt-vp-source-name"/>
                                    </name>
                                </SourceRow>
                            </children>
                        </SidePanelSection>

                        <!-- One line: Auto (from xsl:output) or a concrete format (UX plan 2.5) -->
                        <SidePanelSection title="%TransformPanel.output-method.title">
                            <children>
                                <VBox styleClass="fxt-tp-section-body">
                                    <children>
                                        <ComboBox fx:id="formatChoice" id="transform-output-method" accessibleText="%TransformPanel.outputMethod.accessibleText" maxWidth="Infinity"
                                                  styleClass="fxt-neutral-combo"/>
                                    </children>
                                </VBox>
                            </children>
                        </SidePanelSection>

                        <SidePanelSection title="%TransformPanel.parameters.title">
                            <children>
                                <VBox fx:id="paramsBox" spacing="4" styleClass="fxt-tp-params">
                                    <children>
                                        <VBox fx:id="paramRows" spacing="4"/>
                                    </children>
                                </VBox>
                            </children>
                        </SidePanelSection>

                        <VBox fx:id="runBox" spacing="8" styleClass="fxt-vp-run-box">
                            <children>
                                <!-- Run and Debug side by side: the debugger is a first-class way to run
                                     a stylesheet, not a hidden tool (it also stays listed under TOOLS). -->
                                <HBox spacing="6">
                                    <children>
                                        <Button fx:id="transformButton" id="transform-run" text="%TransformPanel.transformButton.text"
                                                maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-primary-button"
                                                onAction="#onTransform">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-play-fill" iconSize="14"/>
                                            </graphic>
                                        </Button>
                                        <Button fx:id="debugButton" id="transform-debug" text="%TransformPanel.debugButton.text"
                                                styleClass="fxt-secondary-button, fxt-run-debug-button"
                                                onAction="#startDebug">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-bug-fill" iconSize="14"/>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="%TransformPanel.debug-the-stylesheet-breakpoints-stepping.text"/>
                                            </tooltip>
                                        </Button>
                                    </children>
                                </HBox>
                                <!-- Picking a stylesheet/input via drop, favourite or ◀ ▶ starts a run;
                                     visible here so the automatic behaviour can be switched off (UX plan 3.6). -->
                                <CheckBox fx:id="runAutomatically" id="transform-auto-run" text="%TransformPanel.runAutomatically.text"
                                          selected="true">
                                    <tooltip>
                                        <Tooltip text="%TransformPanel.run-as-soon-as-a.text"/>
                                    </tooltip>
                                </CheckBox>
                                <PanelProgress fx:id="progress"/>
                            </children>
                        </VBox>

                        <!-- Queries against the open document live in the Query Console (UX plan 3.3, E4) -->
                        <VBox styleClass="fxt-tp-section-body">
                            <children>
                                <Label wrapText="true" styleClass="fxt-placeholder-text"
                                       text="%TransformPanel.xpath-xquery-and-jsonpath-queries.text"/>
                                <Button id="transform-open-query-console" text="%TransformPanel.transform-open-query-console.text"
                                        styleClass="fxt-tool-button" onAction="#onOpenQueryConsole">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-terminal" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</fx:root>
