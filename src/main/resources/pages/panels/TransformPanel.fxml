<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionButton?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionList?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelProgress?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelHeader?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelSection?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SourceRow?>

<!--
  Transform activity side panel (Figma "Redesign · Unified — Transform (XSLT)"): stylesheet and
  input rows, output method, parameters, "Run Transform", the TOOLS rows and the collapsed
  XPath/JSONPath and XQuery sections. The result lives in the editor-docked TransformOutputPanel.
  Loaded by TransformPanel via the fx:root pattern (FxmlViews.load); TransformPanel is root and
  controller. Added in code: the recent/favourites menus and ◀/▶ browse controls of the source
  rows, the output-method segments (one per FormatChoice), the parameter rows with their
  "Add parameter" row, and the "Saved Queries" / "Examples" menu rows. The title of the query
  section switches between XPATH and JSONPATH with the active document.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-transform-panel"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <!-- Shown by "Change" in the INPUT row -->
        <ContextMenu fx:id="inputMenu">
            <items>
                <MenuItem text="Select XML file…" onAction="#onChooseInputFile"/>
                <MenuItem text="Use active editor" onAction="#onUseActiveEditor"/>
            </items>
        </ContextMenu>
    </fx:define>
    <children>
        <SidePanelHeader title="TRANSFORM"/>

        <!-- The sections scroll on short windows. -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge" VBox.vgrow="ALWAYS">
            <content>
                <VBox>
                    <children>
                        <SidePanelSection title="STYLESHEET">
                            <children>
                                <SourceRow fx:id="xsltRow" id="transform-xslt-row" iconLiteral="bi-arrow-repeat"
                                           emptyText="No stylesheet — choose or drop a file"
                                           onChange="#onChooseXslt">
                                    <name>
                                        <Label fx:id="xsltName" text="none"
                                               styleClass="fxt-vp-source-name, fxt-vp-source-none"/>
                                    </name>
                                </SourceRow>
                            </children>
                        </SidePanelSection>

                        <SidePanelSection title="INPUT">
                            <children>
                                <SourceRow fx:id="inputRow" id="transform-input-row" iconLiteral="bi-code-slash"
                                           emptyText="No input — open a document or drop a file"
                                           onChange="#onChangeInput">
                                    <name>
                                        <Label fx:id="inputName" text="none" styleClass="fxt-vp-source-name"/>
                                    </name>
                                </SourceRow>
                            </children>
                        </SidePanelSection>

                        <!-- One line: Auto (from xsl:output) or a concrete format (UX plan 2.5) -->
                        <SidePanelSection title="OUTPUT METHOD">
                            <children>
                                <VBox styleClass="fxt-tp-section-body">
                                    <children>
                                        <ComboBox fx:id="formatChoice" id="transform-output-method" maxWidth="Infinity"
                                                  styleClass="fxt-neutral-combo"/>
                                    </children>
                                </VBox>
                            </children>
                        </SidePanelSection>

                        <SidePanelSection title="PARAMETERS">
                            <children>
                                <VBox fx:id="paramsBox" spacing="4" styleClass="fxt-tp-params">
                                    <children>
                                        <VBox fx:id="paramRows" spacing="4"/>
                                    </children>
                                </VBox>
                            </children>
                        </SidePanelSection>

                        <VBox fx:id="runBox" spacing="8" styleClass="fxt-vp-run-box">
                            <children>
                                <!-- Run and Debug side by side: the debugger is a first-class way to run
                                     a stylesheet, not a hidden tool (it also stays listed under TOOLS). -->
                                <HBox spacing="6">
                                    <children>
                                        <Button fx:id="transformButton" id="transform-run" text="Run Transform"
                                                maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="fxt-primary-button"
                                                onAction="#onTransform">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-play-fill" iconSize="14"/>
                                            </graphic>
                                        </Button>
                                        <Button fx:id="debugButton" id="transform-debug" text="Debug"
                                                styleClass="fxt-secondary-button, fxt-run-debug-button"
                                                onAction="#startDebug">
                                            <graphic>
                                                <IconifyIcon iconLiteral="bi-bug-fill" iconSize="14"/>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="Debug the stylesheet: breakpoints, stepping, variables (Shift+F5)"/>
                                            </tooltip>
                                        </Button>
                                    </children>
                                </HBox>
                                <!-- Picking a stylesheet/input via drop, favourite or ◀ ▶ starts a run;
                                     visible here so the automatic behaviour can be switched off (UX plan 3.6). -->
                                <CheckBox fx:id="runAutomatically" id="transform-auto-run" text="Run automatically"
                                          selected="true">
                                    <tooltip>
                                        <Tooltip text="Run as soon as a stylesheet or input is dropped, picked from favourites or browsed with ◀ ▶"/>
                                    </tooltip>
                                </CheckBox>
                                <PanelProgress fx:id="progress"/>
                            </children>
                        </VBox>

                        <!-- One place for everything secondary (UX plan 2.5): the run options (formerly
                             in the ⋮ menu) and the tools, collapsed below the run. -->
                        <SidePanelSection id="transform-options-section" title="OPTIONS &amp; TOOLS" collapsed="true">
                            <children>
                                <VBox spacing="6" styleClass="fxt-tp-section-body">
                                    <children>
                                        <CheckBox fx:id="livePreview" id="transform-live-preview" text="Live preview"
                                                  onAction="#onLivePreviewToggled"/>
                                        <CheckBox fx:id="watchXslt" id="transform-watch-xslt" text="Watch stylesheet file"/>
                                        <CheckBox fx:id="profileCheck" id="transform-profile" text="Profile run"/>
                                        <CheckBox fx:id="traceCheck" id="transform-trace" text="Trace run"/>
                                        <CheckBox fx:id="autoOpenResultTab" id="transform-auto-open"
                                                  text="Auto-open result tab"/>
                                    </children>
                                </VBox>
                                <PanelActionList fx:id="tools" id="transform-tools">
                                    <children>
                                        <PanelActionButton id="transform-tool-debug" iconLiteral="bi-bug"
                                                           text="Debug XSLT…" color="TOOL" onAction="#startDebug"/>
                                        <PanelActionButton id="transform-tool-batch" iconLiteral="bi-collection"
                                                           text="Batch Transform…" color="TOOL"
                                                           onAction="#openBatch"/>
                                        <PanelActionButton id="transform-tool-stats" iconLiteral="bi-speedometer2"
                                                           text="Execution Statistics" color="NAVIGATE"
                                                           onAction="#onOpenExecutionStats"/>
                                    </children>
                                </PanelActionList>
                            </children>
                        </SidePanelSection>

                        <!-- Queries against the open document live in the Query Console (UX plan 3.3, E4) -->
                        <VBox styleClass="fxt-tp-section-body">
                            <children>
                                <Label wrapText="true" styleClass="fxt-placeholder-text"
                                       text="XPath, XQuery and JSONPath queries against the open document: Query Console (Ctrl+K)."/>
                                <Button id="transform-open-query-console" text="Open Query Console"
                                        styleClass="fxt-tool-button" onAction="#onOpenQueryConsole">
                                    <graphic>
                                        <IconifyIcon iconLiteral="bi-terminal" iconSize="15"/>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</fx:root>
