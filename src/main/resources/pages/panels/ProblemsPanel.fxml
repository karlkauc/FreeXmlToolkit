<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  PROBLEMS panel below the editor (Figma "Redesign · Unified — Validation", node 42:3): a header
  bar with severity counters, category filter, search, grouping, export and a collapse toggle above
  the problem list (or the grouped tree); its top edge is a drag handle for the height.
  Loaded by ProblemsPanel via the fx:root pattern (FxmlViews.load); ProblemsPanel is root and
  controller. The problem rows (cells), the counter texts and the category menu are filled in code.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-problems-panel"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Drag handle: the panel's height (persisted, DockResizer) -->
        <Region fx:id="resizer" id="problems-panel-resizer" minHeight="5" prefHeight="5" maxHeight="5"
                styleClass="fxt-dock-resizer"/>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="fxt-problems-header">
            <children>
                <Label text="%ProblemsPanel.problems.text" styleClass="fxt-problems-title"/>
                <!-- severity counters; a click shows only that severity, a second click all problems again -->
                <ToggleButton fx:id="errorChip" id="problems-filter-errors" styleClass="fxt-problems-chip-error"
                              onAction="#onFilterErrors">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-x-circle" iconSize="13"/>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="warningChip" id="problems-filter-warnings" styleClass="fxt-problems-chip-warning"
                              onAction="#onFilterWarnings">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-exclamation-triangle-fill" iconSize="13"/>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="hintChip" id="problems-filter-hints" styleClass="fxt-problems-chip-info"
                              onAction="#onFilterHints">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-info-circle" iconSize="13"/>
                    </graphic>
                </ToggleButton>
                <!-- categories (ISIN, LEI, schema, FMA rule groups …) with counts; built in code when opened -->
                <MenuButton fx:id="categoryMenu" id="problems-category-filter" styleClass="fxt-problems-tool"
                            text="%ProblemsPanel.categories">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-funnel" iconSize="13"/>
                    </graphic>
                </MenuButton>
                <TextField fx:id="search" id="problems-search" styleClass="fxt-problems-search"
                           promptText="%ProblemsPanel.search-prompt"/>
                <HBox fx:id="focusBox" id="problems-focus" spacing="2" alignment="CENTER_LEFT"
                      styleClass="fxt-problems-focus" visible="false" managed="false">
                    <children>
                        <Label fx:id="focusLabel"/>
                        <Button id="problems-focus-clear" styleClass="fxt-problems-collapse" onAction="#onClearFocus">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-x" iconSize="13"/>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="%ProblemsPanel.group-by" styleClass="fxt-problems-group-count"/>
                <ComboBox fx:id="groupBy" id="problems-group-by" styleClass="fxt-problems-tool"/>
                <MenuButton fx:id="exportMenu" id="problems-export" styleClass="fxt-problems-tool"
                            text="%ProblemsPanel.export">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-file-earmark-spreadsheet" iconSize="13"/>
                    </graphic>
                    <items>
                        <MenuItem id="problems-export-shown" text="%ProblemsPanel.export-shown"
                                  onAction="#onExportShown"/>
                        <MenuItem id="problems-export-all" text="%ProblemsPanel.export-all"
                                  onAction="#onExportAll"/>
                    </items>
                </MenuButton>
                <Button id="problems-panel-collapse" styleClass="fxt-problems-collapse"
                        onAction="#onToggleCollapsed">
                    <graphic>
                        <IconifyIcon fx:id="collapseIcon" iconLiteral="bi-chevron-down" iconSize="13"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
        <StackPane fx:id="content" VBox.vgrow="ALWAYS" minHeight="0" prefHeight="0">
            <children>
                <ListView fx:id="list" id="problems-panel-list" minHeight="0" prefHeight="0" styleClass="fxt-problems-list"/>
                <TreeView fx:id="tree" id="problems-panel-tree" minHeight="0" prefHeight="0" showRoot="false"
                          styleClass="fxt-problems-tree" visible="false" managed="false"/>
            </children>
        </StackPane>
    </children>
</fx:root>
