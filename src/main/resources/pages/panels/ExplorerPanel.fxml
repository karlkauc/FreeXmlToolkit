<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionButton?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.PanelActionList?>
<?import org.fxt.freexmltoolkit.controls.shell.editor.SidePanelHeader?>

<!--
  Explorer activity side panel (Figma "Redesign · Unified Editor (Light)", node 28:48): header
  actions, the TOOLS pickers with their action rows, OPEN EDITORS, the workspace tree and the
  FAVORITES | RECENT tabs pinned to the bottom (resizable by the grip above them). The header's
  star is the shell-wide Favorites quick access menu (FavoritesMenu), rebuilt each time it opens.
  Loaded by ExplorerPanel via the fx:root pattern (FxmlViews.load); ExplorerPanel is root and
  controller. Inserted in code: the collapsible section headers (TOOLS, OPEN EDITORS, workspace)
  in front of their content, and the workspace tree in front of the grip. The picker menus, the
  open-editor rows and the list cells are data-driven and filled in code.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-explorer-panel"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Flat 14px header icon actions (no button chrome, per the mockup) -->
        <SidePanelHeader title="%ExplorerPanel.explorer.title" spacing="10">
            <children>
                <Button id="explorer-new-file" styleClass="fxt-sp-action" onAction="#onNewFile">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-file-earmark-plus" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%ExplorerPanel.new-file.text"/>
                    </tooltip>
                </Button>
                <Button id="explorer-open-folder" styleClass="fxt-sp-action" onAction="#onChooseFolder">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-folder-plus" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%ExplorerPanel.open-folder.text"/>
                    </tooltip>
                </Button>
                <Button id="explorer-refresh" styleClass="fxt-sp-action" onAction="#onRefreshWorkspace">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-clockwise" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%ExplorerPanel.refresh-workspace.text"/>
                    </tooltip>
                </Button>
                <MenuButton fx:id="favoritesButton" id="explorer-favorites"
                            styleClass="fxt-sp-action, fxt-fav-quick-access" focusTraversable="false">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-star" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%ExplorerPanel.favorites.text"/>
                    </tooltip>
                </MenuButton>
            </children>
        </SidePanelHeader>

        <!-- TOOLS (above the files, open by default, state remembered). Transform / validate
             the selected files from the workspace context menu (UX plan 3.1/3.2). -->
        <VBox fx:id="toolsBody">
            <children>
                <PanelActionList fx:id="fileActions">
                    <children>
                        <PanelActionButton id="explorer-open-file" iconLiteral="bi-folder2-open" text="%ExplorerPanel.explorer-open-file.text"
                                           color="TOOL" onAction="#onOpenFile"/>
                        <PanelActionButton id="explorer-open-url" iconLiteral="bi-globe" text="%ExplorerPanel.explorer-open-url.text"
                                           color="TOOL" onAction="#onOpenFromUrl">
                            <tooltip>
                                <Tooltip text="%ExplorerPanel.open-a-file-from-a.text"/>
                            </tooltip>
                        </PanelActionButton>
                        <PanelActionButton fx:id="compareButton" id="explorer-compare" iconLiteral="bi-file-diff"
                                           text="%ExplorerPanel.compareButton.text" color="TOOL" onAction="#onCompare">
                            <tooltip>
                                <Tooltip text="%ExplorerPanel.compare-the-two-selected-files.text"/>
                            </tooltip>
                        </PanelActionButton>
                        <PanelActionButton id="explorer-spreadsheet" iconLiteral="bi-table"
                                           text="%ExplorerPanel.explorer-spreadsheet.text" color="TOOL" onAction="#onSpreadsheet">
                            <tooltip>
                                <Tooltip text="%ExplorerPanel.convert-between-xml-and-excel.text"/>
                            </tooltip>
                        </PanelActionButton>
                        <PanelActionButton id="explorer-generate-xsd-batch" iconLiteral="bi-files"
                                           text="%ExplorerPanel.explorer-generate-xsd-batch.text" color="CREATE"
                                           onAction="#onGenerateXsdBatch">
                            <tooltip>
                                <Tooltip text="%ExplorerPanel.infer-one-schema-from-the.text"/>
                            </tooltip>
                        </PanelActionButton>
                        <PanelActionButton id="explorer-clear-recent" iconLiteral="bi-eraser" text="%ExplorerPanel.explorer-clear-recent.text"
                                           color="DELETE" onAction="#clearRecent"/>
                    </children>
                </PanelActionList>
            </children>
        </VBox>

        <!-- OPEN EDITORS: a plain VBox of rows (see ExplorerPanel), rebuilt in code. Capped at about
             six rows and scrolling beyond, so the workspace tree below keeps its space. -->
        <ScrollPane fx:id="openEditorsScroll" id="explorer-open-editors-scroll" fitToWidth="true"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" maxHeight="176" minHeight="0"
                    styleClass="fxt-open-editors-scroll">
            <content>
                <VBox fx:id="openEditorsBox" styleClass="fxt-open-editors-box"/>
            </content>
        </ScrollPane>

        <!-- WORKSPACE header + tree are inserted here in code (they need the tree instance). -->


        <!-- Drag to resize the pane below; fixed size so the VBox never squeezes the grip away -->
        <Region fx:id="favRecentGrip" id="explorer-fav-recent-grip" minHeight="6" prefHeight="6" maxHeight="6"
                styleClass="fxt-explorer-grip">
            <cursor>
                <Cursor fx:constant="V_RESIZE"/>
            </cursor>
        </Region>

        <!-- FAVORITES | RECENT: two tabs over one pane; minHeight -Infinity = USE_PREF_SIZE (the
             user-chosen height). The tab choice is remembered (ExplorerPanel.FAV_RECENT_TAB_KEY). -->
        <VBox fx:id="favRecentPane" id="explorer-fav-recent" minHeight="-Infinity">
            <children>
                <HBox styleClass="fxt-explorer-tabs" spacing="2">
                    <children>
                        <ToggleButton fx:id="favoritesTab" id="explorer-tab-favorites" text="%ExplorerPanel.favoritesTab.text"
                                      styleClass="fxt-explorer-tab" focusTraversable="false"
                                      onAction="#onFavoritesTab"/>
                        <ToggleButton fx:id="recentTab" id="explorer-tab-recent" text="%ExplorerPanel.recentTab.text"
                                      styleClass="fxt-explorer-tab" focusTraversable="false"
                                      onAction="#onRecentTab"/>
                    </children>
                </HBox>
                <ListView fx:id="favoritesList" id="explorer-favorites-list" fixedCellSize="28" VBox.vgrow="ALWAYS"
                          styleClass="fxt-open-editors, fxt-explorer-list">
                    <placeholder>
                        <Label text="%ExplorerPanel.star-files-with-ctrl-d.text" wrapText="true"
                               styleClass="fxt-placeholder-text"/>
                    </placeholder>
                </ListView>
                <ListView fx:id="recentList" id="explorer-recent-list" fixedCellSize="28" VBox.vgrow="ALWAYS"
                          styleClass="fxt-open-editors, fxt-explorer-list">
                    <placeholder>
                        <Label text="%ExplorerPanel.files-you-open-appear-here.text" styleClass="fxt-placeholder-text"/>
                    </placeholder>
                </ListView>
            </children>
        </VBox>
    </children>
</fx:root>
