<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  OUTPUT panel in the editor's bottom dock (EditorBottomDock, which owns the height; Figma
  "Redesign · Unified — Transform (XSLT)", node 47:3): a header (format badge, status, Preview/Text/Table toggle, result actions) above
  the result area. Loaded by TransformOutputPanel via the fx:root pattern (FxmlViews.load);
  TransformOutputPanel is root and controller. Built in code: the read-only CodeArea of the Text
  view (put first into the "content" stack), the table columns and the lazily created HTML
  preview. Preview and Table are only offered for matching results, so they start hidden.
-->
<fx:root type="javafx.scene.layout.VBox" styleClass="fxt-output-panel"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="viewGroup"/>
    </fx:define>
    <children>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="fxt-output-header">
            <children>
                <Label text="%TransformOutputPanel.output.text" styleClass="fxt-output-title"/>
                <Label fx:id="badge" visible="false" styleClass="fxt-output-badge"/>
                <IconifyIcon fx:id="statusIcon" iconLiteral="bi-check-circle-fill" iconSize="12" visible="false"/>
                <Label fx:id="statusLabel" styleClass="fxt-output-status"/>
                <Button fx:id="runAnywayButton" id="transform-output-run-anyway" text="%TransformOutputPanel.runAnyway.text"
                        visible="false" managed="false" styleClass="fxt-tool-button" onAction="#onRunAnyway">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-play-circle" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%TransformOutputPanel.runAnyway.tooltip"/>
                    </tooltip>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="2" styleClass="fxt-seg-group">
                    <children>
                        <ToggleButton fx:id="previewToggle" text="%TransformOutputPanel.previewToggle.text" toggleGroup="$viewGroup"
                                      visible="false" managed="false" styleClass="fxt-seg"/>
                        <ToggleButton fx:id="textToggle" text="%TransformOutputPanel.textToggle.text" toggleGroup="$viewGroup" selected="true"
                                      styleClass="fxt-seg"/>
                        <ToggleButton fx:id="tableToggle" text="%TransformOutputPanel.tableToggle.text" toggleGroup="$viewGroup"
                                      visible="false" managed="false" styleClass="fxt-seg"/>
                    </children>
                </HBox>
                <Button id="transform-output-editor" text="%TransformOutputPanel.transform-output-editor.text" styleClass="fxt-sp-action, fxt-output-action" onAction="#openResultInEditor">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-file-earmark-plus" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%TransformOutputPanel.open-result-as-editor-tab.text"/>
                    </tooltip>
                </Button>
                <Button id="transform-output-browser" text="%TransformOutputPanel.transform-output-browser.text" styleClass="fxt-sp-action, fxt-output-action" onAction="#openInBrowser">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-box-arrow-up-right" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%TransformOutputPanel.open-in-browser.text"/>
                    </tooltip>
                </Button>
                <Button id="transform-output-save" text="%TransformOutputPanel.transform-output-save.text" styleClass="fxt-sp-action, fxt-output-action" onAction="#saveResult">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-download" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%TransformOutputPanel.save-result.text"/>
                    </tooltip>
                </Button>
                <Button id="transform-output-close" styleClass="fxt-sp-action" onAction="#hide">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-x" iconSize="14"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%TransformOutputPanel.hide-output-panel.text"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>
        <StackPane fx:id="content" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="resultTable">
                    <placeholder>
                        <Label text="%TransformOutputPanel.run-an-xquery-returning-a.text"/>
                    </placeholder>
                </TableView>
                <StackPane fx:id="previewHolder" visible="false" managed="false"/>
            </children>
        </StackPane>
    </children>
</fx:root>
