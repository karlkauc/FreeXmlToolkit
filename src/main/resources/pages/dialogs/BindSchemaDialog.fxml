<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the "Bind Schema in Project" dialog: which XML files (a glob relative to the project
  folder) and which schema. Loaded by BindSchemaDialog (FxmlViews.loadContent), its controller.
-->
<GridPane hgap="8" vgap="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <children>
        <Label text="%BindSchemaDialog.xml-files.text" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="filesField" id="bind-schema-files" prefColumnCount="36" promptText="%BindSchemaDialog.filesField.promptText"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        <Label text="%BindSchemaDialog.schema.text" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="schemaField" id="bind-schema-schema" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button id="bind-schema-browse" text="%BindSchemaDialog.bind-schema-browse.text" onAction="#onBrowseSchema" GridPane.rowIndex="1"
                GridPane.columnIndex="2">
            <graphic>
                <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
            </graphic>
        </Button>
        <Label fx:id="error" id="bind-schema-error" wrapText="true" visible="false" managed="false"
               style="-fx-text-fill: #e03131;" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="3"/>
        <Label text="%BindSchemaDialog.xml-files-is-a-path.text"
               wrapText="true" opacity="0.7" maxWidth="520" GridPane.rowIndex="3" GridPane.columnIndex="0"
               GridPane.columnSpan="3"/>
    </children>
</GridPane>
