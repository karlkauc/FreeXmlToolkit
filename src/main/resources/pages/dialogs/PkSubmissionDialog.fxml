<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the PK-Meldewesen "Prepare Submission" dialog: target folder, running number and
  suffix of the FMA file name, the resulting name and the result of the checks. Loaded by
  PkSubmissionDialog (FxmlViews.loadContent), its controller.
-->
<GridPane hgap="8" vgap="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <children>
        <Label text="%PkSubmissionDialog.folder.text" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="folderField" id="pk-submission-folder" prefColumnCount="36"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button id="pk-submission-browse" text="%PkSubmissionDialog.browse.text" onAction="#onBrowse"
                GridPane.rowIndex="0" GridPane.columnIndex="2">
            <graphic>
                <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
            </graphic>
        </Button>
        <Label text="%PkSubmissionDialog.sequence.text" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Spinner fx:id="sequenceSpinner" id="pk-submission-sequence" editable="true" prefWidth="120"
                 GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="%PkSubmissionDialog.suffix.text" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="suffixField" id="pk-submission-suffix" prefColumnCount="12"
                   promptText="%PkSubmissionDialog.suffix.promptText" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="%PkSubmissionDialog.name.text" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="nameLabel" id="pk-submission-name" styleClass="fxt-mono-text"
               GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        <Label text="%PkSubmissionDialog.checks.text" GridPane.rowIndex="4" GridPane.columnIndex="0"
               GridPane.valignment="TOP"/>
        <Label fx:id="checksLabel" id="pk-submission-checks" wrapText="true" maxWidth="520"
               GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        <Label fx:id="errorLabel" id="pk-submission-error" wrapText="true" maxWidth="520" styleClass="fxt-text-sm"
               GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
    </children>
</GridPane>
