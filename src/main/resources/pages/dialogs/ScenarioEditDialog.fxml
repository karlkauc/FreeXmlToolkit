<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the "Edit Scenario" dialog of Project Settings: every field of a transformation
  scenario. Loaded by ScenarioEditDialog (FxmlViews.loadContent), its controller.
-->
<GridPane hgap="8" vgap="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <children>
        <Label text="%ScenarioEditDialog.name.text" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" id="scenario-edit-name" prefColumnCount="36" GridPane.rowIndex="0"
                   GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        <Label text="%ScenarioEditDialog.stylesheet-query-or-pipeline.text" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="stylesheetField" id="scenario-edit-stylesheet" promptText="%ScenarioEditDialog.stylesheetField.promptText"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button id="scenario-edit-browse-stylesheet" text="%ScenarioEditDialog.scenario-edit-browse-stylesheet.text" onAction="#onBrowseStylesheet" GridPane.rowIndex="1"
                GridPane.columnIndex="2">
            <graphic>
                <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
            </graphic>
        </Button>
        <Label text="%ScenarioEditDialog.input.text" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="inputField" id="scenario-edit-input" promptText="%ScenarioEditDialog.inputField.promptText"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Button id="scenario-edit-browse-input" text="%ScenarioEditDialog.scenario-edit-browse-input.text" onAction="#onBrowseInput" GridPane.rowIndex="2"
                GridPane.columnIndex="2">
            <graphic>
                <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
            </graphic>
        </Button>
        <Label text="%ScenarioEditDialog.parameters.text" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
        <TextArea fx:id="parametersArea" id="scenario-edit-parameters" prefRowCount="4" promptText="%ScenarioEditDialog.parametersArea.promptText"
                  GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        <Label text="%ScenarioEditDialog.output-method.text" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="formatChoice" id="scenario-edit-format" maxWidth="Infinity" GridPane.rowIndex="4"
                  GridPane.columnIndex="1"/>
        <ComboBox fx:id="processorChoice" id="scenario-edit-processor" editable="true" maxWidth="Infinity"
                  promptText="%ScenarioEditDialog.processorChoice.promptText" visible="false" managed="false"
                  GridPane.rowIndex="4" GridPane.columnIndex="2">
            <tooltip>
                <Tooltip text="%ScenarioEditDialog.processorChoice.tooltip"/>
            </tooltip>
        </ComboBox>
        <Label text="%ScenarioEditDialog.output-file.text" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="outputField" id="scenario-edit-output" promptText="%ScenarioEditDialog.outputField.promptText"
                   GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        <Label text="%ScenarioEditDialog.expected.text" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="expectedField" id="scenario-edit-expected" promptText="%ScenarioEditDialog.expectedField.promptText"
                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <Button id="scenario-edit-browse-expected" text="%ScenarioEditDialog.scenario-edit-browse-expected.text" onAction="#onBrowseExpected"
                GridPane.rowIndex="6" GridPane.columnIndex="2">
            <graphic>
                <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
            </graphic>
        </Button>
        <Label text="%ScenarioEditDialog.ignore.text" GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
        <TextArea fx:id="ignoreArea" id="scenario-edit-ignore" prefRowCount="2" promptText="%ScenarioEditDialog.ignoreArea.promptText"
                  GridPane.rowIndex="7" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        <Label text="%ScenarioEditDialog.compare.text" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="8" GridPane.columnIndex="1" GridPane.columnSpan="2">
            <children>
                <Label text="%ScenarioEditDialog.tolerance.text" minWidth="-Infinity"/>
                <TextField fx:id="toleranceField" id="scenario-edit-tolerance" prefColumnCount="5" minWidth="-Infinity" promptText="0"/>
                <CheckBox fx:id="ignoreOrderBox" id="scenario-edit-ignore-order" text="%ScenarioEditDialog.ignoreOrderBox.text" minWidth="-Infinity"/>
                <Label text="%ScenarioEditDialog.keys.text" minWidth="-Infinity"/>
                <TextField fx:id="keysField" id="scenario-edit-keys" prefColumnCount="8" minWidth="90" promptText="%ScenarioEditDialog.keysField.promptText" HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
        <Label fx:id="error" id="scenario-edit-error" wrapText="true" visible="false" managed="false"
               styleClass="fxt-dialog-error" GridPane.rowIndex="9" GridPane.columnIndex="0" GridPane.columnSpan="3"/>
        <Label text="%ScenarioEditDialog.paths-are-relative-to-the.text"
               wrapText="true" opacity="0.7" maxWidth="560" GridPane.rowIndex="10" GridPane.columnIndex="0"
               GridPane.columnSpan="3"/>
    </children>
</GridPane>
