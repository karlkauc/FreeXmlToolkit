<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<!--
  Content of the "Insert Template" dialog: the template list with a read-only preview. Loaded by
  TemplateInsertDialog (FxmlViews.loadContent), which is the controller and adds title and
  buttons.
-->
<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="Templates"/>
        <ListView fx:id="list" prefHeight="260" VBox.vgrow="ALWAYS"/>
        <Label text="Preview"/>
        <TextArea fx:id="preview" editable="false" prefRowCount="8" wrapText="false"/>
    </children>
</VBox>
