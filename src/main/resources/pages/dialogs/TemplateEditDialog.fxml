<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<!--
  Content of the "New Template" / "Edit Template" dialog. Loaded by TemplateEditDialog
  (FxmlViews.loadContent), which is the controller, fills the file types and adds title and
  buttons.
-->
<GridPane hgap="10" vgap="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <children>
        <Label text="Name:" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
        <Label text="Category:" GridPane.rowIndex="1"/>
        <TextField fx:id="categoryField" promptText="Custom" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Description:" GridPane.rowIndex="2"/>
        <TextField fx:id="descriptionField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="File type:" GridPane.rowIndex="3"/>
        <ComboBox fx:id="typeBox" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Content:" GridPane.rowIndex="4"/>
        <TextArea fx:id="contentArea" prefRowCount="14" style="-fx-font-family: 'monospace';"
                  GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"
                  GridPane.vgrow="ALWAYS"/>
    </children>
</GridPane>
