<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<!--
  Content of the "Spreadsheet Converter" dialog: direction, format, CSV delimiter and the
  conversion options (defaults mirror the service: everything on). Loaded by
  SpreadsheetConverterDialog (FxmlViews.loadContent), which is the controller, fills the two
  choice boxes from its enums and adds title and buttons. The schema row is enabled for an
  import only (an export uses the XSD bound to the document).
-->
<GridPane hgap="10" vgap="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <ToggleGroup fx:id="directionGroup"/>
    </fx:define>
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <children>
        <Label text="%SpreadsheetConverterDialog.direction.text" GridPane.rowIndex="0"/>
        <RadioButton fx:id="toSpreadsheet" text="%SpreadsheetConverterDialog.toSpreadsheet.text" toggleGroup="$directionGroup" selected="true"
                     GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <RadioButton fx:id="toXml" text="%SpreadsheetConverterDialog.toXml.text" toggleGroup="$directionGroup"
                     GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="%SpreadsheetConverterDialog.format.text" GridPane.rowIndex="2"/>
        <ComboBox fx:id="format" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="%SpreadsheetConverterDialog.csv-delimiter.text" GridPane.rowIndex="3"/>
        <ComboBox fx:id="delimiter" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="%SpreadsheetConverterDialog.schema-xsd.text" GridPane.rowIndex="4"/>
        <HBox spacing="6" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <children>
                <TextField fx:id="schemaFile" id="spreadsheet-import-schema" prefColumnCount="28"
                           promptText="%SpreadsheetConverterDialog.schemaFile.promptText"/>
                <Button fx:id="browseSchema" id="spreadsheet-import-schema-browse" text="%SpreadsheetConverterDialog.browseSchema.text"
                        onAction="#onBrowseSchema"/>
            </children>
        </HBox>
        <Label text="%SpreadsheetConverterDialog.options.text" GridPane.rowIndex="5"/>
        <CheckBox fx:id="includeComments" text="%SpreadsheetConverterDialog.includeComments.text" selected="true"
                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <CheckBox fx:id="includeNamespaces" text="%SpreadsheetConverterDialog.includeNamespaces.text" selected="true"
                  GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <CheckBox fx:id="includeCData" text="%SpreadsheetConverterDialog.includeCData.text" selected="true"
                  GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        <CheckBox fx:id="includeTypeColumn" text="%SpreadsheetConverterDialog.includeTypeColumn.text" selected="true"
                  GridPane.rowIndex="8" GridPane.columnIndex="1"/>
        <CheckBox fx:id="prettyPrintXml" text="%SpreadsheetConverterDialog.prettyPrintXml.text" selected="true"
                  GridPane.rowIndex="9" GridPane.columnIndex="1"/>
    </children>
</GridPane>
