<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the "Update Available" dialog: green header, current → new version, the release
  notes and an info tip. Loaded by UpdateNotificationDialog (FxmlViews.loadContent), which is the
  controller, fills in the versions, the publish date (removed when unknown) and the notes, and
  adds the four buttons.
-->
<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Header -->
        <VBox spacing="5" styleClass="dialog-header"
              style="-fx-background-color: linear-gradient(to right, #28a745, #20c997); -fx-padding: 20px;">
            <children>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <children>
                        <IconifyIcon iconLiteral="bi-arrow-up-circle-fill" iconSize="48" iconColor="WHITE"/>
                        <VBox spacing="5">
                            <children>
                                <Label text="Update Available"
                                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="A new version of FreeXmlToolkit is available"
                                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Version info -->
        <HBox alignment="CENTER">
            <padding>
                <Insets right="20" left="20"/>
            </padding>
            <children>
                <HBox spacing="30" alignment="CENTER" styleClass="theme-bg-secondary"
                      style="-fx-background-radius: 6px;">
                    <padding>
                        <Insets topRightBottomLeft="15"/>
                    </padding>
                    <children>
                        <VBox spacing="5" alignment="CENTER">
                            <children>
                                <Label text="Current Version" styleClass="desc-label"/>
                                <Label fx:id="currentVersion"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6c757d;"/>
                            </children>
                        </VBox>
                        <IconifyIcon iconLiteral="bi-arrow-right" iconSize="24" iconColor="#28a745"/>
                        <VBox spacing="5" alignment="CENTER">
                            <children>
                                <Label text="New Version" styleClass="desc-label"/>
                                <Label fx:id="latestVersion"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #28a745;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Release notes -->
        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <padding>
                <Insets right="20" left="20"/>
            </padding>
            <children>
                <HBox fx:id="notesHeader" spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <IconifyIcon iconLiteral="bi-journal-text" iconSize="18" iconColor="#007bff"/>
                        <Label text="What's New" styleClass="theme-text-primary"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="publishedDate" styleClass="theme-text-secondary"
                               style="-fx-font-size: 12px;"/>
                    </children>
                </HBox>
                <TextArea fx:id="releaseNotes" editable="false" wrapText="true" styleClass="theme-bg-secondary"
                          style="-fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 12px; -fx-border-color: -border-light; -fx-border-radius: 4px; -fx-background-radius: 4px;"
                          VBox.vgrow="ALWAYS"/>
            </children>
        </VBox>

        <!-- Info box -->
        <HBox>
            <padding>
                <Insets right="20" bottom="10" left="20"/>
            </padding>
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="info-tip-box"
                      style="-fx-background-radius: 4px; -fx-border-radius: 4px;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="10" right="15" bottom="10" left="15"/>
                    </padding>
                    <children>
                        <IconifyIcon iconLiteral="bi-info-circle-fill" iconSize="16" iconColor="#0d6efd"/>
                        <Label text="Click 'Download &amp; Install' to automatically update. The application will restart after installation."
                               wrapText="true" styleClass="info-tip-text" style="-fx-font-size: 12px;"/>
                    </children>
                </HBox>
            </children>
        </HBox>
    </children>
</VBox>
