<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the "Update Available" dialog: green header, current → new version, the release
  notes and an info tip. Loaded by UpdateNotificationDialog (FxmlViews.loadContent), which is the
  controller, fills in the versions, the publish date (removed when unknown) and the notes, and
  adds the buttons. For package-manager installs it shows the upgrade command (managedBox)
  instead of offering "Download & Install".
-->
<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Header -->
        <VBox spacing="5" styleClass="dialog-header, dialog-header-success">
            <children>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <children>
                        <IconifyIcon iconLiteral="bi-arrow-up-circle-fill" iconSize="28"/>
                        <VBox spacing="5">
                            <children>
                                <Label text="%UpdateNotificationDialog.update-available.text" styleClass="dialog-header-title"/>
                                <Label text="%UpdateNotificationDialog.a-new-version-of-freexmltoolkit.text"
                                       styleClass="dialog-header-subtitle"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Version info -->
        <HBox alignment="CENTER">
            <padding>
                <Insets right="20" left="20"/>
            </padding>
            <children>
                <HBox spacing="30" alignment="CENTER" styleClass="dialog-section">
                    <padding>
                        <Insets topRightBottomLeft="15"/>
                    </padding>
                    <children>
                        <VBox spacing="5" alignment="CENTER">
                            <children>
                                <Label text="%UpdateNotificationDialog.current-version.text" styleClass="desc-label"/>
                                <Label fx:id="currentVersion" styleClass="fxt-update-version-old"/>
                            </children>
                        </VBox>
                        <IconifyIcon iconLiteral="bi-arrow-right" iconSize="24" styleClass="fxt-update-arrow"/>
                        <VBox spacing="5" alignment="CENTER">
                            <children>
                                <Label text="%UpdateNotificationDialog.new-version.text" styleClass="desc-label"/>
                                <Label fx:id="latestVersion" styleClass="fxt-update-version-new"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Release notes -->
        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <padding>
                <Insets right="20" left="20"/>
            </padding>
            <children>
                <HBox fx:id="notesHeader" spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <IconifyIcon iconLiteral="bi-journal-text" iconSize="18" styleClass="fxt-update-notes-icon"/>
                        <Label text="%UpdateNotificationDialog.what-s-new.text" styleClass="dialog-section-title"/>
                        <Label fx:id="publishedDate" styleClass="dialog-section-subtitle"/>
                    </children>
                </HBox>
                <TextArea fx:id="releaseNotes" editable="false" wrapText="true" styleClass="fxt-update-notes"
                          VBox.vgrow="ALWAYS"/>
            </children>
        </VBox>

        <!-- Upgrade command for package-manager installs (hidden otherwise) -->
        <HBox fx:id="managedBox" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
            <padding>
                <Insets right="20" left="20"/>
            </padding>
            <children>
                <TextField fx:id="upgradeCommand" id="update-upgrade-command" editable="false" HBox.hgrow="ALWAYS"
                           styleClass="fxt-update-notes"/>
                <Button id="update-copy-command" text="%UpdateNotificationDialog.update-copy-command.text" onAction="#copyUpgradeCommand">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-clipboard" iconSize="14"/>
                    </graphic>
                </Button>
            </children>
        </HBox>

        <!-- Info box -->
        <HBox>
            <padding>
                <Insets right="20" bottom="10" left="20"/>
            </padding>
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="dialog-info-box, dialog-info-box-info" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="10" right="15" bottom="10" left="15"/>
                    </padding>
                    <children>
                        <IconifyIcon iconLiteral="bi-info-circle-fill" iconSize="16"/>
                        <Label fx:id="infoText"
                               text="%UpdateNotificationDialog.infoText.text"
                               wrapText="true" styleClass="dialog-info-box-text"/>
                    </children>
                </HBox>
            </children>
        </HBox>
    </children>
</VBox>
