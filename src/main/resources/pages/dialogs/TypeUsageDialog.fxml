<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the "Find Usages" dialog: a header line, then either the usages table with its help
  line or the "not used anywhere" message. Loaded by TypeUsageDialog (FxmlViews.loadContent),
  which is the controller: it sets the header text, supplies the rows and cell value factories
  and removes the part that does not apply.
-->
<VBox fx:id="content" spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="15"/>
    </padding>
    <children>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <IconifyIcon iconLiteral="bi-search" iconSize="20" iconColor="DODGERBLUE"/>
                <Label fx:id="headerLabel" styleClass="fxt-text-lg"/>
            </children>
        </HBox>

        <!-- Shown when the type has no usages -->
        <VBox fx:id="noUsagesBox" spacing="10" alignment="CENTER">
            <padding>
                <Insets topRightBottomLeft="40"/>
            </padding>
            <children>
                <IconifyIcon fx:id="checkIcon" iconLiteral="bi-check-circle" iconSize="48"/>
                <Label styleClass="fxt-text-base" text="%TypeUsageDialog.this-type-is-not-used.text"
                       wrapText="true" style="-fx-text-alignment: center;"/>
            </children>
        </VBox>

        <!-- Shown when usages were found -->
        <TableView fx:id="tableView" onMouseClicked="#onTableClicked" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nodeNameCol" text="%TypeUsageDialog.nodeNameCol.text" prefWidth="150"/>
                <TableColumn fx:id="nodeTypeCol" text="%TypeUsageDialog.nodeTypeCol.text" prefWidth="100"/>
                <TableColumn fx:id="refTypeCol" text="%TypeUsageDialog.refTypeCol.text" prefWidth="120"/>
                <TableColumn fx:id="pathCol" text="%TypeUsageDialog.pathCol.text" prefWidth="200"/>
                <TableColumn fx:id="fileCol" text="%TypeUsageDialog.fileCol.text" prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="%TypeUsageDialog.no-usages-found.text"/>
            </placeholder>
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuItem text="%TypeUsageDialog.navigate-to-node.text" onAction="#onNavigate">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-arrow-right-circle"/>
                            </graphic>
                        </MenuItem>
                        <SeparatorMenuItem/>
                        <MenuItem text="%TypeUsageDialog.copy-path.text" onAction="#onCopyPath">
                            <graphic>
                                <IconifyIcon iconLiteral="bi-clipboard"/>
                            </graphic>
                        </MenuItem>
                    </items>
                </ContextMenu>
            </contextMenu>
        </TableView>
        <Label fx:id="helpLabel" text="%TypeUsageDialog.helpLabel.text"
               styleClass="desc-label"/>
    </children>
</VBox>
