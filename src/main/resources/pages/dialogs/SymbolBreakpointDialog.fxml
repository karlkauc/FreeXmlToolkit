<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<!--
  Content of the XSLT debugger's "Template / Function Breakpoint" dialog: what to break on
  (template rule, named template, function, mode) and its name, suggested from the stylesheet.
  Loaded by SymbolBreakpointDialog (FxmlViews.loadContent), which is the controller.
-->
<GridPane hgap="10" vgap="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <columnConstraints>
        <ColumnConstraints minWidth="90"/>
        <ColumnConstraints hgrow="ALWAYS" minWidth="340"/>
    </columnConstraints>
    <children>
        <Label text="Break on" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ChoiceBox fx:id="kindChoice" id="symbol-kind" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Name" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="nameCombo" id="symbol-name" editable="true" maxWidth="Infinity"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label wrapText="true" opacity="0.7" maxWidth="440" GridPane.rowIndex="2" GridPane.columnIndex="0"
               GridPane.columnSpan="2"
               text="The run pauses whenever that template, function or a template in that mode is entered — wherever it is defined, also in included modules. Match patterns compare without spaces; names may be given with or without their prefix."/>
    </children>
</GridPane>
