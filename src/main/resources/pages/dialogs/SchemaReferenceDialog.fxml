<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the dialog that adds an xs:import / xs:include / xs:redefine / xs:override from the
  Schema Overview: namespace (imports only) and schema location with a file chooser. Loaded by
  SchemaReferenceDialog (FxmlViews.loadContent), which adds title, buttons and validation.
-->
<GridPane hgap="10" vgap="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <children>
        <Label fx:id="namespaceLabel" text="Namespace" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="namespaceField" id="schema-reference-namespace" prefColumnCount="34"
                   promptText="(no namespace)" GridPane.rowIndex="0" GridPane.columnIndex="1"
                   GridPane.columnSpan="2"/>
        <Label text="Schema location" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="locationField" id="schema-reference-location" prefColumnCount="28"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button text="Browse…" id="schema-reference-browse" onAction="#onBrowse"
                GridPane.rowIndex="1" GridPane.columnIndex="2">
            <graphic>
                <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
            </graphic>
        </Button>
        <Label fx:id="errorLabel" id="schema-reference-error" wrapText="true" maxWidth="480" visible="false"
               managed="false" style="-fx-text-fill: #e03131;" GridPane.rowIndex="2" GridPane.columnIndex="0"
               GridPane.columnSpan="3"/>
    </children>
</GridPane>
