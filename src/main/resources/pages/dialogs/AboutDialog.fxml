<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the "About FreeXmlToolkit" dialog: logo + title header, the version/runtime info
  grid, legal lines and the link buttons. Loaded by AboutDialog (FxmlViews.loadContent); an
  AboutDialog instance is the controller. Filled in code: the logo image, the version pill, the
  info rows (the Build row is optional), the copyright line and the sponsor heart.
  "Report a problem…" is removed when error reporting is switched off.
-->
<VBox spacing="14" style="-fx-padding: 18 20 8 20;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <fx:define>
        <String fx:id="linkStyle"
                fx:value="-fx-background-color: transparent;-fx-border-color: #d1d5db;-fx-border-radius: 6;-fx-background-radius: 6;-fx-text-fill: #1f2937;-fx-padding: 5 12 5 12;-fx-cursor: hand;"/>
    </fx:define>
    <children>
        <HBox fx:id="header" spacing="16" alignment="CENTER_LEFT">
            <children>
                <ImageView fx:id="logo" fitHeight="72" preserveRatio="true" smooth="true"/>
                <VBox spacing="4" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="FreeXmlToolkit"
                               style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #1f2937;"/>
                        <Label text="Universal Toolkit for XML, XSD, XSLT, Schematron &amp; FOP" wrapText="true"
                               style="-fx-font-size: 12.5px; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="versionPill"
                               style="-fx-background-color: #e7f3ff;-fx-text-fill: #0b5ed7;-fx-font-weight: 600;-fx-font-size: 12px;-fx-padding: 3 10 3 10;-fx-background-radius: 12;"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Separator/>

        <GridPane fx:id="info" hgap="14" vgap="6"
                  style="-fx-background-color: #f9fafb;-fx-background-radius: 8;-fx-border-color: #e5e7eb;-fx-border-radius: 8;-fx-padding: 12;">
            <columnConstraints>
                <ColumnConstraints minWidth="120" halignment="LEFT"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
        </GridPane>

        <VBox spacing="2">
            <children>
                <Label fx:id="copyright" style="-fx-font-size: 11.5px; -fx-text-fill: #6b7280;"/>
                <Hyperlink text="Licensed under the Apache License, Version 2.0"
                           style="-fx-padding: 0; -fx-text-fill: #0b5ed7;" onAction="#onLicense"/>
            </children>
        </VBox>

        <HBox fx:id="links" spacing="8" alignment="CENTER_LEFT">
            <children>
                <Button text="GitHub" style="$linkStyle" onAction="#onGitHub">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-github"/>
                    </graphic>
                </Button>
                <!-- The sponsor heart keeps its own colour; AboutDialog sets the graphic. -->
                <Button fx:id="sponsorButton" id="about-sponsor" text="Sponsor" style="$linkStyle"
                        onAction="#onSponsor"/>
                <Button text="Documentation" style="$linkStyle" onAction="#onDocs">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-book"/>
                    </graphic>
                </Button>
                <Button text="Report an issue" style="$linkStyle" onAction="#onIssues">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-bug"/>
                    </graphic>
                </Button>
                <!-- Anonymous, in-app problem report (no GitHub account needed) -->
                <Button fx:id="reportButton" text="Report a problem…" style="$linkStyle"
                        onAction="#onReportProblem">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-send"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
