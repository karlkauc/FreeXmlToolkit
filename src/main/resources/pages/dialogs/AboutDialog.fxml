<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the "About FreeXmlToolkit" dialog: logo + title header, the version/runtime info
  grid, legal lines and the link buttons. Loaded by AboutDialog (FxmlViews.loadContent); an
  AboutDialog instance is the controller. Filled in code: the logo image, the version pill, the
  info rows (the Build row is optional), the copyright line and the sponsor heart.
  "Report a problem…" is removed when error reporting is switched off.
-->
<VBox spacing="14" styleClass="fxt-about"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox fx:id="header" spacing="16" alignment="CENTER_LEFT">
            <children>
                <ImageView fx:id="logo" fitHeight="72" preserveRatio="true" smooth="true"/>
                <VBox spacing="4" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="%AboutDialog.freexmltoolkit.text"
                               styleClass="fxt-about-title"/>
                        <Label text="%AboutDialog.universal-toolkit-for-xml-xsd.text" wrapText="true"
                               styleClass="fxt-about-subtitle"/>
                        <Label fx:id="versionPill"
                               styleClass="fxt-about-version"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Separator/>

        <GridPane fx:id="info" hgap="14" vgap="6"
                  styleClass="fxt-about-info">
            <columnConstraints>
                <ColumnConstraints minWidth="120" halignment="LEFT"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
        </GridPane>

        <VBox spacing="2">
            <children>
                <Label fx:id="copyright" styleClass="fxt-about-subtitle"/>
                <Hyperlink text="%AboutDialog.licensed-under-the-apache-license.text"
                           styleClass="fxt-about-license" onAction="#onLicense"/>
            </children>
        </VBox>

        <HBox fx:id="links" spacing="8" alignment="CENTER_LEFT">
            <children>
                <Button text="%AboutDialog.github.text" styleClass="fxt-about-link" onAction="#onGitHub">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-github"/>
                    </graphic>
                </Button>
                <!-- The sponsor heart keeps its own colour; AboutDialog sets the graphic. -->
                <Button fx:id="sponsorButton" id="about-sponsor" text="%AboutDialog.sponsorButton.text" styleClass="fxt-about-link"
                        onAction="#onSponsor"/>
                <Button text="%AboutDialog.documentation.text" styleClass="fxt-about-link" onAction="#onDocs">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-book"/>
                    </graphic>
                </Button>
                <Button text="%AboutDialog.report-an-issue.text" styleClass="fxt-about-link" onAction="#onIssues">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-bug"/>
                    </graphic>
                </Button>
                <!-- Anonymous, in-app problem report (no GitHub account needed) -->
                <Button fx:id="reportButton" text="%AboutDialog.reportButton.text" styleClass="fxt-about-link"
                        onAction="#onReportProblem">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-send"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
