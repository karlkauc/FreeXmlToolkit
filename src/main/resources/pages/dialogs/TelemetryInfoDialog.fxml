<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the "What is sent?" dialog: the privacy explanation, a sample of the exact payload,
  the anonymous installation id with "Reset ID" and the documentation link. Loaded by
  TelemetryInfoDialog (FxmlViews.loadContent); a TelemetryInfoDialog instance is the controller
  and fills in the payload and the id.
-->
<VBox spacing="10" prefWidth="640" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="12" right="16" bottom="4" left="16"/>
    </padding>
    <children>
        <Label wrapText="true"
               text="%TelemetryInfoDialog.freexmltoolkit-sends-anonymous-usage-statistics.text"/>
        <Label text="%TelemetryInfoDialog.example-of-the-data-sent.text"/>
        <TextArea styleClass="fxt-mono-text" fx:id="payload" editable="false" wrapText="false" prefRowCount="14"
                  VBox.vgrow="ALWAYS"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <children>
                <Label text="%TelemetryInfoDialog.anonymous-installation-id.text"/>
                <TextField fx:id="installId" id="telemetry-install-id" editable="false" HBox.hgrow="ALWAYS"/>
                <Button text="%TelemetryInfoDialog.reset-id.text" onAction="#onResetId">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-arrow-counterclockwise" iconSize="16"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
        <Hyperlink text="%TelemetryInfoDialog.read-the-full-privacy-documentation.text" onAction="#onOpenDocs"/>
    </children>
</VBox>
