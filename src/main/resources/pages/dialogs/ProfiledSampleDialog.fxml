<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Content of the "Generate Sample XML (Advanced)" dialog: saved-profile bar, the editable table of
  per-XPath generation rules, a hint and the batch / repetition options. Loaded by
  ProfiledSampleDialog (FxmlViews.loadContent), which is the controller, supplies the rows and
  the cell factories and adds title and buttons.
-->
<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <children>
        <!-- Saved-profile selector with Load / Save As… -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label text="Profile:"/>
                <ComboBox fx:id="profileCombo" promptText="(saved profiles)"/>
                <Button text="Load" onAction="#onLoadProfile"/>
                <Button text="Save As…" onAction="#onSaveProfile"/>
            </children>
        </HBox>

        <Label text="Per-XPath generation rules:"/>
        <TableView fx:id="table" editable="true" prefHeight="320" prefWidth="640" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="xpathCol" text="XPath" editable="false"/>
                <TableColumn fx:id="typeCol" text="Type" editable="false" maxWidth="140"/>
                <TableColumn fx:id="stratCol" text="Strategy" maxWidth="170"/>
                <TableColumn fx:id="configCol" text="Value / Pattern"/>
            </columns>
        </TableView>

        <Label text="Set a strategy per XPath. Config: FIXED=value · SEQUENCE/TEMPLATE=pattern (e.g. ORD-{seq:4}) · RANDOM_FROM_LIST=comma list · XPATH_REF=source xpath."
               wrapText="true" styleClass="fxt-inspector-hint"/>

        <GridPane hgap="10" vgap="8">
            <children>
                <CheckBox fx:id="mandatoryOnly" text="Only mandatory elements" GridPane.rowIndex="0"
                          GridPane.columnSpan="2"/>
                <Label text="Max. repetitions:" GridPane.rowIndex="1"/>
                <Spinner fx:id="maxOccurrences" editable="true" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <valueFactory>
                        <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="50" initialValue="2"/>
                    </valueFactory>
                </Spinner>
                <Label text="Batch count:" GridPane.rowIndex="2"/>
                <Spinner fx:id="batchCount" editable="true" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <valueFactory>
                        <javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="1000" initialValue="1"/>
                    </valueFactory>
                </Spinner>
                <Label text="File name pattern:" GridPane.rowIndex="3"/>
                <TextField fx:id="fileNamePattern" text="sample_{seq:3}.xml" GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>
            </children>
        </GridPane>
    </children>
</VBox>
