<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import org.fxt.freexmltoolkit.controls.icons.IconifyIcon?>

<!--
  Content of the "Flatten Schema" dialog: the output file and the reduction options. Loaded by FlattenOptionsDialog
  (FxmlViews.loadContent), which is the controller and adds title, header and buttons.
-->
<GridPane hgap="10" vgap="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="16"/>
    </padding>
    <children>
        <Label text="%FlattenOptionsDialog.output-file.text" GridPane.rowIndex="0"/>
        <HBox spacing="6" GridPane.rowIndex="1">
            <children>
                <TextField fx:id="outputField" id="flatten-output" prefColumnCount="40" HBox.hgrow="ALWAYS"
                           promptText="%FlattenOptionsDialog.outputField.promptText"/>
                <Button text="%FlattenOptionsDialog.flatten-output-browse.text" id="flatten-output-browse" onAction="#onBrowse">
                    <graphic>
                        <IconifyIcon iconLiteral="bi-folder2-open" iconSize="16"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
        <Label fx:id="outputError" id="flatten-output-error" wrapText="true" maxWidth="520" visible="false"
               managed="false" styleClass="fxt-dialog-error" GridPane.rowIndex="2"/>
        <CheckBox fx:id="removeAnnotations" text="%FlattenOptionsDialog.removeAnnotations.text" selected="true"
                  GridPane.rowIndex="3"/>
        <CheckBox fx:id="removeComments" text="%FlattenOptionsDialog.removeComments.text" selected="true" GridPane.rowIndex="4"/>
        <CheckBox fx:id="removeUnusedTypes" text="%FlattenOptionsDialog.removeUnusedTypes.text" selected="true"
                  GridPane.rowIndex="5"/>
        <CheckBox fx:id="minify" text="%FlattenOptionsDialog.minify.text" selected="true" GridPane.rowIndex="6"/>
        <CheckBox fx:id="trackSourceFiles" text="%FlattenOptionsDialog.trackSourceFiles.text" GridPane.rowIndex="7">
            <tooltip>
                <Tooltip text="%FlattenOptionsDialog.marks-every-component-that-came.text"/>
            </tooltip>
        </CheckBox>
        <Label text="%FlattenOptionsDialog.uncheck-all-options-for-a.text" opacity="0.7"
               GridPane.rowIndex="8"/>
    </children>
</GridPane>
