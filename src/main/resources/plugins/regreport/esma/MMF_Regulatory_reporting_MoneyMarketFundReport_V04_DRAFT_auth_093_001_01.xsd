<xs:schema xmlns="urn:iso:std:iso:20022:tech:xsd:DRAFT6auth.093.001.01" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:iso:std:iso:20022:tech:xsd:DRAFT6auth.093.001.01" elementFormDefault="qualified">
	<xs:element name="Document" type="Document"/>
	<xs:complexType name="ActionPlan1Choice__1">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ActionPlan1Choice__1</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Choice between no action plan (because no vulnerability was revealed) or the description of the action plan proposed by the manager of the fund.&#13;
</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="NoVlnrblty" type="NoVulnerability1Code_fixed">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">NoVulnerability</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indicates that no vulnerability was revealed by the stress tests.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PropsdActnPlan" type="Max2000Text">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ProposedActionPlan</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the action plan as proposed by the board of directors.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:simpleType name="ActiveCurrencyAndAmount__1_SimpleType">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="5"/>
			<xs:totalDigits value="18"/>
			<xs:minInclusive value="0"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="ActiveCurrencyAndAmount__1">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ActiveCurrencyAndAmount__1</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">A number of monetary units specified in an active currency where the unit of currency is explicit and compliant with ISO 4217.</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="ActiveCurrencyAndAmount__1_SimpleType">
				<xs:attribute name="Ccy" type="ActiveCurrencyCode_fixed" use="required">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">Currency</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Medium of exchange of value.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:simpleType name="ActiveCurrencyCode_fixed">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ActiveCurrencyCode_fixed</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EUR">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">EUR</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ActiveOrHistoricCurrencyCode">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ActiveOrHistoricCurrencyCode</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">A code allocated to a currency by a Maintenance Agency under an international identification scheme, as described in the latest edition of the international standard ISO 4217 "Codes for the representation of currencies and funds".</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Z]{3,3}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ActiveOrHistoricCurrencyCode_fixed">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ActiveOrHistoricCurrencyCode_fixed</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EUR">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">EUR</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="AmortisedCostMethodPriceDeviationEvent3__1">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">AmortisedCostMethodPriceDeviationEvent3__1</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Details of the events where the price of an asset valued by using the amortised cost method deviates from the price of that asset by more than 10 basis points.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ValtnDt" type="ISODate">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ValuationDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Valuation date from which the price of an asset calculated in accordance with the mark-to-market or mark-to-model method deviates from the asset price calculated in accordance with the amortised cost method by more than 10 basis points.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AsstId" type="SecurityIdentification34">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AssetIdentification</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identification of the instrument&#13;
</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RptgCcyMktPric" type="AmountAndDirection53__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ReportingCurrencyMarketPrice</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the market price expressed in the reporting currency of the asset valued by using the mark-to-market or mark-to-model method.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RptgCcyAmtsdCostPric" type="AmountAndDirection53__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ReportingCurrencyAmortisedCostPrice</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the price expressed in the reporting currency of the asset valued by using the amortised cost method.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NbOfDaysDvtn" type="Max3PositiveNumber">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">NumberOfDaysDeviation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the number of days the price of an asset calculated in accordance with the mark-to-market or mark-to-model method deviates from the asset price calculated in accordance with the amortised cost method by more than 10 basis points.&#13;
</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AvrgBsisPtSprd" type="DecimalNumber">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AverageBasisPointSpread</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Provides the average number of basis points added to (if positive) or deducted from (if negative) the price of an asset calculated in accordance with the mark-to-market or mark-to-model method to calculate the asset price calculated in accordance with the amortised cost method when the two asset prices deviates by more than 10 basis points.&#13;
Used to express differences in interest rates, for example, a difference of 0.10 % is equivalent to a change of 10 basis points.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LwstPricDvtn" type="Max5Number">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">LowestPriceDeviation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Minimum price deviation between the price of an asset calculated in accordance with the mark-to-market or mark-to-model method and the asset price calculated in accordance with the amortised cost method.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HghstPricDvtn" type="Max5Number">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">HighestPriceDeviation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Maximum price deviation between the price of an asset calculated in accordance with the mark-to-market or mark-to-model method and the asset price calculated in accordance with the amortised cost method.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AmountAndDirection53__1">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">AmountAndDirection53__1</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Amount of money expressed with an optional currency code and debit/credit indicator.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Amt" type="ActiveOrHistoricCurrencyAndAmount__1"/>
			<xs:element name="Sgn" type="PlusOrMinusIndicator" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ActiveOrHistoricCurrencyAndAmount__1">
		<xs:simpleContent>
			<xs:extension base="ActiveOrHistoricCurrencyAndAmount_SimpleType">
				<xs:attribute name="Ccy" type="ActiveOrHistoricCurrencyCode" use="required"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:simpleType name="ActiveOrHistoricCurrencyAndAmount_SimpleType">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="5"/>
			<xs:totalDigits value="18"/>
			<xs:minInclusive value="0"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ArrangementType4Code">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ArrangementType4Code</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Specifies the type of arrangement to which the fund is subject on.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SPRN">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SuspensionOfRedemption</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Suspension of redemptions means that instructions to redeem units cannot be accepted until further notice or under specific arrangements.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GATE">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Gates</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Redemption gate is a temporary suspension of a shareholder’s right to redeem shares of the fund.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RDLF">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">LiquidityFeesOnRedemptions</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Liquidity fee is a fee taken against redemption proceeds and retained by the fund. Such fees are intended be a disincentive for shareholders to redeem shares of a fund in distress, and also to help bolster the liquidity levels in a fund by infusing the fund with the cash withheld from redemption proceeds. </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHR">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">OtherArrangement</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Other arrangement type.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ArrangementType5Code">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ArrangementType5Code</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Specifies the type of measure to which the fund is subject on.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="RDLF">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">LiquidityFeesOnRedemptions</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Liquidity fee is a fee taken against redemption proceeds and retained by the fund. Such fees are intended be a disincentive for shareholders to redeem shares of a fund in distress, and also to help bolster the liquidity levels in a fund by infusing the fund with the cash withheld from redemption proceeds. </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOAC">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">NoImmediateAction</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies that no immediate action is taken as a measure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GATE">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Gates</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Redemption gate is a temporary suspension of a shareholder’s right to redeem shares of the fund.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPDL">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SuspensionOfDealing</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Suspension of dealing means that instructions to buy, sell or switch units cannot be accepted until further notice.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ArrangementType6Code">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ArrangementType6Code</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Specifies the type of measure to which the fund is subject on.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SPDL">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SuspensionOfDealing</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Suspension of dealing means that instructions to buy, sell or switch units cannot be accepted until further notice.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RDLF">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">LiquidityFeesOnRedemptions</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Liquidity fee is a fee taken against redemption proceeds and retained by the fund. Such fees are intended be a disincentive for shareholders to redeem shares of a fund in distress, and also to help bolster the liquidity levels in a fund by infusing the fund with the cash withheld from redemption proceeds. </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AssessmentResultType2Code">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">AssessmentResultType2Code</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Specifies whether the result of the assessment is favorable or unfavorable.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FVRB">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Favourable</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Relates to favourable result.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOAP">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">NotApplicable</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Assesment Result is not applicable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UFVB">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Unfavourable</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Relates to unfavourable result.&#13;
</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOVF">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">NotPerformed</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Assessment has not been performed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="AssetIdentification2__1">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">AssetIdentification2__1</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Identification of the asset held by the fund.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ClssfctnTp" type="CFIOct2015Identifier">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ClassificationType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Classification type of the financial instrument, as per the ISO classification of financial instrument (CFI) codification, that is common share with voting rights, fully paid, or registered.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InstrmId" type="InstrumentIdentification4Choice__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InstrumentIdentification</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identification of the instrument held by the money market fund.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AssetIdentification2__2">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">AssetIdentification2__2</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Identification of the asset held by the fund.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ClssfctnTp" type="CFIOct2015Identifier">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ClassificationType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Classification type of the financial instrument, as per the ISO classification of financial instrument (CFI) codification, that is common share with voting rights, fully paid, or registered.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InstrmId" type="InstrumentIdentification4Choice__2">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InstrumentIdentification</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identification of the instrument held by the money market fund.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AssetIdentification2__3">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">AssetIdentification2__3</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Identification of the asset held by the fund.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ClssfctnTp" type="CFIOct2015Identifier">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ClassificationType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Classification type of the financial instrument, as per the ISO classification of financial instrument (CFI) codification, that is common share with voting rights, fully paid, or registered.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InstrmId" type="InstrumentIdentification4Choice__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InstrumentIdentification</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identification of the instrument held by the money market fund.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AsstLEI" type="LEIIdentifier" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AssetLEI</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Legal entity identification of the fund as an alternate identification for a party.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AssetIdentification2__4">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">AssetIdentification2__4</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Identification of the asset held by the fund.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InstrmId" type="InstrumentIdentification4Choice__3">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InstrumentIdentification</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identification of the instrument held by the money market fund.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AssetValuation4__1">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">AssetValuation4__1</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Provides details about the valuation of the assets held by the fund.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MtrtyDt" type="ISODate">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MaturityDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Planned final repayment date at the time of issuance.&#13;
The maturity date has to be reported for the money market instruments, the securitisations, asset backed commercial papers and financial derivatives.&#13;
</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NtnlCcyFrstLeg" type="ActiveOrHistoricCurrencyCode">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">NotionalCurrencyFirstLeg</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Currency of the financial instrument.&#13;
The currency first leg has to be reported for the money market instruments, the securitisations, asset backed commercial papers, deposits or ancillary services, repurchase agreements, reverse repurchase agreements, financial derivatives and shares or units of other funds.&#13;
Usage: In the case of an interest rate or currency derivative contract, this will be the notional currency of first leg.&#13;
</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Qty" type="FinancialInstrumentQuantity1Choice__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Quantity</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Quantity of the financial instrument held by the fund.&#13;
The quantity has to be reported for the money market instruments, the securitisations, asset backed commercial papers and shares or units of other funds.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Pric" type="CurrencyExchange3Choice__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Price</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Price of the asset expressed as a clean price for the money market instruments, the securitisations or asset backed commercial papers. and as a net asset value per unit or share for other money market funds.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AcrdIntrst" type="CurrencyExchange3Choice__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AccruedInterest</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Interest amount that has accrued in between coupon payment periods.&#13;
</xs:documentation>
