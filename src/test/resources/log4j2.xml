<Configuration status="warn">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%highlight{[%-5level]} [%thread][%class][%line] %d{yyyy-MM-dd HH:mm:ss} - %msg%n"
                           disableAnsi="false"/>
        </Console>
        <!-- Rolling log file: archives are gzipped; archives (and legacy per-launch
             "*-fxt.log" files) older than 7 days, or beyond 200 MB in total, are deleted
             automatically on every rollover. -->
        <RollingFile name="MyFile" fileName="logs/fxt-test.log"
                     filePattern="logs/fxt-test-%d{yyyy-MM-dd}-%i.log.gz"
                     immediateFlush="true" createOnDemand="true">
            <PatternLayout pattern="%d{yyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="20 MB"/>
            </Policies>
            <DefaultRolloverStrategy fileIndex="nomax">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName glob="{fxt-*.log.gz,*-fxt.log}">
                        <IfAny>
                            <IfLastModified age="P7D"/>
                            <IfAccumulatedFileSize exceeds="200 MB"/>
                        </IfAny>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Root level="DEBUG">
            <AppenderRef ref="Console" level="DEBUG"/>
            <appender-ref ref="MyFile" level="DEBUG"/>
        </Root>
        <Logger name="org.apache.poi" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.thymeleaf" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.apache.hc.client5.http" level="ERROR" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.eclipse.lemminx" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.fxt.freexmltoolkit.service.XsdDocumentationImageService" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.fxt.freexmltoolkit.service" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
    </Loggers>
</Configuration>