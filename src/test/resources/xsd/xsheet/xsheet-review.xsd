<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
 xmlns:xs="http://www.w3.org/2001/XMLSchema"
 targetNamespace="http://schemas.animation.org/xsheet/review"
 xmlns="http://schemas.animation.org/xsheet/review"
 elementFormDefault="qualified">

 <xs:element name="ReviewData">
     <xs:complexType>
         <xs:sequence>
             <xs:element name="Reviewer" type="xs:string"/>
             <xs:element name="Status" type="xs:string"/>
             <xs:element name="Comment"
                         type="xs:string"
                         minOccurs="0"/>
         </xs:sequence>
     </xs:complexType>
 </xs:element>

</xs:schema>
