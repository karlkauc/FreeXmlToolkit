<component type="desktop-application">
  <id>io.github.karlkauc.FreeXmlToolkit</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <name>FreeXmlToolkit</name>
  <summary>Edit, validate and transform XML, XSD and JSON</summary>
  <developer id="io.github.karlkauc">
    <name>Karl Kauc</name>
  </developer>

  <description>
    <p>
      FreeXmlToolkit is a free desktop toolkit for working with XML and related formats.
      Open a file and switch between a text editor, a tree view and a graphical view.
    </p>
    <ul>
      <li>XML editor with schema-aware IntelliSense, formatting and an XMLSpy-style grid</li>
      <li>Visual XSD editor with type library, statistics and documentation generation</li>
      <li>Validation against XSD 1.0/1.1 and Schematron, including Schematron Quick Fixes</li>
      <li>XSLT 3.0, XQuery 3.1, XPath 3.1 and XProc 3.0 with Saxon and XML Calabash</li>
      <li>PDF generation with Apache FOP and XML digital signatures</li>
      <li>JSON editing with text, tree and grid views</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.karlkauc.FreeXmlToolkit.desktop</launchable>

