(: Top-10 positions rendered as an ASCII table with fixed column widths —
   inline padding functions replace the missing pad-left/pad-right built-ins. :)
let $root := /FundsXML4,
    $assets := $root/AssetMasterData/Asset,
    $fundCcy := string($root/Funds/Fund[1]/Currency),
    $rpad := function($v as xs:anyAtomicType?, $w as xs:integer) as xs:string {
        substring(string($v) || string-join((1 to $w) ! ' ', ''), 1, $w)
    },
    $lpad := function($v as xs:anyAtomicType?, $w as xs:integer) as xs:string {
        let $s := string-join((1 to $w) ! ' ', '') || string($v)
        return substring($s, string-length($s) - $w + 1)
    },
    $line := string-join((1 to 78) ! '-', ''),
    $positions := $root/Funds/Fund/FundDynamicData/Portfolios/Portfolio/Positions/Position,
    $top10 := subsequence(
        sort($positions, (), function($p) { -number($p/TotalValue/Amount[@ccy = $fundCcy][1]) }),
        1, 10)
return (
    $line,
    $rpad('#', 3) || $rpad('Asset', 34) || $rpad('Type', 5) || $rpad('Ccy', 5)
        || $lpad('Value ' || $fundCcy, 20) || $lpad('Pct', 9),
    $line,
    for $i in 1 to count($top10)
    return
    let $pos := $top10[$i],
        $asset := $assets[UniqueID = $pos/UniqueID][1]
    return $rpad($i, 3)
        || $rpad(substring(($asset/Name, $pos/UniqueID)[1], 1, 32), 34)
        || $rpad($asset/AssetType, 5)
        || $rpad($pos/Currency, 5)
        || $lpad(format-number(number($pos/TotalValue/Amount[@ccy = $fundCcy][1]), '#,##0'), 20)
        || $lpad(format-number(number($pos/TotalPercentage), '0.00') || '%', 9),
    $line
)
