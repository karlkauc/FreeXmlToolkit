			<xs:documentation xml:lang="en">Container for portfolio breakdowns by various dimensions (currency, country, asset type, duration, rating, etc.)</xs:documentation>
			<xs:documentation xml:lang="de">Container für Portfolio-Aufschlüsselungen nach verschiedenen Dimensionen (Währung, Land, Asset Type, Duration, Rating, etc.)</xs:documentation>
			<xs:documentation xml:lang="fr">Conteneur pour breakdowns de portfolio par différentes dimensions (devise, pays, asset type, duration, rating, etc.)</xs:documentation>
			<xs:documentation xml:lang="nl">Container voor portfolio breakdowns per verschillende dimensies (valuta, land, asset type, duration, rating, etc.)</xs:documentation>
			<xs:documentation xml:lang="es">Contenedor para desgloses de cartera por diferentes dimensiones (moneda, país, tipo de activo, duración, rating, etc.)</xs:documentation>
			<xs:documentation xml:lang="it">Contenitore per la suddivisione del portafoglio in base a varie dimensioni (valuta, paese, tipologia di asset, durata, rating, ecc.)</xs:documentation>
			<xs:documentation xml:lang="cs">Kontejner pro portfolio breakdowns by various dimensions (currency, country, asset type, duration, rating, etc.)</xs:documentation>
			<xs:documentation xml:lang="hu">Tarolo a portfolio megoszlasokhoz kulonbozo dimenziok szerint (penznem, orszag, eszkoz tipus, futamido, besorolas, stb.)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BreakDown" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="en">Portfolio breakdown by dimension (asset type, country, currency, etc.)</xs:documentation>
					<xs:documentation xml:lang="de">Portfolio-Aufgliederung nach Dimension (Asset-Typ, Land, Währung usw.)</xs:documentation>
					<xs:documentation xml:lang="fr">Ventilation du portefeuille par dimension (type d'actif, pays, devise, etc.)</xs:documentation>
					<xs:documentation xml:lang="nl">Portefeuilleverdeling per dimensie (activatype, land, valuta, enz.)</xs:documentation>
					<xs:documentation xml:lang="es">Desglose de cartera por dimensión (tipo de activo, país, moneda, etc.)</xs:documentation>
					<xs:documentation xml:lang="it">Ripartizione del portafoglio per dimensione (tipo di asset, paese, valuta, ecc.)</xs:documentation>
					<xs:documentation xml:lang="hu">Portfólió bontás dimenzió szerint (eszköztípus, ország, pénznem stb.)</xs:documentation>
					<xs:documentation xml:lang="cs">Rozklad portfolia podle dimenze (typ aktiva, země, měna atd.)</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Dimensions">
							<xs:annotation>
								<xs:documentation>Combination of dimensions (e.g. Currency+AssetType)</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Dimension" type="xs:string" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>Currency, Country, AssetType, Duration, Rating, ...</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="CalculationMethod" type="xs:string" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Market Value, Exposure, Brutto, Netto, ...</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Values">
							<xs:annotation>
								<xs:documentation xml:lang="en">Collection of breakdown values</xs:documentation>
								<xs:documentation xml:lang="de">Sammlung von Aufgliederungswerten</xs:documentation>
								<xs:documentation xml:lang="fr">Collection de valeurs de ventilation</xs:documentation>
								<xs:documentation xml:lang="nl">Verzameling van verdelingswaarden</xs:documentation>
								<xs:documentation xml:lang="es">Colección de valores de desglose</xs:documentation>
								<xs:documentation xml:lang="it">Raccolta di valori di ripartizione</xs:documentation>
								<xs:documentation xml:lang="hu">Bontási értékek gyűjteménye</xs:documentation>
								<xs:documentation xml:lang="cs">Kolekce hodnot rozkladu</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Value" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation xml:lang="en">Individual breakdown value entry</xs:documentation>
											<xs:documentation xml:lang="de">Einzelner Aufgliederungswert-Eintrag</xs:documentation>
											<xs:documentation xml:lang="fr">Entrée de valeur de ventilation individuelle</xs:documentation>
											<xs:documentation xml:lang="nl">Individuele verdelingswaarde vermelding</xs:documentation>
											<xs:documentation xml:lang="es">Entrada de valor de desglose individual</xs:documentation>
											<xs:documentation xml:lang="it">Voce di valore di ripartizione individuale</xs:documentation>
											<xs:documentation xml:lang="hu">Egyedi bontási érték bejegyzés</xs:documentation>
											<xs:documentation xml:lang="cs">Jednotlivý záznam hodnoty rozkladu</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="DimValues">
													<xs:annotation>
														<xs:documentation>Combination of dimension values</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="DimValue" maxOccurs="unbounded">
																<xs:annotation>
																	<xs:documentation xml:lang="en">Dimension value for the breakdown</xs:documentation>
																	<xs:documentation xml:lang="de">Dimensionswert für die Aufgliederung</xs:documentation>
																	<xs:documentation xml:lang="fr">Valeur de dimension pour la ventilation</xs:documentation>
																	<xs:documentation xml:lang="nl">Dimensiewaarde voor de verdeling</xs:documentation>
																	<xs:documentation xml:lang="es">Valor de dimensión para el desglose</xs:documentation>
																	<xs:documentation xml:lang="it">Valore di dimensione per la ripartizione</xs:documentation>
																	<xs:documentation xml:lang="hu">Dimenzió érték a bontáshoz</xs:documentation>
																	<xs:documentation xml:lang="cs">Hodnota dimenze pro rozklad</xs:documentation>
																</xs:annotation>
																<xs:complexType>
																	<xs:simpleContent>
																		<xs:extension base="xs:string">
																			<xs:attribute name="dim" type="xs:string">
																				<xs:annotation>
																					<xs:documentation xml:lang="en">Dimension identifier</xs:documentation>
																					<xs:documentation xml:lang="de">Dimensionskennung</xs:documentation>
																					<xs:documentation xml:lang="fr">Identifiant de dimension</xs:documentation>
																					<xs:documentation xml:lang="nl">Dimensie-identificatie</xs:documentation>
																					<xs:documentation xml:lang="es">Identificador de dimensión</xs:documentation>
																					<xs:documentation xml:lang="it">Identificatore di dimensione</xs:documentation>
																					<xs:documentation xml:lang="hu">Dimenzió azonosító</xs:documentation>
																					<xs:documentation xml:lang="cs">Identifikátor dimenze</xs:documentation>
																				</xs:annotation>
																			</xs:attribute>
																		</xs:extension>
																	</xs:simpleContent>
																</xs:complexType>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="Percentage" type="PercentageType">
													<xs:annotation>
														<xs:documentation>Percentage in relation to complete portfolio</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="BreakDowns" type="BreakDownsType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Optional breakdowns on next level</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
